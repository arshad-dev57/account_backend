# ── Email (Railway Free/Hobby: SMTP blocked — use Resend HTTPS API) ──
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# If domain not verified yet, use Resend test sender:
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=BisonsTechs
EMAIL_REPLY_TO=info@bisonstechs.com

# ── SMTP (local dev only — Gmail app password) ──
# EMAIL_PROVIDER=smtp
# EMAIL_USER=your-smtp-login@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Web login link in team-invite emails
FRONTEND_URL=https://app.bisonstechs.com
# Optional store links (leave empty until published)
ANDROID_APP_URL=
IOS_APP_URL=

# ── OneSignal (Flutter device push) ──────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_ENV=dev

# ── App Store / Google Play review demo login (reusable OTP, no email sent) ──
# Comma-separated emails of dedicated reviewer accounts you already created.
DEMO_LOGIN_EMAILS=demo@bisonstechs.com,appstore@bisonstechs.com
# Fixed 6-digit OTP the store reviewer will enter after email + password.
DEMO_LOGIN_OTP=123456

# ── Google Play Billing (Android in-app subscriptions) ──
PLAY_PACKAGE_NAME=com.bisonstechs.app
# Paste the Play Console service-account JSON as one line, or use a file path:
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/path/to/play-service-account.json

# ── Apple App Store Billing (iOS In-App Purchase / StoreKit) ──
APPLE_BUNDLE_ID=com.bisonstechs.app
# App Store Connect → Users and Access → Integrations → In-App Purchase key (.p8)
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Local/dev only (never in production): trust client JWS without Server API
# APPLE_IAP_TRUST_CLIENT_JWS=true

# ── Server (Railway / local on-prem) ─────────────────────────
PORT=5000
# Bind all interfaces so LAN clients can reach the API (Windows on-prem).
# Railway/cloud: 0.0.0.0 is fine; omit HOST to use the same default.
HOST=0.0.0.0
NODE_ENV=production

# Required for JWT auth (generate a long random string; never commit the real value)
JWT_SECRET=change-me-to-a-long-random-secret

# ── Database ─────────────────────────────────────────────────
#
# Option A — Local PostgreSQL (on-prem / Windows server)
# One database per client installation. DIRECT_URL is not required locally.
# DATABASE_URL="postgresql://bisons:YOUR_PASSWORD@127.0.0.1:5432/bisonstechs_client1"
#
# Option B — Neon (cloud / Railway production)
# Pooled (has "-pooler" in host) — OK for simple queries
# Do NOT add channel_binding=require — Prisma/Node on macOS often fails with P1001.
DATABASE_URL="postgresql://USER:PASS@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct / non-pooler (NO "-pooler" in host) — REQUIRED for migrations
# and for Vercel interactive transactions (bank, bills, products, JE…)
# Neon dashboard → Connection details → "Direct" / "Unpooled"
DIRECT_URL="postgresql://USER:PASS@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=1"

# Optional: force runtime to always use DIRECT_URL (recommended on Vercel)
# PRISMA_USE_DIRECT=1

# ── File uploads (Cloudinary) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Exchange rates (company-wise currency module) ────────────
# Rates are NEVER invented: they come only from the provider below.
# Unset/empty => the module reports the provider as unconfigured and no
# automatic refresh happens (manually entered rates still work).
# Supported: open-er-api (default) | frankfurter | none
FX_PROVIDER=open-er-api
# Override the provider endpoint only if you run a mirror of the same API.
# Defaults: https://open.er-api.com/v6/latest  |  https://api.frankfurter.app
# FX_PROVIDER_BASE_URL=
# open.er-api.com works without a key. Required only for a paid/custom mirror.
FX_PROVIDER_API_KEY=
# Hard cap for a provider request, in ms (clamped to 1000–30000; default 6000).
FX_PROVIDER_TIMEOUT_MS=6000
# How long fetched rates are reused, in ms (clamped to 0–24h; default 15 min).
FX_RATE_CACHE_TTL_MS=900000
# Rates older than this many days are flagged as stale in the UI (default 7).
FX_RATE_STALE_DAYS=7
