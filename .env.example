# ── SMTP login (Gmail app password / provider credentials) ──
EMAIL_USER=your-smtp-login@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# ── Visible "From" on OTP / transactional emails ──
# Use your noreply address (must be allowed by SMTP provider)
EMAIL_FROM=noreply@bisonstechs.com
EMAIL_FROM_NAME=BisonsTechs
EMAIL_REPLY_TO=support@bisonstechs.com
