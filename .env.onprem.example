# Bisonstechs — Windows on-premise backend configuration (TEMPLATE)
# Copy to .env on the client server. Do NOT commit the real .env file.
#
# Each client installation must have its own:
#   - PostgreSQL database
#   - JWT_SECRET
#   - .env file
#
# Replace placeholders before starting the backend.

# ── Server ───────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ── Local PostgreSQL (one DB per client) ───────────────────────
# Example for Client #1:
DATABASE_URL="postgresql://bisons:REPLACE_PASSWORD@127.0.0.1:5432/bisonstechs_client1"
#
# Example for Client #2 (separate machine or separate database name):
# DATABASE_URL="postgresql://bisons:REPLACE_PASSWORD@127.0.0.1:5432/bisonstechs_client2"
#
# DIRECT_URL is not required for local PostgreSQL.

# ── Web app URL (LAN) ────────────────────────────────────────
# Used in emails and invite links. Use the server's LAN IP + web port.
FRONTEND_URL=http://192.168.1.100:3000

# ── Email (SMTP works on local Windows; Resend also OK if internet available) ──
EMAIL_PROVIDER=smtp
EMAIL_USER=your-smtp-login@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=your-smtp-login@gmail.com
EMAIL_FROM_NAME=BisonsTechs

# ── File uploads (Cloudinary — internet required) ────────────
CLOUDINARY_CLOUD_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE

# ── Optional (leave empty unless needed) ───────────────────────
ANDROID_APP_URL=
IOS_APP_URL=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_ENV=production
