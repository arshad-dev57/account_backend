// ============================================================
// STOCK WRITE-OFF MODELS
// ============================================================

model StockWriteOff {
  id             String    @id @default(uuid())
  writeOffNumber String    @unique @map("write_off_number")
  writeOffDate   DateTime  @default(now()) @map("write_off_date")
  status         String    @default("Draft") @map("status") // Draft | Submitted | Approved | Rejected | Posted
  reason         String    @map("reason") // Expired | Damaged | Broken | Spoiled | Missing | Obsolete | Quality Issue | Other
  notes          String?
  totalCost      Float     @default(0) @map("total_cost")

  companyId        String  @map("company_id")
  locationId       String  @map("location_id")
  fiscalYearId     String? @map("fiscal_year_id")
  expenseAccountId String? @map("expense_account_id")
  journalEntryId   String? @unique @map("journal_entry_id")

  createdBy   String    @map("created_by")
  submittedBy String?   @map("submitted_by")
  approvedBy  String?   @map("approved_by")
  postedBy    String?   @map("posted_by")
  postedAt    DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company        Company            @relation("StockWriteOffCompany", fields: [companyId], references: [id])
  location       Location           @relation(fields: [locationId], references: [id])
  fiscalYear     FiscalYear?        @relation(fields: [fiscalYearId], references: [id])
  expenseAccount ChartOfAccount?    @relation("WriteOffExpenseAccount", fields: [expenseAccountId], references: [id])
  journalEntry   JournalEntry?      @relation("WriteOffJournalEntry", fields: [journalEntryId], references: [id])
  creator        User               @relation("WriteOffCreator", fields: [createdBy], references: [id])
  submitter      User?              @relation("WriteOffSubmitter", fields: [submittedBy], references: [id])
  approver       User?              @relation("WriteOffApprover", fields: [approvedBy], references: [id])
  poster         User?              @relation("WriteOffPoster", fields: [postedBy], references: [id])
  items          StockWriteOffItem[]

  @@index([companyId])
  @@index([locationId])
  @@index([status])
  @@index([writeOffDate])
  @@map("stock_write_offs")
}

model StockWriteOffItem {
  id             String    @id @default(uuid())
  writeOffId     String    @map("write_off_id")
  productId      String    @map("product_id")
  productName    String    @map("product_name")
  sku            String
  batchNumber    String?   @map("batch_number")
  expiryDate     DateTime? @map("expiry_date")
  unitOfMeasure  String?   @map("unit_of_measure")
  availableStock Float     @map("available_stock")
  quantity       Float     @map("quantity")
  unitCost       Float     @map("unit_cost")
  totalCost      Float     @map("total_cost")
  reason         String?

  writeOff StockWriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([writeOffId])
  @@index([productId])
  @@map("stock_write_off_items")
}

// ============================================================
// TRADING MODULE — classification layer over Sales / Purchases
// Does NOT duplicate posting; links to existing documents.
// ============================================================

model TradingDocument {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  documentType  String   @map("document_type") // SALES_ORDER | PURCHASE_ORDER | SALES_INVOICE | PURCHASE_INVOICE | DELIVERY | GRN | SALES_PAYMENT | PURCHASE_PAYMENT | SALES_RETURN | PURCHASE_RETURN | QUOTATION
  documentId    String   @map("document_id")
  documentNumber String? @map("document_number")
  tradeChannel  String   @default("domestic") @map("trade_channel") // domestic | wholesale | b2b | back_to_back
  tradeRef      String?  @map("trade_ref")
  counterpartyName String? @map("counterparty_name")
  status        String?  // mirrored display status from source document
  amountBase    Decimal? @map("amount_base") @db.Decimal(18, 4)
  currencyCode  String?  @map("currency_code")
  documentDate  DateTime? @map("document_date")
  metadata      Json?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company @relation("TradingDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation("TradingDocumentCreator", fields: [createdBy], references: [id])

  @@unique([companyId, documentType, documentId])
  @@index([companyId])
  @@index([companyId, documentType])
  @@index([companyId, tradeChannel])
