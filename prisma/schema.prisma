  name               String
  /// Distributor | Wholesale | Retail | Key Account | Contract | Spot
  tier               String   @default("Wholesale")
  currencyCode       String   @default("PKR") @map("currency_code")
  /// Fixed | MarkupOnCost | DiscountOnList
  pricingMethod      String   @default("Fixed") @map("pricing_method")
