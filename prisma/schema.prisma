  goodsReceiving  GoodsReceiving?      @relation(fields: [goodsReceivingId], references: [id])
  purchaseInvoice PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  creator         User?                @relation("PurchaseReturnCreator", fields: [createdBy], references: [id])
  updater         User?                @relation("PurchaseReturnUpdater", fields: [updatedBy], references: [id])
