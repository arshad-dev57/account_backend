// prisma/schema.prisma - COMPLETE FINAL VERSION

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// MULTI-CURRENCY MASTER
// ============================================================

model Currency {
  id             String   @id @default(uuid())
  code           String   @unique // ISO 4217 e.g. PKR, USD
  name           String
  symbol         String
  decimalPlaces  Int      @default(2) @map("decimal_places")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  companiesBase     Company[]       @relation("CompanyBaseCurrency")
  suppliers         Supplier[]      @relation("SupplierCurrency")
  exchangeRatesFrom ExchangeRate[]  @relation("ExchangeRateFrom")
  exchangeRatesTo   ExchangeRate[]  @relation("ExchangeRateTo")

  purchaseOrdersAsTxn      PurchaseOrder[]         @relation("POCurrency")
  purchaseOrdersAsBase     PurchaseOrder[]         @relation("POBaseCurrency")
  purchaseInvoicesAsTxn    PurchaseInvoice[]       @relation("PICurrency")
  purchaseInvoicesAsBase   PurchaseInvoice[]       @relation("PIBaseCurrency")
  purchasePaymentsAsTxn    PurchasePaymentMake[]   @relation("PPMCurrency")
  purchasePaymentsAsBase   PurchasePaymentMake[]   @relation("PPMBaseCurrency")
  purchaseReturnsAsTxn     PurchaseReturn[]        @relation("PRCurrency")
  purchaseReturnsAsBase    PurchaseReturn[]        @relation("PRBaseCurrency")
  goodsReceivingsAsTxn     GoodsReceiving[]        @relation("GRNCurrency")
  goodsReceivingsAsBase    GoodsReceiving[]        @relation("GRNBaseCurrency")
  accountsPayableAsTxn     AccountsPayable[]       @relation("APCurrency")
  accountsPayableAsBase    AccountsPayable[]       @relation("APBaseCurrency")

  @@index([code])
  @@index([isActive])
  @@map("currencies")
}

model ExchangeRate {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  fromCurrencyId  String   @map("from_currency_id")
  toCurrencyId    String   @map("to_currency_id")
  rate            Decimal  @db.Decimal(18, 8)
  effectiveDate   DateTime @map("effective_date") @db.Date
  isActive        Boolean  @default(true) @map("is_active")
  notes           String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company      Company  @relation("CompanyExchangeRates", fields: [companyId], references: [id], onDelete: Cascade)
  fromCurrency Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])
  creator      User?    @relation("ExchangeRateCreator", fields: [createdBy], references: [id])

  @@unique([companyId, fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([companyId])
  @@index([fromCurrencyId, toCurrencyId])
  @@index([effectiveDate])
  @@index([isActive])
  @@map("exchange_rates")
}

// ============================================================
// COMPANY MODEL (Multi-tenant)
// ============================================================

model Company {
  id                    String    @id @default(uuid())
  name                  String
  email                 String?   @unique
  phone                 String?
  address               String?
  businessType          String?   @map("business_type")
  taxRegistrationNumber String?   @map("tax_registration_number")
  logo                  String?
  website               String?
  isActive              Boolean   @default(true) @map("is_active")
  subscriptionPlan      String    @default("trial") @map("subscription_plan")
  subscriptionStatus    String    @default("active") @map("subscription_status")
  productTier           String    @default("erp_pos") @map("product_tier") // pos | erp_pos
  licensedUsers         Int       @default(1) @map("licensed_users")
  licensedBranches      Int       @default(1) @map("licensed_branches")
  billingCycle          String?   @map("billing_cycle") // monthly | yearly
  trialStartDate        DateTime? @map("trial_start_date")
  trialEndDate          DateTime? @map("trial_end_date")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  posMode               String    @default("retail") @map("pos_mode") // retail | restaurant
  posModeConfigured     Boolean   @default(false) @map("pos_mode_configured")
  baseCurrencyId        String?   @map("base_currency_id")
  // Child companies share the root parent's trial/subscription — never their own.
  parentCompanyId       String?   @map("parent_company_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  parentCompany      Company?              @relation("CompanyParent", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies     Company[]             @relation("CompanyParent")
  baseCurrency       Currency?             @relation("CompanyBaseCurrency", fields: [baseCurrencyId], references: [id])
  exchangeRates      ExchangeRate[]        @relation("CompanyExchangeRates")
  users              User[]
  memberships        CompanyMembership[]
  categories         Category[]             @relation("CategoryCompany")
  suppliers          Supplier[]             @relation("SupplierCompany")
  settings           Setting[]              @relation("SettingCompany")
  stockMovements     StockMovement[]        @relation("StockMovementCompany")
  orders             Order[]                @relation("OrderCompany")
  returns            Return[]               @relation("ReturnCompany")
  refunds            Refund[]               @relation("RefundCompany")
  warehousePurchases WarehousePurchase[]    @relation("WarehousePurchaseCompany")
  warehouseInvoices  WarehouseInvoice[]     @relation("WarehouseInvoiceCompany")
  chartOfAccounts    ChartOfAccount[]       @relation("ChartOfAccountCompany")
  customers          Customer[]             @relation("CustomerCompany")
  products           Product[]              @relation("ProductCompany")
  fiscalYears        FiscalYear[]           @relation("FiscalYearCompany")
  bankAccounts       BankAccount[]          @relation("BankAccountCompany")
  bankStatementImports BankStatementImport[] @relation("BankStatementImportCompany")
  bankStatementTransactions BankStatementTransaction[] @relation("BankStatementTransactionCompany")
  bankReconciliations BankReconciliation[]  @relation("BankReconciliationCompany")
  bankReconciliationMatches BankReconciliationMatch[] @relation("BankReconciliationMatchCompany")
  journalEntries     JournalEntry[]         @relation("JournalEntryCompany")
  bills              Bill[]                 @relation("BillCompany")
  incomes            Income[]               @relation("IncomeCompany")
  expenses           Expense[]              @relation("ExpenseCompany")
  expenseAttachments ExpenseAttachment[]
  budgets            Budget[]
  trialBalanceViews  TrialBalanceView[]     @relation("TrialBalanceViewCompany")
  paymentsMade       PaymentMade[]          @relation("PaymentMadeCompany")
  purchasePayments   PurchasePaymentMake[]  @relation("PurchasePaymentMakeCompany")
  purchaseReturns    PurchaseReturn[]       @relation("PurchaseReturnCompany")
  creditNotes        CreditNote[]           @relation("CreditNoteCompany")
  fixedAssets        FixedAsset[]           @relation("FixedAssetCompany")
  loans              Loan[]                 @relation("LoanCompany")
  equityAccounts     EquityAccount[]        @relation("EquityAccountCompany")
  equityTransactions EquityTransaction[]    @relation("EquityTransactionCompany")
  deliveries         Delivery[]             @relation("DeliveryCompany")
  quotations         Quotation[]            @relation("QuotationCompany")
  purchaseOrders     PurchaseOrder[]        @relation("PurchaseOrderCompany")
  purchaseRequisitions PurchaseRequisition[] @relation("PurchaseRequisitionCompany")
  taxJurisdictions   TaxJurisdiction[]      @relation("TaxJurisdictionCompany")
  taxTypes           TaxType[]              @relation("TaxTypeCompany")
  taxRates           TaxRate[]              @relation("TaxRateCompany")
  taxRules           TaxRule[]              @relation("TaxRuleCompany")
  taxExemptionTypes  TaxExemptionType[]     @relation("TaxExemptionTypeCompany")
  taxExemptions      TaxExemption[]         @relation("TaxExemptionCompany")
  taxTransactions    TaxTransaction[]       @relation("TaxTransactionCompany")
  taxProfile         CompanyTaxProfile?
  goodsReceivings    GoodsReceiving[]       @relation("GoodsReceivingCompany")
  purchaseInvoices   PurchaseInvoice[]      @relation("PurchaseInvoiceCompany")
  salesInvoices      SalesInvoice[]         @relation("SalesInvoiceCompany")
  salesPayments      SalesPaymentReceived[] @relation("SalesPaymentCompany")
  paymentsReceived   PaymentReceived[]      @relation("PaymentReceivedCompany")
  transactions       Transaction[]          @relation("TransactionCompany")
  posTerminals       POSTerminal[]
  posShifts          POSShift[]
  posSales           POSSale[]
  posReturns         POSReturn[]
  restaurantOrders   RestaurantOrder[]
  kitchenStations    KitchenStation[]
  posAuditLogs       POSAuditLog[]
  pdfReportSettings  PdfReportSetting[]
  supportTickets     SupportTicket[]
  locations          Location[]
  salespersons       Salesperson[]          @relation("SalespersonCompany")
  stockWriteOffs     StockWriteOff[]        @relation("StockWriteOffCompany")
  productStocks      ProductStock[]
  hrOffices          HrOffice[]
  hrEmployees        HrEmployee[]
  hrAttendances      HrAttendance[]
  hrEmployeeLocations HrEmployeeLocation[]
  hrLeaves           HrLeave[]
  hrOvertimes        HrOvertime[]
  hrTasks            HrTask[]
  hrPerformanceReviews HrPerformanceReview[]
  hrPayPeriods       HrPayPeriod[]
  hrPayrollRuns      HrPayrollRun[]
  hrPayrollItems     HrPayrollItem[]
  hrSetting          HrSetting?
  hrDepartments      HrDepartment[]
  costCenters        CostCenter[]
  hrDesignations     HrDesignation[]
  hrShifts           HrShift[]
  hrHolidays         HrHoliday[]
  hrLeaveTypes       HrLeaveType[]
  hrLeaveBalances    HrLeaveBalance[]
  hrRosters          HrRoster[]
  customRoles        Role[]
  securityAuditLogs  SecurityAuditLog[]
  hrAttendanceCorrections HrAttendanceCorrection[]
  hrLoans            HrLoan[]
  hrBonuses          HrBonus[]
  hrDocuments        HrDocument[]
  hrLifecycleEvents  HrLifecycleEvent[]
  hrApprovals        HrApproval[]
  hrAuditLogs        HrAuditLog[]
  hrGoals            HrGoal[]
  hrFeedbacks        HrFeedback[]
  hrShiftSwaps       HrShiftSwap[]
  hrPrintSetting     HrPrintSetting?
  hrSignatories      HrSignatory[]
  hrDocumentTemplates HrDocumentTemplate[]
  hrGeneratedDocuments HrGeneratedDocument[]
  internalTransfers    InternalTransfer[]   @relation("InternalTransferCompany")
  manufacturingBOMs  ManufacturingBOM[]            @relation("ManufacturingBOMCompany")
  manufacturingRoutings ManufacturingRouting[]        @relation("ManufacturingRoutingCompany")
  manufacturingWorkCenters ManufacturingWorkCenter[] @relation("ManufacturingWorkCenterCompany")
  manufacturingMachines ManufacturingMachine[]       @relation("ManufacturingMachineCompany")
  manufacturingProductionOrders ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderCompany")
  manufacturingWorkOrders ManufacturingWorkOrder[]   @relation("ManufacturingWorkOrderCompany")
  manufacturingMaterialReservations ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationCompany")
  manufacturingMaterialIssues ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueCompany")
  manufacturingMaterialConsumptions ManufacturingMaterialConsumption[] @relation("ManufacturingMaterialConsumptionCompany")
  manufacturingWIPs ManufacturingWIP[]             @relation("ManufacturingWIPCompany")
  manufacturingScraps ManufacturingScrap[]         @relation("ManufacturingScrapCompany")
  manufacturingByProducts ManufacturingByProduct[]   @relation("ManufacturingByProductCompany")
  manufacturingReworks ManufacturingRework[]       @relation("ManufacturingReworkCompany")
  manufacturingQualityInspections ManufacturingQualityInspection[] @relation("ManufacturingQualityInspectionCompany")
  manufacturingMaintenanceRequests ManufacturingMaintenanceRequest[] @relation("ManufacturingMaintenanceRequestCompany")
  manufacturingMaintenanceOrders ManufacturingMaintenanceOrder[] @relation("ManufacturingMaintenanceOrderCompany")
  manufacturingSubcontractVendors ManufacturingSubcontractVendor[] @relation("ManufacturingSubcontractVendorCompany")
  manufacturingSubcontractOrders ManufacturingSubcontractOrder[] @relation("ManufacturingSubcontractOrderCompany")
  manufacturingMRPs ManufacturingMRP[]             @relation("ManufacturingMRPCompany")
  manufacturingMPS ManufacturingMPS[]             @relation("ManufacturingMPSCompany")
  manufacturingDemands ManufacturingDemand[]       @relation("ManufacturingDemandCompany")
  manufacturingProductCosts ManufacturingProductCost[] @relation("ManufacturingProductCostCompany")
  manufacturingSetting ManufacturingSetting?      @relation("ManufacturingSettingCompany")
  inventorySettings        CompanyInventorySetting?
  inventoryImportBatches   InventoryImportBatch[]
  unitsOfMeasure           UnitOfMeasure[]
  uomConversions           UomConversion[]
  tradingDocuments         TradingDocument[]        @relation("TradingDocumentCompany")
  tradingPriceLists        TradingPriceList[]       @relation("TradingPriceListCompany")
  tradingCustomerPrices    TradingCustomerPrice[]   @relation("TradingCustomerPriceCompany")
  tradingAuditLogs         TradingAuditLog[]        @relation("TradingAuditLogCompany")
  importRfqs               ImportRfq[]              @relation("ImportRfqCompany")
  importSupplierQuotations ImportSupplierQuotation[] @relation("ImportSupplierQuotationCompany")
  importPurchaseOrders     ImportPurchaseOrder[]    @relation("ImportPurchaseOrderCompany")
  importProformaInvoices   ImportProformaInvoice[]  @relation("ImportProformaInvoiceCompany")
  importShipments          ImportShipment[]         @relation("ImportShipmentCompany")
  importCarriers           ImportCarrier[]          @relation("ImportCarrierCompany")
  importCustomsClearances  ImportCustomsClearance[] @relation("ImportCustomsClearanceCompany")
  importCustomsDutyPayments ImportCustomsDutyPayment[] @relation("ImportCustomsDutyPaymentCompany")
  importDocuments          ImportDocument[]         @relation("ImportDocumentCompany")
  importGrns               ImportGrn[]              @relation("ImportGrnCompany")
  importLandedCosts        ImportLandedCost[]       @relation("ImportLandedCostCompany")
  importFinanceLcs         ImportFinanceLc[]        @relation("ImportFinanceLcCompany")
  importSupplierBills      ImportSupplierBill[]     @relation("ImportSupplierBillCompany")
  importSupplierClaims     ImportSupplierClaim[]    @relation("ImportSupplierClaimCompany")
  importSetting            ImportSetting?           @relation("ImportSettingCompany")
  importAuditLogs          ImportAuditLog[]         @relation("ImportAuditLogCompany")
  businessConfig           CompanyBusinessConfig?
  salesInstallmentSchedules SalesInstallmentSchedule[] @relation("SalesInstallmentScheduleCompany")
  purchaseInstallmentSchedules PurchaseInstallmentSchedule[] @relation("PurchaseInstallmentScheduleCompany")

  @@index([email])
  @@index([isActive])
  @@index([parentCompanyId])
  @@map("companies")
}

// ============================================================
// COMPANY BUSINESS MODEL CONFIGURATION
// Operational sales/purchase model per company (not legal entity type).
// Child companies materialize a copy from parent on create; overrides
// are gated by allowChildConfigOverride on the parent config.
// ============================================================

model CompanyBusinessConfig {
  id     String @id @default(uuid())
  companyId String @unique @map("company_id")

  /// Trading | Manufacturing | Retail | Distribution | Services | Other
  operationalBusinessType String @default("Other") @map("operational_business_type")
  /// standard | installment | both
  salesModel String @default("standard") @map("sales_model")
  /// standard | installment
  purchaseModel String @default("standard") @map("purchase_model")
  /// full_on_sale | as_collected — accounting recognition policy (transaction rules still apply)
  installmentRevenuePolicy String @default("full_on_sale") @map("installment_revenue_policy")
  /// Parent policy: whether child companies may change their own business model
  allowChildConfigOverride Boolean @default(true) @map("allow_child_config_override")
  /// True when this row was seeded from a parent and has not been independently overridden
  inheritedFromParent Boolean @default(false) @map("inherited_from_parent")
  /// Company id this config was copied from (null for root / custom)
  sourceParentCompanyId String? @map("source_parent_company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([salesModel])
  @@index([purchaseModel])
  @@map("company_business_configs")
}

// ============================================================
// MULTI-LOCATION (Shop / Warehouse)
// ============================================================

model Location {
  id          String  @id @default(uuid())
  companyId   String  @map("company_id")
  name        String
  code        String
  type        String  @default("Shop") // Warehouse | Shop | POS_Store
  address     String?
  phone       String?
  isDefault   Boolean @default(false) @map("is_default")
  isActive    Boolean @default(true) @map("is_active")
  isDeleted   Boolean @default(false) @map("is_deleted")
  notes       String?
  createdBy   String? @map("created_by")
  updatedBy   String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productStocks    ProductStock[]
  stockMovements   StockMovement[]
  orders           Order[]
  deliveries       Delivery[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceivings      GoodsReceiving[]
  posTerminals         POSTerminal[]
  salesInvoices        SalesInvoice[]
  purchaseInvoices     PurchaseInvoice[]
  quotations           Quotation[]
  userLocations        UserLocation[]
  salespersons         Salesperson[]
  stockWriteOffs       StockWriteOff[]
  expenses             Expense[]
  incomes              Income[]
  journalEntries       JournalEntry[]
  manufacturingBOMs    ManufacturingBOM[]       @relation("ManufacturingBOMLocation")
  manufacturingWorkCenters ManufacturingWorkCenter[] @relation("ManufacturingWorkCenterLocation")
  manufacturingMachines ManufacturingMachine[]  @relation("ManufacturingMachineLocation")
  manufacturingProductionOrders ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderLocation")
  manufacturingProductionOrdersSource ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderSourceWarehouse")
  manufacturingProductionOrdersWIP ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderWIPWarehouse")
  manufacturingProductionOrdersFG ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderFinishedGoodsWarehouse")
  manufacturingMaterialReservations ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationLocation")
  manufacturingMaterialIssues ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueFromLocation")
  manufacturingMaterialIssuesTo ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueToLocation")
  manufacturingWIPs    ManufacturingWIP[]       @relation("ManufacturingWIPLocation")
  manufacturingByProducts ManufacturingByProduct[] @relation("ManufacturingByProductLocation")
  manufacturingMPS     ManufacturingMPS[]       @relation("ManufacturingMPSLocation")
  importGrns           ImportGrn[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@index([isDefault])
  internalTransfersFrom InternalTransfer[] @relation("InternalTransferFrom")
  internalTransfersTo   InternalTransfer[] @relation("InternalTransferTo")

  @@map("locations")
}

model UserLocation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_locations")
}

model ProductStock {
  id             String @id @default(uuid())
  companyId      String @map("company_id")
  productId      String @map("product_id")
  locationId     String @map("location_id")
  // Float to support fractional base-UOM quantities (KG, LTR, MTR)
  currentStock   Float  @default(0) @map("current_stock")
  reservedStock  Float  @default(0) @map("reserved_stock")
  availableStock Float  @default(0) @map("available_stock")
  minimumStock   Float  @default(0) @map("minimum_stock")
  reorderLevel   Float  @default(0) @map("reorder_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([companyId])
  @@index([productId])
  @@index([locationId])
  @@map("product_stocks")
}

// ============================================================
// INVENTORY SETTINGS / UOM / IMPORT
// ============================================================

model CompanyInventorySetting {
  id     String @id @default(uuid())
  companyId String @unique @map("company_id")

  /// WEIGHTED_AVERAGE | FIFO | STANDARD
  valuationMethod     String  @default("WEIGHTED_AVERAGE") @map("valuation_method")
  allowNegativeStock  Boolean @default(false) @map("allow_negative_stock")
  enableBatchTracking Boolean @default(true) @map("enable_batch_tracking")
  enableSerialTracking Boolean @default(false) @map("enable_serial_tracking")
  enableMultiWarehouse Boolean @default(true) @map("enable_multi_warehouse")
  enableBinManagement Boolean @default(true) @map("enable_bin_management")
  enableUomConversion Boolean @default(true) @map("enable_uom_conversion")
  quantityPrecision   Int     @default(6) @map("quantity_precision")
  costPrecision       Int     @default(4) @map("cost_precision")
  maxImportFileMb     Int     @default(15) @map("max_import_file_mb")
  inventoryOpeningDate DateTime? @map("inventory_opening_date")
  createMissingMastersDefault Boolean @default(false) @map("create_missing_masters_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_inventory_settings")
}

model UnitOfMeasure {
  id          String  @id @default(uuid())
  companyId   String  @map("company_id")
  code        String
  name        String
  symbol      String?
  isBase      Boolean @default(false) @map("is_base")
  isActive    Boolean @default(true) @map("is_active")
  decimalPlaces Int   @default(0) @map("decimal_places")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversionsFrom UomConversion[] @relation("UomConversionFrom")
  conversionsTo   UomConversion[] @relation("UomConversionTo")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units_of_measure")
}

model UomConversion {
  id             String @id @default(uuid())
  companyId      String @map("company_id")
  fromUomId      String @map("from_uom_id")
  toUomId        String @map("to_uom_id")
  /// 1 fromUom = factor toUom (e.g. 1 BOX = 100 PCS → factor 100)
  conversionFactor Float @map("conversion_factor")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromUom UnitOfMeasure @relation("UomConversionFrom", fields: [fromUomId], references: [id], onDelete: Cascade)
  toUom   UnitOfMeasure @relation("UomConversionTo", fields: [toUomId], references: [id], onDelete: Cascade)

  @@unique([companyId, fromUomId, toUomId])
  @@index([companyId])
  @@map("uom_conversions")
}

model InventoryImportBatch {
  id            String @id @default(uuid())
  companyId     String @map("company_id")
  batchNumber   String @map("batch_number")
  importType    String @default("ITEM_MASTER") @map("import_type") // ITEM_MASTER | TRANSACTIONS
  fileName      String? @map("file_name")
  fileHash      String? @map("file_hash")
  fileSize      Int?    @map("file_size")
  status        String  @default("Pending") // Pending | Validating | Preview | Processing | Completed | CompletedWithWarnings | Failed | Cancelled
  duplicateSkuMode String @default("skip") @map("duplicate_sku_mode") // skip | update | error
  createMissingMasters Boolean @default(false) @map("create_missing_masters")
  openingDate   DateTime? @map("opening_date")

  totalRows     Int @default(0) @map("total_rows")
  validRows     Int @default(0) @map("valid_rows")
  warningRows   Int @default(0) @map("warning_rows")
  errorRows     Int @default(0) @map("error_rows")
  duplicateRows Int @default(0) @map("duplicate_rows")
  importedCount Int @default(0) @map("imported_count")
  updatedCount  Int @default(0) @map("updated_count")
  skippedCount  Int @default(0) @map("skipped_count")

  /// Parsed + validated row payloads (preview / result)
  previewData   Json? @map("preview_data")
  resultSummary Json? @map("result_summary")
  columnMapping Json? @map("column_mapping")
  errorReport   Json? @map("error_report")
  warningReport Json? @map("warning_report")

  createdBy String  @map("created_by")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([companyId, batchNumber])
  @@index([companyId])
  @@index([fileHash])
  @@index([status])
  @@map("inventory_import_batches")
}

// ============================================================
// USER & AUTH MODELS
// ============================================================

model User {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String  @unique
  password  String
  phone     String  @default("")
  country   String  @default("Pakistan")
  role      String  @default("user")
  roleId    String? @map("role_id")
  managerId String? @map("manager_id")
  createdBy String? @map("created_by")
  companyId String? @map("company_id")
  isActive  Boolean @default(true) @map("is_active")
  assignedTerminalId String? @map("assigned_terminal_id")

  resetOtp       String?   @map("reset_otp")
  resetOtpExpiry DateTime? @map("reset_otp_expiry")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockUntil           DateTime? @map("lock_until")
