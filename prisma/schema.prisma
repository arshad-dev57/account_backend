// ============================================================
// EXPORT MANAGEMENT
// Full export sales lifecycle: inquiry -> quotation -> order ->
// proforma -> packing/inspection -> shipment/customs -> dispatch
// (commercial invoice + inventory) -> settlement receipts.
// Amounts are stored in the transaction currency (*Foreign) and in
// the company base currency (*Base) using the captured FX snapshot.
// ============================================================

model ExportInquiry {
  id                      String    @id @default(uuid())
  companyId               String    @map("company_id")
  inquiryNumber           String    @map("inquiry_number")
  date                    DateTime  @default(now())
  customerId              String?   @map("customer_id")
  customerName            String    @map("customer_name")
  customerCountry         String?   @map("customer_country")
  destinationPort         String?   @map("destination_port")
  destinationPortCode     String?   @map("destination_port_code")
  incoterm                String    @default("FOB")
  currency                String    @default("USD")
  exchangeRate            Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate        DateTime? @map("exchange_rate_date")
  rateSource              String?   @map("rate_source")
  baseCurrencyCode        String?   @map("base_currency_code")
  estimatedRevenueForeign Decimal   @default(0) @map("estimated_revenue_foreign") @db.Decimal(18, 4)
  estimatedRevenueBase    Decimal   @default(0) @map("estimated_revenue_base") @db.Decimal(18, 4)
  targetDispatchDate      DateTime? @map("target_dispatch_date")
  leadStage               String    @default("New Inquiry") @map("lead_stage")
  status                  String    @default("Draft")
  convertedQuotationId    String?   @map("converted_quotation_id")
  notes                   String?
  createdBy               String?   @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  company Company             @relation("ExportInquiryCompany", fields: [companyId], references: [id], onDelete: Cascade)
  items   ExportInquiryItem[]

  @@unique([companyId, inquiryNumber])
  @@index([companyId, status])
  @@index([companyId, date])
  @@index([customerId])
  @@map("export_inquiries")
}

