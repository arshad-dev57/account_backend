// prisma/schema.prisma - COMPLETE FINAL VERSION

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-CURRENCY MASTER
// ============================================================

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique // ISO 4217 e.g. PKR, USD
  name          String
  symbol        String
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  companiesBase           Company[]             @relation("CompanyBaseCurrency")
  suppliers               Supplier[]            @relation("SupplierCurrency")
  exchangeRatesFrom       ExchangeRate[]        @relation("ExchangeRateFrom")
  exchangeRatesTo         ExchangeRate[]        @relation("ExchangeRateTo")
  exchangeRateHistoryFrom ExchangeRateHistory[] @relation("ExchangeRateHistoryFrom")
  exchangeRateHistoryTo   ExchangeRateHistory[] @relation("ExchangeRateHistoryTo")

  purchaseOrdersAsTxn    PurchaseOrder[]       @relation("POCurrency")
  purchaseOrdersAsBase   PurchaseOrder[]       @relation("POBaseCurrency")
  purchaseInvoicesAsTxn  PurchaseInvoice[]     @relation("PICurrency")
  purchaseInvoicesAsBase PurchaseInvoice[]     @relation("PIBaseCurrency")
  purchasePaymentsAsTxn  PurchasePaymentMake[] @relation("PPMCurrency")
  purchasePaymentsAsBase PurchasePaymentMake[] @relation("PPMBaseCurrency")
  purchaseReturnsAsTxn   PurchaseReturn[]      @relation("PRCurrency")
  purchaseReturnsAsBase  PurchaseReturn[]      @relation("PRBaseCurrency")
  goodsReceivingsAsTxn   GoodsReceiving[]      @relation("GRNCurrency")
  goodsReceivingsAsBase  GoodsReceiving[]      @relation("GRNBaseCurrency")
  accountsPayableAsTxn   AccountsPayable[]     @relation("APCurrency")
  accountsPayableAsBase  AccountsPayable[]     @relation("APBaseCurrency")

  @@index([code])
  @@index([isActive])
  @@map("currencies")
}

model ExchangeRate {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  fromCurrencyId String    @map("from_currency_id")
  toCurrencyId   String    @map("to_currency_id")
  rate           Decimal   @db.Decimal(18, 8)
  effectiveDate  DateTime  @map("effective_date") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  /// MANUAL | PROVIDER:<name> | IDENTITY | EXISTING
  source         String    @default("MANUAL")
  fetchedAt      DateTime? @map("fetched_at")
  notes          String?
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company      Company  @relation("CompanyExchangeRates", fields: [companyId], references: [id], onDelete: Cascade)
  fromCurrency Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])
  creator      User?    @relation("ExchangeRateCreator", fields: [createdBy], references: [id])

  @@unique([companyId, fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([companyId])
  @@index([fromCurrencyId, toCurrencyId])
  @@index([companyId, toCurrencyId, effectiveDate])
  @@index([effectiveDate])
  @@index([isActive])
  @@map("exchange_rates")
}

/// Append-only audit trail for rate edits. Posted transactions keep their own
/// snapshot, so changing a current rate never rewrites historical results.
model ExchangeRateHistory {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  exchangeRateId String?  @map("exchange_rate_id")
  fromCurrencyId String   @map("from_currency_id")
  toCurrencyId   String   @map("to_currency_id")
  oldRate        Decimal? @map("old_rate") @db.Decimal(18, 8)
  newRate        Decimal? @map("new_rate") @db.Decimal(18, 8)
  effectiveDate  DateTime @map("effective_date") @db.Date
  /// CREATE | UPDATE | DEACTIVATE | PROVIDER_REFRESH
  action         String   @default("UPDATE")
  source         String?
  reason         String?
  changedBy      String?  @map("changed_by")
  changedAt      DateTime @default(now()) @map("changed_at")

  company       Company  @relation("CompanyExchangeRateHistory", fields: [companyId], references: [id], onDelete: Cascade)
  fromCurrency  Currency @relation("ExchangeRateHistoryFrom", fields: [fromCurrencyId], references: [id])
  toCurrency    Currency @relation("ExchangeRateHistoryTo", fields: [toCurrencyId], references: [id])
  changedByUser User?    @relation("ExchangeRateHistoryUser", fields: [changedBy], references: [id])

  @@index([companyId, fromCurrencyId, toCurrencyId, changedAt])
  @@index([exchangeRateId])
  @@map("exchange_rate_history")
}

