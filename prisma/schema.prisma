  status String @default("Completed")

  journalEntryId String? @unique @map("journal_entry_id")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  currencyId       String?   @map("currency_id")
  baseCurrencyId   String?   @map("base_currency_id")
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate DateTime? @map("exchange_rate_date")
  foreignAmount    Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount       Decimal?  @map("base_amount") @db.Decimal(18, 4)

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
