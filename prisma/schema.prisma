  @@index([posReturnId])
  @@index([productId])
  @@map("pos_return_items")
}

model POSAuditLog {
  id        String   @id @default(uuid())
  action    String // Sale, Return, Refund, Void, Discount Approval, Shift Open, Shift Close, Cash Adjustment
  details   String   @default("")
  companyId String   @map("company_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  creator User    @relation("AuditCreator", fields: [createdBy], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdBy])
  @@map("pos_audit_logs")
}

// ============================================================
// INTERNATIONAL TAX MANAGEMENT
// ============================================================

model CompanyTaxProfile {
  id                    String   @id @default(uuid())
  companyId             String   @unique @map("company_id")
  countryCode           String   @default("US") @map("country_code")
  regime                String   @default("SALES_TAX") // VAT, GST, SALES_TAX, MIXED
  pricingModel          String   @default("exclusive") @map("pricing_model") // exclusive, inclusive
  taxRegistrationNumber String?  @map("tax_registration_number")
  filingFrequency       String   @default("quarterly") @map("filing_frequency")
  defaultJurisdictionId String?  @map("default_jurisdiction_id")
  recoverInputTax       Boolean  @default(true) @map("recover_input_tax")
  taxEnabled            Boolean  @default(true) @map("tax_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company              Company           @relation(fields: [companyId], references: [id])
  defaultJurisdiction  TaxJurisdiction?  @relation("DefaultTaxJurisdiction", fields: [defaultJurisdictionId], references: [id])

  @@index([countryCode])
  @@map("company_tax_profiles")
}

model TaxJurisdiction {
  id          String   @id @default(uuid())
  code        String
  name        String
  level       String // Country, State, County, City, SpecialZone
  parentId    String?  @map("parent_id")
  countryCode String   @map("country_code") // ISO 3166-1 alpha-2
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  companyId   String   @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent          TaxJurisdiction?  @relation("JurisdictionHierarchy", fields: [parentId], references: [id])
  children        TaxJurisdiction[] @relation("JurisdictionHierarchy")
  company         Company           @relation("TaxJurisdictionCompany", fields: [companyId], references: [id])
  taxRates        TaxRate[]
  taxTransactions TaxTransaction[]  @relation("TaxTransactionJurisdiction")
  defaultForProfiles CompanyTaxProfile[] @relation("DefaultTaxJurisdiction")

  @@unique([companyId, code])
  @@index([parentId])
  @@index([countryCode])
  @@index([companyId])
  @@map("tax_jurisdictions")
}

model TaxType {
  id              String   @id @default(uuid())
  code            String // VAT, GST, SALES_TAX, EXCISE, etc.
  name            String
  description     String?
  calculationType String   @default("percentage") // percentage, flat, tiered
  isCompound      Boolean  @default(false) @map("is_compound")
  isActive        Boolean  @default(true) @map("is_active")
  companyId       String   @map("company_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  company         Company          @relation("TaxTypeCompany", fields: [companyId], references: [id])
  taxRates        TaxRate[]
  taxTransactions TaxTransaction[] @relation("TaxTransactionType")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("tax_types")
}

model TaxRate {
  id             String    @id @default(uuid())
  jurisdictionId String    @map("jurisdiction_id")
  taxTypeId      String    @map("tax_type_id")
  rate           Float
  effectiveFrom  DateTime  @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  isDefault      Boolean   @default(false) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  companyId      String    @map("company_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  jurisdiction    TaxJurisdiction  @relation(fields: [jurisdictionId], references: [id])
  taxType         TaxType          @relation(fields: [taxTypeId], references: [id])
  company         Company          @relation("TaxRateCompany", fields: [companyId], references: [id])
  taxRules        TaxRule[]
  taxTransactions TaxTransaction[] @relation("TaxTransactionTaxRate")

  @@index([jurisdictionId])
  @@index([taxTypeId])
  @@index([companyId])
  @@map("tax_rates")
}

model TaxRule {
  id                String   @id @default(uuid())
  name              String
  taxRateId         String   @map("tax_rate_id")
  productCategoryId String?  @map("product_category_id")
  productId         String?  @map("product_id")
  customerGroupId   String?  @map("customer_group_id")
  pricingModel      String   @default("exclusive") // exclusive, inclusive, mixed
  exemptionAllowed  Boolean  @default(true) @map("exemption_allowed")
  compoundOn        String?  @map("compound_on") // tax rate code to compound on
  priority          Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")
  companyId         String   @map("company_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  taxRate TaxRate @relation(fields: [taxRateId], references: [id])
  company Company @relation("TaxRuleCompany", fields: [companyId], references: [id])

  @@index([taxRateId])
  @@index([productCategoryId])
  @@index([productId])
  @@index([companyId])
  @@map("tax_rules")
}

model TaxExemptionType {
  id                  String   @id @default(uuid())
  code                String // RESALE, NON_PROFIT, EXPORT, etc.
  name                String
  description         String?
  percentage          Float    @default(100) // 100% = full exemption
  requiresCertificate Boolean  @default(false) @map("requires_certificate")
  isActive            Boolean  @default(true) @map("is_active")
  companyId           String   @map("company_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  company    Company        @relation("TaxExemptionTypeCompany", fields: [companyId], references: [id])
  exemptions TaxExemption[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("tax_exemption_types")
}

model TaxExemption {
  id                   String    @id @default(uuid())
  exemptionTypeId      String    @map("exemption_type_id")
  customerId           String?   @map("customer_id")
  productId            String?   @map("product_id")
  productCategoryId    String?   @map("product_category_id")
  certificateNumber    String?   @map("certificate_number")
  certificateIssuedAt  DateTime? @map("certificate_issued_at")
  certificateExpiresAt DateTime? @map("certificate_expires_at")
  approvedBy           String?   @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  isActive             Boolean   @default(true) @map("is_active")
  companyId            String    @map("company_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  exemptionType TaxExemptionType @relation(fields: [exemptionTypeId], references: [id])
  customer      Customer?        @relation("CustomerTaxExemptions", fields: [customerId], references: [id])
  product       Product?         @relation("ProductTaxExemptions", fields: [productId], references: [id])
  approver      User?            @relation("ExemptionApprover", fields: [approvedBy], references: [id])
  company       Company          @relation("TaxExemptionCompany", fields: [companyId], references: [id])

  @@index([exemptionTypeId])
  @@index([customerId])
  @@index([productId])
  @@index([companyId])
  @@map("tax_exemptions")
}

model TaxTransaction {
  id              String   @id @default(uuid())
  transactionId   String   @map("transaction_id")
  transactionType String   @map("transaction_type") // POSSale, SalesInvoice, Order
  jurisdictionId  String   @map("jurisdiction_id")
  taxTypeId       String   @map("tax_type_id")
  taxRateId       String   @map("tax_rate_id")
  taxableAmount   Float    @map("taxable_amount")
  taxRate         Float    @map("tax_rate")
  taxAmount       Float    @map("tax_amount")
  exemptionAmount Float    @map("exemption_amount")
  isCompound      Boolean  @default(false) @map("is_compound")
  compoundOnId    String?  @map("compound_on_id")
  currency        String   @default("USD")
  exchangeRate    Float?   @map("exchange_rate")
  companyId       String   @map("company_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  jurisdiction    TaxJurisdiction @relation("TaxTransactionJurisdiction", fields: [jurisdictionId], references: [id])
  taxType         TaxType         @relation("TaxTransactionType", fields: [taxTypeId], references: [id])
  taxRateRelation TaxRate         @relation("TaxTransactionTaxRate", fields: [taxRateId], references: [id])
  company         Company         @relation("TaxTransactionCompany", fields: [companyId], references: [id])

  @@index([transactionId])
  @@index([transactionType])
  @@index([jurisdictionId])
  @@index([taxTypeId])
  @@index([companyId])
  @@map("tax_transactions")
}

// ============================================================
// MANUFACTURING MODULE
// ============================================================

// ============================================================
// MANUFACTURING BOM (Bill of Materials)
// ============================================================

model ManufacturingBOM {
  id                String   @id @default(uuid())
  bomNumber         String   @unique @map("bom_number")
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  version           String   @default("1.0")
  status            String   @default("Draft") // Draft | Active | Obsolete
  effectiveFrom     DateTime @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  description       String?
  notes             String?
  totalEstimatedCost Float   @default(0) @map("total_estimated_cost")
  
  createdBy         String   @map("created_by")
  updatedBy         String?  @map("updated_by")
  companyId         String   @map("company_id")
  locationId        String?  @map("location_id")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  product           Product                  @relation("ManufacturingBOMProduct", fields: [productId], references: [id])
  creator           User?                    @relation("ManufacturingBOMCreator", fields: [createdBy], references: [id])
  updater           User?                    @relation("ManufacturingBOMUpdater", fields: [updatedBy], references: [id])
  company           Company                  @relation("ManufacturingBOMCompany", fields: [companyId], references: [id])
  location          Location?                @relation("ManufacturingBOMLocation", fields: [locationId], references: [id])
  components        ManufacturingBOMComponent[]
  productionOrders  ManufacturingProductionOrder[]

  @@index([bomNumber])
  @@index([productId])
  @@index([status])
  @@index([companyId])
  @@index([locationId])
  @@map("manufacturing_boms")
}

model ManufacturingBOMComponent {
  id                String   @id @default(uuid())
  bomId             String   @map("bom_id")
  componentId       String   @map("component_id")
  componentName     String   @map("component_name")
  quantity          Float
  unitOfMeasure     String   @map("unit_of_measure")
  scrapPercentage   Float   @default(0) @map("scrap_percentage")
  substituteMaterial String? @map("substitute_material")
  operationSequence Int?     @map("operation_sequence")
  workCenterId      String?  @map("work_center_id")
  estimatedCost     Float    @default(0) @map("estimated_cost")
  notes             String?
  sequence          Int      @default(0)
  
  bom               ManufacturingBOM       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component         Product                @relation("ManufacturingBOMComponentProduct", fields: [componentId], references: [id])
  workCenter        ManufacturingWorkCenter? @relation("ManufacturingBOMComponentWorkCenter", fields: [workCenterId], references: [id])

  @@index([bomId])
  @@index([componentId])
  @@index([workCenterId])
  @@map("manufacturing_bom_components")
}

// ============================================================
// MANUFACTURING ROUTING
// ============================================================

model ManufacturingRouting {
  id                String   @id @default(uuid())
  routingNumber     String   @unique @map("routing_number")
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  version           String   @default("1.0")
  status            String   @default("Draft") // Draft | Active | Obsolete
  description       String?
  notes             String?
  totalEstimatedTime Float  @default(0) @map("total_estimated_time")
  totalEstimatedCost Float  @default(0) @map("total_estimated_cost")
  
  createdBy         String   @map("created_by")
  updatedBy         String?  @map("updated_by")
  companyId         String   @map("company_id")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  product           Product                  @relation("ManufacturingRoutingProduct", fields: [productId], references: [id])
  creator           User?                    @relation("ManufacturingRoutingCreator", fields: [createdBy], references: [id])
  updater           User?                    @relation("ManufacturingRoutingUpdater", fields: [updatedBy], references: [id])
  company           Company                  @relation("ManufacturingRoutingCompany", fields: [companyId], references: [id])
  operations        ManufacturingRoutingOperation[]
  productionOrders  ManufacturingProductionOrder[]

  @@index([routingNumber])
  @@index([productId])
  @@index([status])
  @@index([companyId])
  @@map("manufacturing_routings")
}

model ManufacturingRoutingOperation {
  id                String   @id @default(uuid())
  routingId         String   @map("routing_id")
  operationName     String   @map("operation_name")
  sequence          Int
  workCenterId      String   @map("work_center_id")
  machineId         String?  @map("machine_id")
  description       String?
  setupTime         Float    @default(0) @map("setup_time") // in minutes
  runTime           Float    @default(0) @map("run_time") // per unit in minutes
  queueTime         Float    @default(0) @map("queue_time") // in minutes
  laborRequirement  Float    @default(0) @map("labor_requirement") // number of workers
  machineRequirement Boolean @default(false) @map("machine_requirement")
  inspectionRequired Boolean @default(false) @map("inspection_required")
  estimatedCost     Float    @default(0) @map("estimated_cost")
  notes             String?
  
  routing           ManufacturingRouting     @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenter        ManufacturingWorkCenter @relation("ManufacturingRoutingOperationWorkCenter", fields: [workCenterId], references: [id])
  machine           ManufacturingMachine?    @relation("ManufacturingRoutingOperationMachine", fields: [machineId], references: [id])

  @@index([routingId])
  @@index([workCenterId])
  @@index([machineId])
  @@map("manufacturing_routing_operations")
}

// ============================================================
// MANUFACTURING WORK CENTER
// ============================================================

model ManufacturingWorkCenter {
  id                String   @id @default(uuid())
  workCenterCode    String   @unique @map("work_center_code")
  name              String
  department        String?
  locationId        String?  @map("location_id")
  factory           String?
  capacity          Float    @default(0) // per hour
  workingHours      Json?    @map("working_hours") // {"start": "08:00", "end": "17:00"}
  shift             String?
  efficiency        Float    @default(100) @map("efficiency") // percentage
  costPerHour       Float    @default(0) @map("cost_per_hour")
  status            String   @default("Active") // Active | Inactive | Maintenance
  description       String?
