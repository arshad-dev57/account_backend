  subtotal      Float @default(0)
  totalDiscount Float @default(0) @map("total_discount")
  totalTax      Float @default(0) @map("total_tax")
  grandTotal    Float @default(0) @map("grand_total")

  notes           String? @map("notes")
  termsConditions String? @map("terms_conditions")

  sentAt           DateTime? @map("sent_at")
  acceptedAt       DateTime? @map("accepted_at")
  rejectedAt       DateTime? @map("rejected_at")
  convertedAt      DateTime? @map("converted_at")
  convertedOrderId String?   @map("converted_order_id")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items          QuotationItem[]
  customer       Customer?       @relation(fields: [customerId], references: [id])
  creator        User?           @relation("QuotationCreator", fields: [createdBy], references: [id])
  updater        User?           @relation("QuotationUpdater", fields: [updatedBy], references: [id])
  company        Company?        @relation("QuotationCompany", fields: [companyId], references: [id])
  convertedOrder Order?          @relation("ConvertedQuotation", fields: [convertedOrderId], references: [id])

  @@unique([convertedOrderId])
  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
  @@index([validUntil])
  @@index([isActive])
  @@index([companyId])
  @@map("quotations")
