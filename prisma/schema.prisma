  effectiveFrom     DateTime @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  materialCost      Float    @default(0) @map("material_cost")
  laborCost         Float    @default(0) @map("labor_cost")
  machineCost       Float    @default(0) @map("machine_cost")
  overheadCost      Float    @default(0) @map("overhead_cost")
  subcontractCost   Float    @default(0) @map("subcontract_cost")
  totalCost         Float    @default(0) @map("total_cost")
  costType          String   @default("Standard") @map("cost_type") // Standard | Actual
  status            String   @default("Active") // Active | Obsolete
  notes             String?
  
  createdBy         String   @map("created_by")
  updatedBy         String?  @map("updated_by")
  companyId         String   @map("company_id")
  
