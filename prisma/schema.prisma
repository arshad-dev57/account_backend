  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  company      Company               @relation("ImportLandedCostCompany", fields: [companyId], references: [id], onDelete: Cascade)
  importPo     ImportPurchaseOrder?  @relation(fields: [importPoId], references: [id], onDelete: SetNull)
  shipment     ImportShipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  grn          ImportGrn?            @relation(fields: [grnId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  creator      User?                 @relation("ImportLandedCostCreator", fields: [createdBy], references: [id])
  items        ImportLandedCostItem[]

  @@unique([companyId, allocationNumber])
  @@index([companyId, status])
  @@index([importPoId])
  @@index([grnId])
  @@index([journalEntryId])
  @@map("import_landed_costs")
}

model ImportLandedCostItem {
  id                         String   @id @default(uuid())
  landedCostId               String   @map("landed_cost_id")
  productId                  String?  @map("product_id")
  productName                String   @map("product_name")
  qty                        Decimal  @default(1) @db.Decimal(18, 4)
  unitFobUsd                 Decimal  @default(0) @map("unit_fob_usd") @db.Decimal(18, 4)
  allocatedExpensePerUnitUsd Decimal  @default(0) @map("allocated_expense_per_unit_usd") @db.Decimal(18, 4)
  finalLandedCostPerUnitUsd  Decimal  @default(0) @map("final_landed_cost_per_unit_usd") @db.Decimal(18, 4)
  originalCostVariancePct    Decimal  @default(0) @map("original_cost_variance_pct") @db.Decimal(8, 2)

  landedCost ImportLandedCost @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  product    Product?         @relation(fields: [productId], references: [id])

  @@index([landedCostId])
  @@index([productId])
  @@map("import_landed_cost_items")
}

