  accounts              Json     @default("[]")
  condition             String   @default("") @db.Text
  amount                Float    @default(0)
  amountBasedOnFormula  Boolean  @default(false) @map("amount_based_on_formula")
  formula               String   @default("") @db.Text
  isFlexibleBenefit     Boolean  @default(false) @map("is_flexible_benefit")
  payoutMethod          String   @default("") @map("payout_method")
  finalCycleAccrualPayout Boolean @default(false) @map("final_cycle_accrual_payout")
  maxBenefitAmount      Float    @default(0) @map("max_benefit_amount")
