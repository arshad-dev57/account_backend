  notes             String?
  
  subcontractOrder  ManufacturingSubcontractOrder @relation(fields: [subcontractOrderId], references: [id], onDelete: Cascade)
  material          Product                    @relation("ManufacturingSubcontractMaterialReceivedMaterial", fields: [materialId], references: [id])

  @@index([subcontractOrderId])
  @@map("manufacturing_subcontract_materials_received")
}

