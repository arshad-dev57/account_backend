  creator         User?                    @relation("PurchasePaymentMakeCreator", fields: [createdBy], references: [id])
  updater         User?                    @relation("PurchasePaymentMakeUpdater", fields: [updatedBy], references: [id])
  company         Company?                 @relation("PurchasePaymentMakeCompany", fields: [companyId], references: [id])
  currency        Currency?                @relation("PPMCurrency", fields: [currencyId], references: [id])
  baseCurrency    Currency?                @relation("PPMBaseCurrency", fields: [baseCurrencyId], references: [id])
  invoicePayments PurchasePaymentInvoice[]
  journalEntry    JournalEntry?            @relation("PaymentJournalEntry", fields: [journalEntryId], references: [id])
  accountsPayable AccountsPayable[]        @relation("PaymentMakeAPRecords")
