  invoiceId     String @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  amountPaid    Float  @map("amount_paid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  payment PurchasePaymentMake @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice PurchaseInvoice     @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("purchase_payment_invoices")
}

model PurchasePaymentMake {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number")
  paymentDate   DateTime @default(now()) @map("payment_date")

  supplierId   String @map("supplier_id")
  supplierName String @map("supplier_name")

  amount        Float
  paymentMethod String @map("payment_method")
  reference     String @default("") @map("reference_no")
