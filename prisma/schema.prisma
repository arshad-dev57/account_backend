// ============================================================
// PURCHASE RETURN MODELS
// ============================================================

model PurchaseReturnItem {
  id          String @id @default(uuid())
  returnId    String @map("return_id")
  productId   String @map("product_id")
  productName String @map("product_name")
  sku         String

  purchaseInvoiceId     String  @map("purchase_invoice_id")
  purchaseInvoiceItemId String? @map("purchase_invoice_item_id")

  purchasedQuantity  Int @map("purchased_quantity")
