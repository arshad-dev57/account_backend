// ============================================================
// COMPANY BUSINESS MODEL CONFIGURATION
// Operational sales/purchase model per company (not legal entity type).
// Child companies materialize a copy from parent on create; overrides
// are gated by allowChildConfigOverride on the parent config.
// ============================================================

model CompanyBusinessConfig {
  id        String @id @default(uuid())
  companyId String @unique @map("company_id")

  /// Trading | Manufacturing | Retail | Distribution | Services | Other
  operationalBusinessType  String  @default("Other") @map("operational_business_type")
  /// standard | installment | both
  salesModel               String  @default("standard") @map("sales_model")
  /// standard | installment
  purchaseModel            String  @default("standard") @map("purchase_model")
  /// full_on_sale | as_collected — accounting recognition policy (transaction rules still apply)
  installmentRevenuePolicy String  @default("full_on_sale") @map("installment_revenue_policy")
  /// Parent policy: whether child companies may change their own business model
  allowChildConfigOverride Boolean @default(true) @map("allow_child_config_override")
  /// True when this row was seeded from a parent and has not been independently overridden
  inheritedFromParent      Boolean @default(false) @map("inherited_from_parent")
  /// Company id this config was copied from (null for root / custom)
  sourceParentCompanyId    String? @map("source_parent_company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([salesModel])
  @@index([purchaseModel])
  @@map("company_business_configs")
}

// ============================================================
// MULTI-LOCATION (Shop / Warehouse)
// ============================================================

model Location {
  id        String  @id @default(uuid())
  companyId String  @map("company_id")
  name      String
  code      String
  type      String  @default("Shop") // Warehouse | Shop | POS_Store
  address   String?
  phone     String?
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")
  notes     String?
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                             Company                            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productStocks                       ProductStock[]
  stockMovements                      StockMovement[]
  orders                              Order[]
  deliveries                          Delivery[]
  purchaseOrders                      PurchaseOrder[]
  purchaseRequisitions                PurchaseRequisition[]
  goodsReceivings                     GoodsReceiving[]
  posTerminals                        POSTerminal[]
  salesInvoices                       SalesInvoice[]
  purchaseInvoices                    PurchaseInvoice[]
  quotations                          Quotation[]
  userLocations                       UserLocation[]
  salespersons                        Salesperson[]
  stockWriteOffs                      StockWriteOff[]
  expenses                            Expense[]
  incomes                             Income[]
  journalEntries                      JournalEntry[]
  manufacturingBOMs                   ManufacturingBOM[]                 @relation("ManufacturingBOMLocation")
  manufacturingWorkCenters            ManufacturingWorkCenter[]          @relation("ManufacturingWorkCenterLocation")
  manufacturingMachines               ManufacturingMachine[]             @relation("ManufacturingMachineLocation")
  manufacturingProductionOrders       ManufacturingProductionOrder[]     @relation("ManufacturingProductionOrderLocation")
  manufacturingProductionOrdersSource ManufacturingProductionOrder[]     @relation("ManufacturingProductionOrderSourceWarehouse")
  manufacturingProductionOrdersWIP    ManufacturingProductionOrder[]     @relation("ManufacturingProductionOrderWIPWarehouse")
  manufacturingProductionOrdersFG     ManufacturingProductionOrder[]     @relation("ManufacturingProductionOrderFinishedGoodsWarehouse")
  manufacturingMaterialReservations   ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationLocation")
  manufacturingMaterialIssues         ManufacturingMaterialIssue[]       @relation("ManufacturingMaterialIssueFromLocation")
  manufacturingMaterialIssuesTo       ManufacturingMaterialIssue[]       @relation("ManufacturingMaterialIssueToLocation")
  manufacturingWIPs                   ManufacturingWIP[]                 @relation("ManufacturingWIPLocation")
  manufacturingByProducts             ManufacturingByProduct[]           @relation("ManufacturingByProductLocation")
  manufacturingMPS                    ManufacturingMPS[]                 @relation("ManufacturingMPSLocation")
  importGrns                          ImportGrn[]
  internalTransfersFrom               InternalTransfer[]                 @relation("InternalTransferFrom")
  internalTransfersTo                 InternalTransfer[]                 @relation("InternalTransferTo")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@index([isDefault])
  @@map("locations")
}

model UserLocation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_locations")
}

model ProductStock {
  id             String @id @default(uuid())
  companyId      String @map("company_id")
  productId      String @map("product_id")
  locationId     String @map("location_id")
  // Float to support fractional base-UOM quantities (KG, LTR, MTR)
  currentStock   Float  @default(0) @map("current_stock")
  reservedStock  Float  @default(0) @map("reserved_stock")
  availableStock Float  @default(0) @map("available_stock")
  minimumStock   Float  @default(0) @map("minimum_stock")
  reorderLevel   Float  @default(0) @map("reorder_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([companyId])
  @@index([productId])
  @@index([locationId])
  @@map("product_stocks")
}

// ============================================================
// INVENTORY SETTINGS / UOM / IMPORT
// ============================================================

model CompanyInventorySetting {
  id        String @id @default(uuid())
  companyId String @unique @map("company_id")

  /// WEIGHTED_AVERAGE | FIFO | STANDARD
  valuationMethod             String    @default("WEIGHTED_AVERAGE") @map("valuation_method")
  allowNegativeStock          Boolean   @default(false) @map("allow_negative_stock")
  enableBatchTracking         Boolean   @default(true) @map("enable_batch_tracking")
  enableSerialTracking        Boolean   @default(false) @map("enable_serial_tracking")
  enableMultiWarehouse        Boolean   @default(true) @map("enable_multi_warehouse")
  enableBinManagement         Boolean   @default(true) @map("enable_bin_management")
  enableUomConversion         Boolean   @default(true) @map("enable_uom_conversion")
  quantityPrecision           Int       @default(6) @map("quantity_precision")
  costPrecision               Int       @default(4) @map("cost_precision")
  maxImportFileMb             Int       @default(15) @map("max_import_file_mb")
  inventoryOpeningDate        DateTime? @map("inventory_opening_date")
  createMissingMastersDefault Boolean   @default(false) @map("create_missing_masters_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_inventory_settings")
}

model UnitOfMeasure {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  code          String
  name          String
  symbol        String?
  isBase        Boolean  @default(false) @map("is_base")
  isActive      Boolean  @default(true) @map("is_active")
  decimalPlaces Int      @default(0) @map("decimal_places")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversionsFrom UomConversion[] @relation("UomConversionFrom")
  conversionsTo   UomConversion[] @relation("UomConversionTo")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units_of_measure")
}

model UomConversion {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  fromUomId        String   @map("from_uom_id")
  toUomId          String   @map("to_uom_id")
  /// 1 fromUom = factor toUom (e.g. 1 BOX = 100 PCS → factor 100)
  conversionFactor Float    @map("conversion_factor")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromUom UnitOfMeasure @relation("UomConversionFrom", fields: [fromUomId], references: [id], onDelete: Cascade)
  toUom   UnitOfMeasure @relation("UomConversionTo", fields: [toUomId], references: [id], onDelete: Cascade)

  @@unique([companyId, fromUomId, toUomId])
  @@index([companyId])
  @@map("uom_conversions")
}

model InventoryImportBatch {
  id                   String    @id @default(uuid())
  companyId            String    @map("company_id")
  batchNumber          String    @map("batch_number")
  importType           String    @default("ITEM_MASTER") @map("import_type") // ITEM_MASTER | TRANSACTIONS
  fileName             String?   @map("file_name")
  fileHash             String?   @map("file_hash")
  fileSize             Int?      @map("file_size")
  status               String    @default("Pending") // Pending | Validating | Preview | Processing | Completed | CompletedWithWarnings | Failed | Cancelled
  duplicateSkuMode     String    @default("skip") @map("duplicate_sku_mode") // skip | update | error
  createMissingMasters Boolean   @default(false) @map("create_missing_masters")
  openingDate          DateTime? @map("opening_date")

  totalRows     Int @default(0) @map("total_rows")
  validRows     Int @default(0) @map("valid_rows")
  warningRows   Int @default(0) @map("warning_rows")
  errorRows     Int @default(0) @map("error_rows")
  duplicateRows Int @default(0) @map("duplicate_rows")
  importedCount Int @default(0) @map("imported_count")
  updatedCount  Int @default(0) @map("updated_count")
  skippedCount  Int @default(0) @map("skipped_count")

  /// Parsed + validated row payloads (preview / result)
  previewData   Json? @map("preview_data")
  resultSummary Json? @map("result_summary")
  columnMapping Json? @map("column_mapping")
  errorReport   Json? @map("error_report")
  warningReport Json? @map("warning_report")

  createdBy   String    @map("created_by")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([companyId, batchNumber])
  @@index([companyId])
  @@index([fileHash])
  @@index([status])
  @@map("inventory_import_batches")
}

