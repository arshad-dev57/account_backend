}

// ============================================================
// DEDICATED HR DOCUMENTS, PRINT & BRANDING SUBSYSTEM (HR ONLY)
// ============================================================

model HrPrintSetting {
  id                     String   @id @default(uuid())
  companyId              String   @unique @map("company_id")
  
  // HR Branding
  companyName            String   @default("") @map("company_name")
  companyAddress         String   @default("") @map("company_address")
  companyPhone           String   @default("") @map("company_phone")
  companyEmail           String   @default("") @map("company_email")
  companyWebsite         String   @default("") @map("company_website")
  registrationNo         String   @default("") @map("registration_no")
  primaryLogo            String   @default("") @map("primary_logo")
  secondaryLogo          String   @default("") @map("secondary_logo")
  officialStamp          String   @default("") @map("official_stamp")
  
  // Page Setup & Layout
  paperSize              String   @default("A4") @map("paper_size")
  orientation            String   @default("portrait")
  marginTop              Int      @default(15) @map("margin_top")
  marginBottom           Int      @default(15) @map("margin_bottom")
  marginLeft             Int      @default(15) @map("margin_left")
  marginRight            Int      @default(15) @map("margin_right")
  fontFamily             String   @default("Inter") @map("font_family")
  primaryColor           String   @default("#014582") @map("primary_color")
  headerSubtitle         String   @default("") @map("header_subtitle")
  footerText             String   @default("Confidential HR Document - For Internal Use Only") @map("footer_text")
  
  // Display Toggles
  showLogo               Boolean  @default(true) @map("show_logo")
  showStamp              Boolean  @default(true) @map("show_stamp")
  showPageNumbers        Boolean  @default(true) @map("show_page_numbers")
  showFooter             Boolean  @default(true) @map("show_footer")
  
  // Payslip Settings
  payslipTitle           String   @default("PAYSLIP STATEMENT") @map("payslip_title")
  showEarningsBreakdown  Boolean  @default(true) @map("show_earnings_breakdown")
  showDeductionsBreakdown Boolean @default(true) @map("show_deductions_breakdown")
  showAttendanceSummary  Boolean  @default(true) @map("show_attendance_summary")
  showYtdTotals          Boolean  @default(false) @map("show_ytd_totals")
  payslipNotes           String   @default("This is a computer-generated payslip. No physical signature required unless stamped.") @map("payslip_notes")

  // Sequence / Numbering Prefixes
  offerPrefix            String   @default("OFR-") @map("offer_prefix")
  offerSeq               Int      @default(1001) @map("offer_seq")
  appointmentPrefix      String   @default("APT-") @map("appointment_prefix")
  appointmentSeq         Int      @default(1001) @map("appointment_seq")
  salaryCertPrefix       String   @default("SAL-") @map("salary_cert_prefix")
  salaryCertSeq          Int      @default(1001) @map("salary_cert_seq")
  experiencePrefix       String   @default("EXP-") @map("experience_prefix")
  experienceSeq          Int      @default(1001) @map("experience_seq")

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signatories            HrSignatory[]

  @@map("hr_print_settings")
}

model HrSignatory {
  id           String   @id @default(uuid())
  settingId    String   @map("setting_id")
  companyId    String   @map("company_id")
  
  label        String   @default("Authorized Signatory")
  name         String   @default("")
  designation  String   @default("")
  signatureUrl String   @default("") @map("signature_url")
  stampUrl     String   @default("") @map("stamp_url")
  alignment    String   @default("left")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  setting      HrPrintSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([settingId])
  @@map("hr_signatories")
}

model HrDocumentTemplate {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  
  templateType String   @map("template_type") // OfferLetter, AppointmentLetter, SalaryCertificate, ExperienceLetter, PromotionLetter, TransferLetter, WarningLetter, TerminationLetter, Payslip, Report, Custom
  name         String
  description  String   @default("")
  contentBody  String   @db.Text @map("content_body")
  headerHtml   String   @default("") @map("header_html")
  footerHtml   String   @default("") @map("footer_html")
  isDefault    Boolean  @default(false) @map("is_default")
  version      Int      @default(1)
  status       String   @default("Published") // Draft, Published, Archived

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions     HrDocumentTemplateVersion[]

  @@index([companyId, templateType])
  @@map("hr_document_templates")
}

model HrDocumentTemplateVersion {
  id            String   @id @default(uuid())
  templateId    String   @map("template_id")
  versionNumber Int      @map("version_number")
  contentBody   String   @db.Text @map("content_body")
  headerHtml    String   @default("") @map("header_html")
  footerHtml    String   @default("") @map("footer_html")
  createdBy     String   @default("") @map("created_by")
  changeSummary String   @default("") @map("change_summary")
  createdAt     DateTime @default(now()) @map("created_at")

  template      HrDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("hr_document_template_versions")
}

model HrGeneratedDocument {
  id                    String   @id @default(uuid())
  companyId             String   @map("company_id")
  employeeId            String?  @map("employee_id")
  templateId            String?  @map("template_id")
  templateVersionNumber Int      @default(1) @map("template_version_number")
  documentType          String   @map("document_type")
  documentNumber        String   @map("document_number")
  title                 String
  snapshotDataJson      Json     @map("snapshot_data_json") // Frozen copy of employee data, branding, signatories, and text at time of generation
  renderedPdfUrl        String   @default("") @map("rendered_pdf_url")
  status                String   @default("Generated") // Draft, Generated, Issued, Revoked
  generatedBy           String   @default("") @map("generated_by")
  generatedAt           DateTime @default(now()) @map("generated_at")

  company               Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              HrEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@map("hr_generated_documents")
}

// ============================================================
// INTERNAL WAREHOUSE TRANSFERS
// ============================================================

model InternalTransfer {
  id              String   @id @default(uuid())
  transferNumber  String   @unique @map("transfer_number")
  companyId       String   @map("company_id")
  transferDate    DateTime @map("transfer_date")
  fromLocationId  String   @map("from_location_id")
  toLocationId    String   @map("to_location_id")
  status          String   @default("Draft") // Draft | Confirmed | InTransit | Received | Done | Cancelled
  priority        String   @default("Normal") // Low | Normal | High | Urgent
  reference       String?
  reason          String?
  notes           String?
  createdBy       String   @map("created_by")
  updatedBy       String?  @map("updated_by")
  confirmedBy     String?  @map("confirmed_by")
  confirmedAt     DateTime? @map("confirmed_at")
  dispatchedBy    String?  @map("dispatched_by")
  dispatchedAt    DateTime? @map("dispatched_at")
  receivedBy      String?  @map("received_by")
  receivedAt      DateTime? @map("received_at")
  completedBy     String?  @map("completed_by")
  completedAt     DateTime? @map("completed_at")
  cancelledBy     String?  @map("cancelled_by")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?  @map("cancel_reason")
  isDeleted       Boolean  @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company  @relation("InternalTransferCompany", fields: [companyId], references: [id], onDelete: Cascade)
  fromLocation Location @relation("InternalTransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("InternalTransferTo", fields: [toLocationId], references: [id])
  creator      User     @relation("InternalTransferCreator", fields: [createdBy], references: [id])

  items   InternalTransferItem[]
  history InternalTransferHistory[]

  @@index([companyId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdAt])
  @@map("internal_transfers")
}

model InternalTransferItem {
  id              String @id @default(uuid())
  transferId      String @map("transfer_id")
  productId       String @map("product_id")
  productName     String @map("product_name")
  sku             String @default("")
  requestedQty    Float  @default(0) @map("requested_qty")
  dispatchedQty   Float  @default(0) @map("dispatched_qty")
  receivedQty     Float  @default(0) @map("received_qty")
  unit            String @default("pcs")
  batchNumber     String? @map("batch_number")
  serialNumber    String? @map("serial_number")
  notes           String?

  transfer InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product          @relation("InternalTransferItemProduct", fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("internal_transfer_items")
}

model InternalTransferHistory {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  action     String   // Created | Confirmed | Dispatched | Received | Completed | Cancelled | Updated
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  createdAt  DateTime @default(now()) @map("created_at")

  transfer InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("internal_transfer_history")
}

// ============================================================
// SALESPERSON MODEL
// ============================================================

model Salesperson {
  id                String   @id @default(uuid())
  salespersonNumber String   @map("salesperson_number")
  name              String
  phone             String?
  email             String?
  employeeCode      String?  @map("employee_code")
  status            String   @default("Active")
  territory         String?
  commissionRate    Float    @default(0) @map("commission_rate")
  monthlyTarget     Float    @default(0) @map("monthly_target")
  notes             String?

  userId       String? @unique @map("user_id")
  hrEmployeeId String? @unique @map("hr_employee_id")
  companyId    String  @map("company_id")
  locationId   String? @map("location_id")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

