  roundToNearestIntegral Boolean @default(false) @map("round_to_nearest_integral")
  deductFullTaxOnSelectedPayrollDate Boolean @default(false) @map("deduct_full_tax_on_selected_payroll_date")
  variableBasedOnTaxableSalary Boolean @default(false) @map("variable_based_on_taxable_salary")
