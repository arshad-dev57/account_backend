// prisma/schema.prisma - COMPLETE FINAL VERSION

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// COMPANY MODEL (Multi-tenant)
// ============================================================

model Company {
  id                    String    @id @default(uuid())
  name                  String
  email                 String?   @unique
  phone                 String?
  address               String?
  businessType          String?   @map("business_type")
  taxRegistrationNumber String?   @map("tax_registration_number")
  logo                  String?
  website               String?
  isActive              Boolean   @default(true) @map("is_active")
  subscriptionPlan      String    @default("trial") @map("subscription_plan")
  subscriptionStatus    String    @default("active") @map("subscription_status")
  trialStartDate        DateTime? @map("trial_start_date")
  trialEndDate          DateTime? @map("trial_end_date")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users              User[]
  categories         Category[]             @relation("CategoryCompany")
  suppliers          Supplier[]             @relation("SupplierCompany")
  settings           Setting[]              @relation("SettingCompany")
  stockMovements     StockMovement[]        @relation("StockMovementCompany")
  orders             Order[]                @relation("OrderCompany")
  returns            Return[]               @relation("ReturnCompany")
  refunds            Refund[]               @relation("RefundCompany")
  warehousePurchases WarehousePurchase[]    @relation("WarehousePurchaseCompany")
  warehouseInvoices  WarehouseInvoice[]     @relation("WarehouseInvoiceCompany")
  chartOfAccounts    ChartOfAccount[]       @relation("ChartOfAccountCompany")
  customers          Customer[]             @relation("CustomerCompany")
  products           Product[]              @relation("ProductCompany")
  fiscalYears        FiscalYear[]           @relation("FiscalYearCompany")
  bankAccounts       BankAccount[]          @relation("BankAccountCompany")
  journalEntries     JournalEntry[]         @relation("JournalEntryCompany")
  bills              Bill[]                 @relation("BillCompany")
  incomes            Income[]               @relation("IncomeCompany")
  expenses           Expense[]              @relation("ExpenseCompany")
  trialBalanceViews  TrialBalanceView[]     @relation("TrialBalanceViewCompany")
  paymentsMade       PaymentMade[]          @relation("PaymentMadeCompany")
  purchasePayments   PurchasePaymentMake[]  @relation("PurchasePaymentMakeCompany")
  purchaseReturns    PurchaseReturn[]       @relation("PurchaseReturnCompany")
  creditNotes        CreditNote[]           @relation("CreditNoteCompany")
  fixedAssets        FixedAsset[]           @relation("FixedAssetCompany")
  loans              Loan[]                 @relation("LoanCompany")
  equityAccounts     EquityAccount[]        @relation("EquityAccountCompany")
  equityTransactions EquityTransaction[]    @relation("EquityTransactionCompany")
  deliveries         Delivery[]             @relation("DeliveryCompany")
  quotations         Quotation[]            @relation("QuotationCompany")
  purchaseOrders     PurchaseOrder[]        @relation("PurchaseOrderCompany")
  taxJurisdictions   TaxJurisdiction[]      @relation("TaxJurisdictionCompany")
  taxTypes           TaxType[]              @relation("TaxTypeCompany")
  taxRates           TaxRate[]              @relation("TaxRateCompany")
  taxRules           TaxRule[]              @relation("TaxRuleCompany")
  taxExemptionTypes  TaxExemptionType[]     @relation("TaxExemptionTypeCompany")
  taxExemptions      TaxExemption[]         @relation("TaxExemptionCompany")
  taxTransactions    TaxTransaction[]       @relation("TaxTransactionCompany")
  goodsReceivings    GoodsReceiving[]       @relation("GoodsReceivingCompany")
  purchaseInvoices   PurchaseInvoice[]      @relation("PurchaseInvoiceCompany")
  salesInvoices      SalesInvoice[]         @relation("SalesInvoiceCompany")
  salesPayments      SalesPaymentReceived[] @relation("SalesPaymentCompany")
  paymentsReceived   PaymentReceived[]      @relation("PaymentReceivedCompany")
  transactions       Transaction[]          @relation("TransactionCompany")
  posTerminals       POSTerminal[]
  posShifts          POSShift[]
  posSales           POSSale[]
  posReturns         POSReturn[]
  posAuditLogs       POSAuditLog[]
  pdfReportSettings  PdfReportSetting[]

  @@index([email])
  @@index([isActive])
  @@map("companies")
}

// ============================================================
// USER & AUTH MODELS
// ============================================================

model User {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String  @unique
  password  String
  phone     String  @default("")
  country   String  @default("Pakistan")
  role      String  @default("user")
  roleId    String? @map("role_id")
  managerId String? @map("manager_id")
  createdBy String? @map("created_by")
  companyId String? @map("company_id")
  isActive  Boolean @default(true) @map("is_active")

  resetOtp       String?   @map("reset_otp")
  resetOtpExpiry DateTime? @map("reset_otp_expiry")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockUntil           DateTime? @map("lock_until")
  requiresLoginOtp    Boolean   @default(false) @map("requires_login_otp")
  loginOtp            String?   @map("login_otp")
  loginOtpExpiry      DateTime? @map("login_otp_expiry")

  organizationName String @default("") @map("organization_name")
  address          String @default("")
  contactNo        String @default("") @map("contact_no")
  websiteLink      String @default("") @map("website_link")
  businessDetails  Json?  @default("{}") @map("business_details")

  subscriptionPlan      String    @default("none") @map("subscription_plan")
  subscriptionStatus    String    @default("active") @map("subscription_status")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  trialStartDate        DateTime? @map("trial_start_date")
  trialEndDate          DateTime? @map("trial_end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptions             Subscription[]
  createdProducts           Product[]           @relation("ProductCreator")
  updatedProducts           Product[]           @relation("ProductUpdater")
  createdCategories         Category[]          @relation("CategoryCreator")
  updatedCategories         Category[]          @relation("CategoryUpdater")
  createdSuppliers          Supplier[]          @relation("SupplierCreator")
  createdSettings           Setting[]           @relation("SettingCreator")
  updatedSettings           Setting[]           @relation("SettingUpdater")
  stockMovements            StockMovement[]     @relation("StockMovementCreator")
  orderCreators             Order[]             @relation("OrderCreator")
  orderUpdaters             Order[]             @relation("OrderUpdater")
  orderPickers              Order[]             @relation("OrderPicker")
  orderPackers              Order[]             @relation("OrderPacker")
  orderShippers             Order[]             @relation("OrderShipper")
  returnCreators            Return[]            @relation("ReturnCreator")
  returnUpdaters            Return[]            @relation("ReturnUpdater")
  returnApprovers           Return[]            @relation("ReturnApprover")
  returnCustomers           Return[]            @relation("ReturnCustomer")
  customerCreators          Customer[]          @relation("CustomerCreator")
  customerUpdaters          Customer[]          @relation("CustomerUpdater")
  refundCreators            Refund[]            @relation("RefundCreator")
  refundUpdaters            Refund[]            @relation("RefundUpdater")
  refundProcessors          Refund[]            @relation("RefundProcessor")
  refundCustomers           Refund[]            @relation("RefundCustomer")
  warehouseInvoiceCreators  WarehouseInvoice[]  @relation("WarehouseInvoiceCreator")
  warehouseInvoiceUpdaters  WarehouseInvoice[]  @relation("WarehouseInvoiceUpdater")
  warehousePurchaseCreators WarehousePurchase[] @relation("WarehousePurchaseCreator")
  warehousePurchaseUpdaters WarehousePurchase[] @relation("WarehousePurchaseUpdater")

  chartOfAccountCreators  ChartOfAccount[]  @relation("ChartOfAccountCreator")
  bankAccountCreators     BankAccount[]     @relation("BankAccountCreator")
  journalEntryCreators    JournalEntry[]    @relation("JournalEntryCreator")
  journalEntryPosters     JournalEntry[]    @relation("JournalEntryPoster")
  billCreators            Bill[]            @relation("BillCreator")
  incomeCreators          Income[]          @relation("IncomeCreator")
  incomePosters           Income[]          @relation("IncomePoster")
  expenseCreators         Expense[]         @relation("ExpenseCreator")
  expensePosters          Expense[]         @relation("ExpensePoster")
  creditNoteCreators      CreditNote[]      @relation("CreditNoteCreator")
  paymentReceivedCreators PaymentReceived[] @relation("PaymentReceivedCreator")
  paymentMadeCreators     PaymentMade[]     @relation("PaymentMadeCreator")
  fixedAssetCreators      FixedAsset[]      @relation("FixedAssetCreator")
  loanCreators            Loan[]            @relation("LoanCreator")
  equityAccountCreators   EquityAccount[]   @relation("EquityAccountCreator")

  deliveryCreators            Delivery[]             @relation("DeliveryCreator")
  deliveryUpdaters            Delivery[]             @relation("DeliveryUpdater")
  deliveryConfirmers          Delivery[]             @relation("DeliveryConfirmer")
  quotationCreators           Quotation[]            @relation("QuotationCreator")
  quotationUpdaters           Quotation[]            @relation("QuotationUpdater")
  salesInvoiceCreators        SalesInvoice[]         @relation("SalesInvoiceCreator")
  salesInvoiceUpdaters        SalesInvoice[]         @relation("SalesInvoiceUpdater")
  salesPaymentCreators        SalesPaymentReceived[] @relation("SalesPaymentCreator")
  salesPaymentUpdaters        SalesPaymentReceived[] @relation("SalesPaymentUpdater")
  purchaseOrderCreators       PurchaseOrder[]        @relation("PurchaseOrderCreator")
  purchaseOrderUpdaters       PurchaseOrder[]        @relation("PurchaseOrderUpdater")
  goodsReceivingCreators      GoodsReceiving[]       @relation("GoodsReceivingCreator")
  goodsReceivingUpdaters      GoodsReceiving[]       @relation("GoodsReceivingUpdater")
  goodsReceivingConfirmers    GoodsReceiving[]       @relation("GoodsReceivingConfirmer")
  purchaseInvoiceCreators     PurchaseInvoice[]      @relation("PurchaseInvoiceCreator")
  purchaseInvoiceUpdaters     PurchaseInvoice[]      @relation("PurchaseInvoiceUpdater")
  purchasePaymentMakeCreators PurchasePaymentMake[]  @relation("PurchasePaymentMakeCreator")
  purchasePaymentMakeUpdaters PurchasePaymentMake[]  @relation("PurchasePaymentMakeUpdater")
  purchaseReturnCreators      PurchaseReturn[]       @relation("PurchaseReturnCreator")
  purchaseReturnUpdaters      PurchaseReturn[]       @relation("PurchaseReturnUpdater")
  purchaseReturnProcessors    PurchaseReturn[]       @relation("PurchaseReturnProcessor")
  purchaseReturnCancellers    PurchaseReturn[]       @relation("PurchaseReturnCanceller")
  transactionCreators         Transaction[]          @relation("TransactionCreator")
  transactionPosters          Transaction[]          @relation("TransactionPoster")

  fiscalYearAuditLogs FiscalYearAuditLog[]
  notifications       Notification[]
  managedUsers        User[]               @relation("ManagedUsers")
  manager             User?                @relation("ManagedUsers", fields: [managerId], references: [id])
  createdUsers        User[]               @relation("CreatedUsers")
  creator             User?                @relation("CreatedUsers", fields: [createdBy], references: [id])
  userRole            Role?                @relation(fields: [roleId], references: [id])
  permissions         UserPermission[]
  company             Company?             @relation(fields: [companyId], references: [id])
  createdTerminals    POSTerminal[]        @relation("TerminalCreator")
  shifts              POSShift[]           @relation("CashierShift")
  createdSales        POSSale[]            @relation("SaleCreator")
  createdReturns      POSReturn[]          @relation("ReturnCreator")
  createdAuditLogs    POSAuditLog[]        @relation("AuditCreator")
  approvedExemptions  TaxExemption[]       @relation("ExemptionApprover")
  pdfReportSettings   PdfReportSetting[]   @relation("PdfReportSettingOwner")

  @@index([email])
  @@index([roleId])
  @@index([managerId])
  @@index([createdBy])
  @@index([companyId])
  @@map("users")
}

// ============================================================
// PDF REPORT SETTINGS (separate from profile / businessDetails)
// ============================================================

model PdfReportSetting {
  id              String  @id @default(uuid())
  /// company:{companyId} or user:{userId} — one settings row per tenant scope
  scopeKey        String  @unique @map("scope_key")
  companyId       String? @map("company_id")
  userId          String  @map("user_id")

  companyName     String  @default("") @map("company_name")
  companyAddress  String  @default("") @map("company_address")
  logo            String  @default("")
  signature       String  @default("")

  showLogo        Boolean @default(true) @map("show_logo")
  showSignature   Boolean @default(true) @map("show_signature")
  showCompanyName Boolean @default(true) @map("show_company_name")
  showAddress     Boolean @default(true) @map("show_address")
  showPageNumbers Boolean @default(true) @map("show_page_numbers")

  layout          String  @default("classic")
  logoPosition    String  @default("left") @map("logo_position")
  headerSubtitle  String  @default("") @map("header_subtitle")
  footerText      String  @default("Confidential - For Internal Use Only") @map("footer_text")
  accentColor     String  @default("#014582") @map("accent_color")
  signatureLabel  String  @default("Authorized Signature") @map("signature_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation("PdfReportSettingOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("pdf_report_settings")
}

// ============================================================
// NOTIFICATION MODEL
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      String    @default("info") // info, success, warning, error
  category  String    @default("System") // System, Finance, Alert, etc.
  isRead    Boolean   @default(false) @map("is_read")
  data      Json?     @map("data") // Additional data like screen to navigate to
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// ROLE & PERMISSION MODELS
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // admin, manager, staff, viewer
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  permissions RolePermission[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "dashboard.view", "products.create"
  description String?
  module      String // e.g., "dashboard", "products", "reports"
  action      String // e.g., "view", "create", "edit", "delete"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER PERMISSION MODEL (for custom page-level access)
// ============================================================

model UserPermission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  page      String // e.g., "/warehouse/dashboard", "/warehouse/products"
  canView   Boolean  @default(true) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page])
  @@index([userId])
  @@index([page])
  @@map("user_permissions")
}

// ============================================================
// FISCAL YEAR MODELS
// ============================================================

model FiscalYear {
  id         String    @id @default(uuid())
  companyId  String?   @map("company_id")
  name       String    @db.VarChar(100)
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("Open")
  closedAt   DateTime? @map("closed_at")
  closedBy   String?   @map("closed_by")
  periodType String?   @map("period_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  company            Company?               @relation("FiscalYearCompany", fields: [companyId], references: [id])
  auditLogs          FiscalYearAuditLog[]
  journalEntries     JournalEntry[]         @relation("JournalEntryFiscalYear")
  expenses           Expense[]              @relation("ExpenseFiscalYear")
  incomes            Income[]               @relation("IncomeFiscalYear")
  paymentsReceived   PaymentReceived[]      @relation("PaymentReceivedFiscalYear")
  paymentsMade       PaymentMade[]          @relation("PaymentMadeFiscalYear")
  salesInvoices      SalesInvoice[]         @relation("SalesInvoiceFiscalYear")
  purchaseInvoices   PurchaseInvoice[]      @relation("PurchaseInvoiceFiscalYear")
  creditNotes        CreditNote[]           @relation("CreditNoteFiscalYear")
  purchaseReturns    PurchaseReturn[]       @relation("PurchaseReturnFiscalYear")
  transactions       Transaction[]          @relation("TransactionFiscalYear")
  fixedAssets        FixedAsset[]           @relation("FixedAssetFiscalYear")
  loans              Loan[]                 @relation("LoanFiscalYear")
  salesPayments      SalesPaymentReceived[] @relation("SalesPaymentFiscalYear")
  purchasePayments   PurchasePaymentMake[]  @relation("PurchasePaymentFiscalYear")
  accountsReceivable AccountsReceivable[]   @relation("ARFiscalYear")
  accountsPayable    AccountsPayable[]      @relation("APFiscalYear")
  equityAccounts     EquityAccount[]        @relation("EquityAccountFiscalYear")
  posSales           POSSale[]              @relation("POSSaleFiscalYear")
  posReturns         POSReturn[]            @relation("POSReturnFiscalYear")

  @@unique([companyId, name])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_years")
}

model FiscalYearAuditLog {
  id           String   @id @default(uuid())
  fiscalYearId String   @map("fiscal_year_id")
  userId       String   @map("user_id")
  action       String
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([fiscalYearId])
  @@index([userId])
  @@map("fiscal_year_audit_logs")
}

model Subscription {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  status         String    @default("active")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  amount         Float
  currency       String    @default("PKR")
  paymentMethod  String    @map("payment_method")
  transactionId  String    @default("") @map("transaction_id")
  paymentDetails Json?     @map("payment_details")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ============================================================
// CUSTOMER MODEL
// ============================================================

model Customer {
  id             String @id @default(uuid())
  customerNumber String @unique @map("customer_number")

  name         String
  email        String? @unique
  phone        String?
  companyName  String? @map("company_name")
  customerType String  @default("Individual") @map("customer_type")
  taxId        String? @map("tax_id")

  address         Json?
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  status String @default("Active")

  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  totalOrders        Int       @default(0) @map("total_orders")
  totalSpent         Float     @default(0) @map("total_spent")
  averageOrderValue  Float     @default(0) @map("average_order_value")
  lastOrderDate      DateTime? @map("last_order_date")
  outstandingBalance Float     @default(0) @map("outstanding_balance")
  creditLimit        Float     @default(0) @map("credit_limit")
  creditTerms        String    @default("Net 30") @map("credit_terms")

  notes String?
  tags  String[] @default([])

  preferences Json?

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator            User?                  @relation("CustomerCreator", fields: [createdBy], references: [id])
  updater            User?                  @relation("CustomerUpdater", fields: [updatedBy], references: [id])
  company            Company?               @relation("CustomerCompany", fields: [companyId], references: [id])
  orders             Order[]
  warehouseInvoices  WarehouseInvoice[]
  creditNotes        CreditNote[]
  payments           PaymentReceived[]
  incomes            Income[]
  posSales           POSSale[]              @relation("CustomerPOSSales")
  salesInvoices      SalesInvoice[]
  taxExemptions      TaxExemption[]         @relation("CustomerTaxExemptions")
  deliveries         Delivery[]
  quotations         Quotation[]
  accountsReceivable AccountsReceivable[]
  salesPayments      SalesPaymentReceived[]
  transactions       Transaction[]          @relation("CustomerTransactions")

  @@index([customerNumber])
  @@index([email])
  @@index([phone])
  @@index([customerType])
  @@index([status])
  @@index([isActive])
  @@index([name])
  @@index([companyId])
  @@map("customers")
}

// ============================================================
// PRODUCT MODEL
// ============================================================

model Product {
  id               String   @id @default(uuid())
  productId        String?  @unique @map("product_id")
  name             String
  sku              String
  barcodeNumber    String?  @unique @map("barcode_number")
  barcodeImage     String?  @map("barcode_image")
  description      String?
  shortDescription String?  @map("short_description")
  tags             String[] @default([])

  categoryId      String? @map("category_id")
  categoryName    String? @map("category_name")
  subCategoryId   String? @map("sub_category_id")
  subCategoryName String? @map("sub_category_name")
  brandId         String? @map("brand_id")
  brandName       String? @map("brand_name")
  modelNumber     String? @map("model_number")
  productType     String  @default("Physical") @map("product_type")
  hsCode          String? @map("hs_code")

  supplierId   String? @map("supplier_id")
  supplierName String? @map("supplier_name")
  supplierSku  String? @map("supplier_sku")
  leadTimeDays Int     @default(0) @map("lead_time_days")
  minOrderQty  Int     @default(1) @map("min_order_qty")
  maxOrderQty  Int     @default(999) @map("max_order_qty")
  reorderPoint Int     @default(10) @map("reorder_point")
  reorderQty   Int     @default(50) @map("reorder_qty")

  costPrice         Float     @map("cost_price")
  sellingPrice      Float     @map("selling_price")
  landingCost       Float     @default(0) @map("landing_cost")
  margin            Float     @default(0)
  marginPercentage  Float     @default(0) @map("margin_percentage")
  specialPrice      Float     @default(0) @map("special_price")
  specialPriceStart DateTime? @map("special_price_start")
  specialPriceEnd   DateTime? @map("special_price_end")
  taxRate           Float     @default(0) @map("tax_rate")
  taxType           String    @default("Exclusive") @map("tax_type")
  currencyCode      String    @default("PKR") @map("currency_code")
  totalValue        Float     @default(0) @map("total_value")
  retailPrice       Float     @default(0) @map("retail_price")
  wholesalePrice    Float     @default(0) @map("wholesale_price")

  currentStock     Int    @default(0) @map("current_stock")
  minimumStock     Int    @default(5) @map("minimum_stock")
  maximumStock     Int    @default(100) @map("maximum_stock")
  openingStock     Int    @default(0) @map("opening_stock")
  reservedStock    Int    @default(0) @map("reserved_stock")
  availableStock   Int    @default(0) @map("available_stock")
  reorderLevel     Int    @default(0) @map("reorder_level")
  safetyStock      Int    @default(0) @map("safety_stock")
  stockUnitName    String @default("Pcs") @map("stock_unit_name")
  conversionFactor Float  @default(1) @map("conversion_factor")

  isBoxBased  Boolean @default(false) @map("is_box_based")
  boxQuantity Int     @default(0) @map("box_quantity")
  boxUnitName String  @default("Box") @map("box_unit_name")

  rackLocationId       String? @map("rack_location_id")
