  exemptedFromIncomeTax Boolean  @default(false) @map("exempted_from_income_tax")
  accrualComponent      Boolean  @default(false) @map("accrual_component")
  doNotIncludeInTotal   Boolean  @default(false) @map("do_not_include_in_total")
  doNotIncludeInAccounts Boolean @default(false) @map("do_not_include_in_accounts")
  removeIfZeroValued    Boolean  @default(true) @map("remove_if_zero_valued")
