  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company  @relation("InternalTransferCompany", fields: [companyId], references: [id], onDelete: Cascade)
  fromLocation Location @relation("InternalTransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("InternalTransferTo", fields: [toLocationId], references: [id])
  creator      User     @relation("InternalTransferCreator", fields: [createdBy], references: [id])

  items   InternalTransferItem[]
  history InternalTransferHistory[]

  @@index([companyId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdAt])
  @@map("internal_transfers")
}

model InternalTransferItem {
  id              String @id @default(uuid())
  transferId      String @map("transfer_id")
  productId       String @map("product_id")
  productName     String @map("product_name")
  sku             String @default("")
  requestedQty    Float  @default(0) @map("requested_qty")
  dispatchedQty   Float  @default(0) @map("dispatched_qty")
  receivedQty     Float  @default(0) @map("received_qty")
  unit            String @default("pcs")
  batchNumber     String? @map("batch_number")
  serialNumber    String? @map("serial_number")
  notes           String?

  transfer InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product          @relation("InternalTransferItemProduct", fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("internal_transfer_items")
}

model InternalTransferHistory {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  action     String   // Created | Confirmed | Dispatched | Received | Completed | Cancelled | Updated
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  createdAt  DateTime @default(now()) @map("created_at")

  transfer InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("internal_transfer_history")
}
