// ============================================================
// STOCK WRITE-OFF MODELS
// ============================================================

model StockWriteOff {
  id             String   @id @default(uuid())
  writeOffNumber String   @unique @map("write_off_number")
  writeOffDate   DateTime @default(now()) @map("write_off_date")
  status         String   @default("Draft") @map("status") // Draft | Submitted | Approved | Rejected | Posted
  reason         String   @map("reason") // Expired | Damaged | Broken | Spoiled | Missing | Obsolete | Quality Issue | Other
  notes          String?
  totalCost      Float    @default(0) @map("total_cost")

  companyId        String  @map("company_id")
  locationId       String  @map("location_id")
  fiscalYearId     String? @map("fiscal_year_id")
  expenseAccountId String? @map("expense_account_id")
  journalEntryId   String? @unique @map("journal_entry_id")

  createdBy   String    @map("created_by")
  submittedBy String?   @map("submitted_by")
  approvedBy  String?   @map("approved_by")
  postedBy    String?   @map("posted_by")
  postedAt    DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company        Company             @relation("StockWriteOffCompany", fields: [companyId], references: [id])
  location       Location            @relation(fields: [locationId], references: [id])
  fiscalYear     FiscalYear?         @relation(fields: [fiscalYearId], references: [id])
  expenseAccount ChartOfAccount?     @relation("WriteOffExpenseAccount", fields: [expenseAccountId], references: [id])
  journalEntry   JournalEntry?       @relation("WriteOffJournalEntry", fields: [journalEntryId], references: [id])
  creator        User                @relation("WriteOffCreator", fields: [createdBy], references: [id])
  submitter      User?               @relation("WriteOffSubmitter", fields: [submittedBy], references: [id])
  approver       User?               @relation("WriteOffApprover", fields: [approvedBy], references: [id])
  poster         User?               @relation("WriteOffPoster", fields: [postedBy], references: [id])
  items          StockWriteOffItem[]

  @@index([companyId])
  @@index([locationId])
  @@index([status])
  @@index([writeOffDate])
  @@map("stock_write_offs")
}

model StockWriteOffItem {
  id             String    @id @default(uuid())
  writeOffId     String    @map("write_off_id")
  productId      String    @map("product_id")
  productName    String    @map("product_name")
  sku            String
  batchNumber    String?   @map("batch_number")
  expiryDate     DateTime? @map("expiry_date")
  unitOfMeasure  String?   @map("unit_of_measure")
  availableStock Float     @map("available_stock")
  quantity       Float     @map("quantity")
  unitCost       Float     @map("unit_cost")
  totalCost      Float     @map("total_cost")
  reason         String?

  writeOff StockWriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([writeOffId])
  @@index([productId])
  @@map("stock_write_off_items")
}

// ============================================================
// TRADING MODULE — classification layer over Sales / Purchases
// Does NOT duplicate posting; links to existing documents.
// ============================================================

model TradingDocument {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  documentType     String    @map("document_type") // SALES_ORDER | PURCHASE_ORDER | SALES_INVOICE | PURCHASE_INVOICE | DELIVERY | GRN | SALES_PAYMENT | PURCHASE_PAYMENT | SALES_RETURN | PURCHASE_RETURN | QUOTATION
  documentId       String    @map("document_id")
  documentNumber   String?   @map("document_number")
  tradeChannel     String    @default("domestic") @map("trade_channel") // domestic | wholesale | b2b | back_to_back
  tradeRef         String?   @map("trade_ref")
  counterpartyName String?   @map("counterparty_name")
  status           String? // mirrored display status from source document
  amountBase       Decimal?  @map("amount_base") @db.Decimal(18, 4)
  currencyCode     String?   @map("currency_code")
  documentDate     DateTime? @map("document_date")
  metadata         Json?
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company Company @relation("TradingDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation("TradingDocumentCreator", fields: [createdBy], references: [id])

  @@unique([companyId, documentType, documentId])
  @@index([companyId])
  @@index([companyId, documentType])
  @@index([companyId, tradeChannel])
  @@index([companyId, documentDate])
  @@index([documentId])
  @@map("trading_documents")
}

model TradingPriceList {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  code               String
  name               String
  /// Distributor | Wholesale | Retail | Key Account | Contract | Spot
  tier               String    @default("Wholesale")
  currencyCode       String    @default("PKR") @map("currency_code")
  /// Fixed | MarkupOnCost | DiscountOnList
  pricingMethod      String    @default("Fixed") @map("pricing_method")
  /// CostPrice | AverageCost | LastPurchase | StandardCost
  costBasis          String    @default("CostPrice") @map("cost_basis")
  discountPercentage Decimal   @default(0) @map("discount_percentage") @db.Decimal(8, 4)
  markupPercentage   Decimal   @default(0) @map("markup_percentage") @db.Decimal(8, 4)
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  isActive           Boolean   @default(true) @map("is_active")
  notes              String?
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company        Company                @relation("TradingPriceListCompany", fields: [companyId], references: [id], onDelete: Cascade)
  creator        User?                  @relation("TradingPriceListCreator", fields: [createdBy], references: [id])
  items          TradingPriceListItem[]
  customerPrices TradingCustomerPrice[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("trading_price_lists")
}

model TradingPriceListItem {
  id                 String    @id @default(uuid())
  priceListId        String    @map("price_list_id")
  productId          String    @map("product_id")
  unitName           String    @default("Pcs") @map("unit_name")
  unitPrice          Decimal   @map("unit_price") @db.Decimal(18, 4)
  listPrice          Decimal?  @map("list_price") @db.Decimal(18, 4)
  minQty             Decimal   @default(1) @map("min_qty") @db.Decimal(18, 4)
  maxQty             Decimal?  @map("max_qty") @db.Decimal(18, 4)
  discountPercentage Decimal   @default(0) @map("discount_percentage") @db.Decimal(8, 4)
  markupPercentage   Decimal   @default(0) @map("markup_percentage") @db.Decimal(8, 4)
  effectiveFrom      DateTime? @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date

  priceList TradingPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId, minQty])
  @@index([productId])
  @@map("trading_price_list_items")
}

model TradingCustomerPrice {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  customerId         String    @map("customer_id")
  productId          String    @map("product_id")
  priceListId        String?   @map("price_list_id")
  currencyCode       String    @default("PKR") @map("currency_code")
  unitName           String    @default("Pcs") @map("unit_name")
  listPrice          Decimal   @map("list_price") @db.Decimal(18, 4)
  negotiatedPrice    Decimal   @map("negotiated_price") @db.Decimal(18, 4)
  discountPercentage Decimal   @default(0) @map("discount_percentage") @db.Decimal(8, 4)
  targetMarginPct    Decimal   @default(20) @map("target_margin_pct") @db.Decimal(8, 4)
  minOrderQty        Decimal   @default(1) @map("min_order_qty") @db.Decimal(18, 4)
  effectiveFrom      DateTime? @map("effective_from") @db.Date
  effectiveUntil     DateTime? @map("effective_until") @db.Date
  /// Active | Under Review | Expired | Draft
  status             String    @default("Active")
  notes              String?
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company   Company           @relation("TradingCustomerPriceCompany", fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer          @relation(fields: [customerId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])
  priceList TradingPriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  creator   User?             @relation("TradingCustomerPriceCreator", fields: [createdBy], references: [id])

  @@unique([companyId, customerId, productId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([productId])
  @@index([priceListId])
  @@map("trading_customer_prices")
}

model TradingAuditLog {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  action     String // CREATE | LINK | UNLINK | UPDATE | CLASSIFY
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    Json?
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation("TradingAuditLogCompany", fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("TradingAuditLogUser", fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("trading_audit_logs")
}

// ============================================================
// IMPORT MANAGEMENT MODULE
// ============================================================

/// Global UN/LOCODE port master for Import RFQ / shipment discharge ports.
model ImportPort {
  id          String   @id @default(uuid())
  unLocode    String   @unique @map("un_locode")
  name        String
  country     String
  countryCode String?  @map("country_code")
  portType    String   @default("Sea") @map("port_type")
  isActive    Boolean  @default(true) @map("is_active")
  aliases     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  importRfqs ImportRfq[]

  @@index([name])
  @@index([country])
  @@map("import_ports")
}

model ImportRfq {
  id                        String    @id @default(uuid())
  companyId                 String    @map("company_id")
  rfqNumber                 String    @map("rfq_number")
  date                      DateTime  @default(now())
  supplierId                String?   @map("supplier_id")
  supplierName              String    @map("supplier_name")
  supplierCountry           String?   @map("supplier_country")
  incoterm                  String    @default("CIF")
  currency                  String    @default("USD")
  portId                    String?   @map("port_id")
  portOfDischarge           String?   @map("port_of_discharge")
  countryOfDispatch         String?   @map("country_of_dispatch")
  expectedDelivery          DateTime? @map("expected_delivery")
  quotationDeadline         DateTime? @map("quotation_deadline")
  status                    String    @default("Draft")
  totalEstimatedUsd         Decimal   @default(0) @map("total_estimated_usd") @db.Decimal(18, 4)
  selectedQuotationId       String?   @map("selected_quotation_id")
  singleSourceJustification String?   @map("single_source_justification")
  awardedBy                 String?   @map("awarded_by")
  awardedAt                 DateTime? @map("awarded_at")
  approvedBy                String?   @map("approved_by")
  approvedAt                DateTime? @map("approved_at")
  notes                     String?
  createdBy                 String?   @map("created_by")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  company        Company                   @relation("ImportRfqCompany", fields: [companyId], references: [id], onDelete: Cascade)
  supplier       Supplier?                 @relation(fields: [supplierId], references: [id])
  creator        User?                     @relation("ImportRfqCreator", fields: [createdBy], references: [id])
  port           ImportPort?               @relation(fields: [portId], references: [id], onDelete: SetNull)
  items          ImportRfqItem[]
  quotations     ImportSupplierQuotation[]
  purchaseOrders ImportPurchaseOrder[]

  @@unique([companyId, rfqNumber])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([portId])
  @@map("import_rfqs")
}

model ImportRfqItem {
  id             String   @id @default(uuid())
  rfqId          String   @map("rfq_id")
  productId      String?  @map("product_id")
  productName    String   @map("product_name")
  sku            String?
  hsCode         String?  @map("hs_code")
  quantity       Decimal  @default(1) @db.Decimal(18, 4)
  uom            String   @default("PCS")
  targetPriceUsd Decimal  @default(0) @map("target_price_usd") @db.Decimal(18, 4)
  quotedPriceUsd Decimal? @map("quoted_price_usd") @db.Decimal(18, 4)

  rfq     ImportRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product?  @relation(fields: [productId], references: [id])

  @@index([rfqId])
  @@index([productId])
  @@map("import_rfq_items")
}

/// Multi-supplier quotation against one Import RFQ (comparison / selection).
model ImportSupplierQuotation {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  rfqId              String    @map("rfq_id")
  quotationNumber    String    @map("quotation_number")
  supplierId         String?   @map("supplier_id")
