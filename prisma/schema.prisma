// ============================================================
// CREDIT NOTE MODEL
// ============================================================

model CreditNote {
  id           String   @id @default(uuid())
  creditNumber String   @map("credit_number")
  date         DateTime @default(now())

  customerId   String @map("customer_id")
  customerName String @map("customer_name")

  // Source invoice — warehouse OR sales (sales flow mirrors payments)
  originalInvoiceId     String? @map("original_invoice_id")
  salesInvoiceId        String? @map("sales_invoice_id")
  invoiceSource         String  @default("warehouse") @map("invoice_source") // warehouse | sales
  originalInvoiceNumber String  @map("original_invoice_number")
  originalInvoiceAmount Float   @map("original_invoice_amount")

  amount     Float
  reason     String
  reasonType String @map("reason_type")

  items Json @default("[]")

  status          String   @default("Issued")
  appliedAmount   Float    @default(0) @map("applied_amount")
  remainingAmount Float    @map("remaining_amount")
  expiryDate      DateTime @map("expiry_date")

  notes String @default("")

  appliedToInvoices Json @default("[]") @map("applied_to_invoices")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer        Customer          @relation(fields: [customerId], references: [id])
  originalInvoice WarehouseInvoice? @relation(fields: [originalInvoiceId], references: [id])
  salesInvoice    SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
