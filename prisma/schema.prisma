  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("hr_audit_logs")
}

model HrGoal {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  employeeId String   @map("employee_id")
  title      String
  kpi        String   @default("")
  weight     Float    @default(0)
  target     String   @default("")
  progress   Float    @default(0)
  cycle      String   @default("")
  status     String   @default("Open")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("hr_goals")
}

model HrFeedback {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  employeeId   String   @map("employee_id")
  reviewerName String   @map("reviewer_name")
  relation     String   @default("manager")
  score        Float    @default(0)
  comments     String   @default("")
  cycle        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("hr_feedbacks")
}

// ============================================================
// PDF REPORT SETTINGS (separate from profile / businessDetails)
// ============================================================

model PdfReportSetting {
  id              String  @id @default(uuid())
  /// company:{companyId} or user:{userId} — one settings row per tenant scope
  scopeKey        String  @unique @map("scope_key")
  companyId       String? @map("company_id")
  userId          String  @map("user_id")

  companyName     String  @default("") @map("company_name")
  companyAddress  String  @default("") @map("company_address")
  logo            String  @default("")
  signature       String  @default("")

  showLogo        Boolean @default(true) @map("show_logo")
  showSignature   Boolean @default(true) @map("show_signature")
  showCompanyName Boolean @default(true) @map("show_company_name")
  showAddress     Boolean @default(true) @map("show_address")
  showPageNumbers Boolean @default(true) @map("show_page_numbers")

  layout          String  @default("classic")
  logoPosition    String  @default("left") @map("logo_position")
  headerSubtitle  String  @default("") @map("header_subtitle")
  footerText      String  @default("Confidential - For Internal Use Only") @map("footer_text")
  accentColor     String  @default("#014582") @map("accent_color")
  signatureLabel  String  @default("Authorized Signature") @map("signature_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation("PdfReportSettingOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("pdf_report_settings")
}

// ============================================================
// NOTIFICATION MODEL
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      String    @default("info") // info, success, warning, error
  category  String    @default("System") // System, Finance, Alert, etc.
  isRead    Boolean   @default(false) @map("is_read")
  data      Json?     @map("data") // Additional data like screen to navigate to
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// SUPPORT TICKETS (user complaints / issues)
// ============================================================

model SupportTicket {
  id               String    @id @default(uuid())
  ticketNumber     String    @unique @map("ticket_number")
  title            String
  description      String
  category         String    @default("General") // Bug, Crash, Performance, UI Issue, Data Error, Billing, Feature Request, General, Other
  priority         String    @default("Medium") // Low, Medium, High, Critical
  status           String    @default("Open") // Open, In Progress, Resolved, Closed
  stepsToReproduce String?   @map("steps_to_reproduce")
  attachmentUrl    String?   @map("attachment_url")
  adminResponse    String?   @map("admin_response")
  module           String? // sales, purchases, accounting, warehouse, pos, other
  userId           String    @map("user_id")
  companyId        String?   @map("company_id")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user    User     @relation("SupportTicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("support_tickets")
}

// ============================================================
// ROLE & PERMISSION MODELS
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // admin, manager, staff, viewer
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  permissions RolePermission[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "dashboard.view", "products.create"
  description String?
  module      String // e.g., "dashboard", "products", "reports"
  action      String // e.g., "view", "create", "edit", "delete"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER PERMISSION MODEL (for custom page-level access)
// ============================================================

model UserPermission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  page      String // e.g., "/warehouse/dashboard", "/warehouse/products"
  canView   Boolean  @default(true) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page])
  @@index([userId])
  @@index([page])
  @@map("user_permissions")
}

// ============================================================
// FISCAL YEAR MODELS
// ============================================================

model FiscalYear {
  id         String    @id @default(uuid())
  companyId  String?   @map("company_id")
  name       String    @db.VarChar(100)
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("Open")
  closedAt   DateTime? @map("closed_at")
  closedBy   String?   @map("closed_by")
  periodType String?   @map("period_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  company            Company?               @relation("FiscalYearCompany", fields: [companyId], references: [id])
  auditLogs          FiscalYearAuditLog[]
  journalEntries     JournalEntry[]         @relation("JournalEntryFiscalYear")
  expenses           Expense[]              @relation("ExpenseFiscalYear")
  incomes            Income[]               @relation("IncomeFiscalYear")
  paymentsReceived   PaymentReceived[]      @relation("PaymentReceivedFiscalYear")
  paymentsMade       PaymentMade[]          @relation("PaymentMadeFiscalYear")
  salesInvoices      SalesInvoice[]         @relation("SalesInvoiceFiscalYear")
  purchaseInvoices   PurchaseInvoice[]      @relation("PurchaseInvoiceFiscalYear")
  creditNotes        CreditNote[]           @relation("CreditNoteFiscalYear")
  purchaseReturns    PurchaseReturn[]       @relation("PurchaseReturnFiscalYear")
  transactions       Transaction[]          @relation("TransactionFiscalYear")
  fixedAssets        FixedAsset[]           @relation("FixedAssetFiscalYear")
  loans              Loan[]                 @relation("LoanFiscalYear")
  salesPayments      SalesPaymentReceived[] @relation("SalesPaymentFiscalYear")
  purchasePayments   PurchasePaymentMake[]  @relation("PurchasePaymentFiscalYear")
  accountsReceivable AccountsReceivable[]   @relation("ARFiscalYear")
  accountsPayable    AccountsPayable[]      @relation("APFiscalYear")
  equityAccounts     EquityAccount[]        @relation("EquityAccountFiscalYear")
  posSales           POSSale[]              @relation("POSSaleFiscalYear")
  posReturns         POSReturn[]            @relation("POSReturnFiscalYear")

  @@unique([companyId, name])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_years")
}

model FiscalYearAuditLog {
  id           String   @id @default(uuid())
  fiscalYearId String   @map("fiscal_year_id")
  userId       String   @map("user_id")
  action       String
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([fiscalYearId])
  @@index([userId])
  @@map("fiscal_year_audit_logs")
}

model Subscription {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  status         String    @default("active")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  amount         Float
  currency       String    @default("PKR")
  paymentMethod  String    @map("payment_method")
  transactionId  String    @default("") @map("transaction_id")
  paymentDetails Json?     @map("payment_details")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ============================================================
// CUSTOMER MODEL
// ============================================================

model Customer {
  id             String @id @default(uuid())
  customerNumber String @unique @map("customer_number")

  name         String
  email        String?
  phone        String?
  companyName  String? @map("company_name")
  customerType String  @default("Individual") @map("customer_type")
  taxId        String? @map("tax_id")

  address         Json?
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  status String @default("Active")

  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  totalOrders        Int       @default(0) @map("total_orders")
  totalSpent         Float     @default(0) @map("total_spent")
  averageOrderValue  Float     @default(0) @map("average_order_value")
  lastOrderDate      DateTime? @map("last_order_date")
  outstandingBalance Float     @default(0) @map("outstanding_balance")
  creditLimit        Float     @default(0) @map("credit_limit")
  creditTerms        String    @default("Net 30") @map("credit_terms")

  notes String?
  tags  String[] @default([])

  preferences Json?

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator            User?                  @relation("CustomerCreator", fields: [createdBy], references: [id])
  updater            User?                  @relation("CustomerUpdater", fields: [updatedBy], references: [id])
  company            Company?               @relation("CustomerCompany", fields: [companyId], references: [id])
  orders             Order[]
  warehouseInvoices  WarehouseInvoice[]
  creditNotes        CreditNote[]
  payments           PaymentReceived[]
  incomes            Income[]
  posSales           POSSale[]              @relation("CustomerPOSSales")
  salesInvoices      SalesInvoice[]
  taxExemptions      TaxExemption[]         @relation("CustomerTaxExemptions")
  deliveries         Delivery[]
  quotations         Quotation[]
  accountsReceivable AccountsReceivable[]
  salesPayments      SalesPaymentReceived[]
  transactions       Transaction[]          @relation("CustomerTransactions")

  @@unique([email, companyId])
  @@index([customerNumber])
  @@index([email])
  @@index([phone])
  @@index([customerType])
  @@index([status])
  @@index([isActive])
  @@index([name])
  @@index([companyId])
  @@map("customers")
}

// ============================================================
// PRODUCT MODEL
// ============================================================

model Product {
  id               String   @id @default(uuid())
  productId        String?  @unique @map("product_id")
  name             String
  sku              String
  barcodeNumber    String?  @unique @map("barcode_number")
  qrCode           String?  @map("qr_code")
  barcodeImage     String?  @map("barcode_image")
  description      String?
  shortDescription String?  @map("short_description")
  tags             String[] @default([])

  categoryId      String? @map("category_id")
  categoryName    String? @map("category_name")
  subCategoryId   String? @map("sub_category_id")
  subCategoryName String? @map("sub_category_name")
  brandId         String? @map("brand_id")
  brandName       String? @map("brand_name")
  modelNumber     String? @map("model_number")
  productType     String  @default("Physical") @map("product_type")
  hsCode          String? @map("hs_code")

  supplierId   String? @map("supplier_id")
  supplierName String? @map("supplier_name")
  supplierSku  String? @map("supplier_sku")
  leadTimeDays Int     @default(0) @map("lead_time_days")
  minOrderQty  Int     @default(1) @map("min_order_qty")
  maxOrderQty  Int     @default(999) @map("max_order_qty")
  reorderPoint Int     @default(10) @map("reorder_point")
  reorderQty   Int     @default(50) @map("reorder_qty")

  costPrice         Float     @map("cost_price")
  sellingPrice      Float     @map("selling_price")
  landingCost       Float     @default(0) @map("landing_cost")
  margin            Float     @default(0)
  marginPercentage  Float     @default(0) @map("margin_percentage")
  specialPrice      Float     @default(0) @map("special_price")
  specialPriceStart DateTime? @map("special_price_start")
  specialPriceEnd   DateTime? @map("special_price_end")
  taxRate           Float     @default(0) @map("tax_rate")
  taxType           String    @default("Exclusive") @map("tax_type")
  currencyCode      String    @default("PKR") @map("currency_code")
  totalValue        Float     @default(0) @map("total_value")
  retailPrice       Float     @default(0) @map("retail_price")
  wholesalePrice    Float     @default(0) @map("wholesale_price")

  currentStock     Float    @default(0) @map("current_stock")
  minimumStock     Float    @default(5) @map("minimum_stock")
  maximumStock     Float    @default(100) @map("maximum_stock")
  openingStock     Float    @default(0) @map("opening_stock")
  reservedStock    Float    @default(0) @map("reserved_stock")
  availableStock   Float    @default(0) @map("available_stock")
  reorderLevel     Int    @default(0) @map("reorder_level")
  safetyStock      Int    @default(0) @map("safety_stock")
  stockUnitName    String @default("Pcs") @map("stock_unit_name")
  conversionFactor Float  @default(1) @map("conversion_factor")

  isBoxBased  Boolean @default(false) @map("is_box_based")
  boxQuantity Int     @default(0) @map("box_quantity")
  boxUnitName String  @default("Box") @map("box_unit_name")

  rackLocationId       String? @map("rack_location_id")
  rackLocationName     String  @default("A-1-B1") @map("rack_location_name")
  zoneId               String? @map("zone_id")
  zoneName             String? @map("zone_name")
  palletNumber         String? @map("pallet_number")
  shelfNumber          String? @map("shelf_number")
  storageConditionName String  @default("Normal") @map("storage_condition_name")
  temperatureMin       Float?  @map("temperature_min")
  temperatureMax       Float?  @map("temperature_max")
  humidityMin          Float?  @map("humidity_min")
  humidityMax          Float?  @map("humidity_max")

  weight         Float    @default(0)
  weightUnitName String   @default("KG") @map("weight_unit_name")
  length         Float    @default(0)
  width          Float    @default(0)
  height         Float    @default(0)
  dimensionUnit  String   @default("cm") @map("dimension_unit")
  volume         Float    @default(0)
  color          String?
  colors         String[] @default([])
  size           String?
  sizes          String[] @default([])
  material       String?
  finish         String?

  hasExpiry         Boolean   @default(false) @map("has_expiry")
  isBatchManaged    Boolean   @default(false) @map("is_batch_managed")
  isSerialManaged   Boolean   @default(false) @map("is_serial_managed")
  isExpiryManaged   Boolean   @default(false) @map("is_expiry_managed")
  expiryDate        DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")
  batchNumber       String?   @map("batch_number")
  shelfLifeDays     Int       @default(0) @map("shelf_life_days")
  serialTracking    Boolean   @default(false) @map("serial_tracking")

  countryOfOriginName  String? @map("country_of_origin_name")
  shippingClass        String  @default("Normal") @map("shipping_class")
  handlingInstructions String? @map("handling_instructions")
  stackingLimit        Int     @default(0) @map("stacking_limit")
  freightClass         String? @map("freight_class")
  dangerousGoods       Boolean @default(false) @map("dangerous_goods")
  unNumber             String? @map("un_number")

  warrantyPeriod    Int     @default(0) @map("warranty_period")
  warrantyUnit      String  @default("Months") @map("warranty_unit")
  isReturnable      Boolean @default(true) @map("is_returnable")
  returnDays        Int     @default(7) @map("return_days")
  returnPolicy      String? @map("return_policy")
  replacementPolicy String? @map("replacement_policy")

  mainImage    String?  @map("main_image")
  images       String[] @default([])
  videoUrl     String?  @map("video_url")
  specSheet    String?  @map("spec_sheet")
  userManual   String?  @map("user_manual")
  certificates String[] @default([])

  isVariant         Boolean @default(false) @map("is_variant")
  parentProductId   String? @map("parent_product_id")
  variantType       String? @map("variant_type")
  variantAttributes Json?   @map("variant_attributes")

  isBulkManaged           Boolean @default(false) @map("is_bulk_managed")
  hasIndividualTracking   Boolean @default(false) @map("has_individual_tracking")
  defaultQuantityPerBatch Int     @default(0) @map("default_quantity_per_batch")
  bulkUnit                String  @default("Bale") @map("bulk_unit")

  status     String  @default("Active")
  visibility Boolean @default(true)
  featured   Boolean @default(false)
  newArrival Boolean @default(false) @map("new_arrival")
  bestSeller Boolean @default(false) @map("best_seller")
  onSale     Boolean @default(false) @map("on_sale")
  isActive   Boolean @default(true) @map("is_active")

  createdBy       String    @map("created_by")
  updatedBy       String?   @map("updated_by")
  lastCountedDate DateTime? @map("last_counted_date")
  lastCountedBy   String?   @map("last_counted_by")
  notes           String?

  attributes   Json?
  customFields Json? @map("custom_fields")

  companyId String? @map("company_id")

  // Bidirectional sync (local -> cloud -> local) support
  syncId        String?   @unique @map("sync_id")
  syncStatus    String    @default("SYNCED") @map("sync_status") // PENDING | SYNCED | FAILED
  lastSyncedAt  DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category        Category?               @relation(fields: [categoryId], references: [id])
  supplier             Supplier?               @relation(fields: [supplierId], references: [id])
  creator              User?                   @relation("ProductCreator", fields: [createdBy], references: [id])
  updater              User?                   @relation("ProductUpdater", fields: [updatedBy], references: [id])
  parentProduct        Product?                @relation("ProductVariants", fields: [parentProductId], references: [id])
  variants             Product[]               @relation("ProductVariants")
  stockMovements       StockMovement[]
  orderItems           OrderItem[]
  returnItems          ReturnItem[]
  purchaseItems        WarehousePurchaseItem[]
  invoiceItems         WarehouseInvoiceItem[]
  company              Company?                @relation("ProductCompany", fields: [companyId], references: [id])
  deliveryItems        DeliveryItem[]
  quotationItems       QuotationItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  purchaseOrderItems        PurchaseOrderItem[]
  purchaseRequisitionItems  PurchaseRequisitionItem[]
  goodsReceivingItems       GoodsReceivingItem[]
  purchaseInvoiceItems      PurchaseInvoiceItem[]
  purchaseReturnItems       PurchaseReturnItem[]
  posSaleItems              POSSaleItem[]
  posReturnItems            POSReturnItem[]
  taxExemptions             TaxExemption[]          @relation("ProductTaxExemptions")
  productStocks             ProductStock[]
  manufacturingBOMs        ManufacturingBOM[]       @relation("ManufacturingBOMProduct")
  manufacturingBOMComponents ManufacturingBOMComponent[] @relation("ManufacturingBOMComponentProduct")
  manufacturingRoutings    ManufacturingRouting[]   @relation("ManufacturingRoutingProduct")
  manufacturingProductionOrders ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderProduct")
  manufacturingWIPs       ManufacturingWIP[]       @relation("ManufacturingWIPProduct")
  manufacturingScraps     ManufacturingScrap[]     @relation("ManufacturingScrapProduct")
  manufacturingScrapsMaterial ManufacturingScrap[] @relation("ManufacturingScrapMaterial")
  manufacturingByProducts ManufacturingByProduct[] @relation("ManufacturingByProductProduct")
  manufacturingReworks    ManufacturingRework[]    @relation("ManufacturingReworkProduct")
  manufacturingQualityInspections ManufacturingQualityInspection[] @relation("ManufacturingQualityInspectionProduct")
  manufacturingSubcontractOrders ManufacturingSubcontractOrder[] @relation("ManufacturingSubcontractOrderProduct")
  manufacturingMRPItems      ManufacturingMRPItem[]   @relation("ManufacturingMRPItemMaterial")
  manufacturingMaterialReservations ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationComponent")
  manufacturingMaterialIssues ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueComponent")
  manufacturingMaterialConsumptions ManufacturingMaterialConsumption[] @relation("ManufacturingMaterialConsumptionComponent")
  manufacturingSubcontractMaterialSents ManufacturingSubcontractMaterialSent[] @relation("ManufacturingSubcontractMaterialSentMaterial")
  manufacturingSubcontractMaterialReceiveds ManufacturingSubcontractMaterialReceived[] @relation("ManufacturingSubcontractMaterialReceivedMaterial")
  manufacturingProductCosts ManufacturingProductCost[] @relation("ManufacturingProductCostProduct")
  manufacturingDemands     ManufacturingDemand[]   @relation("ManufacturingDemandProduct")
  manufacturingMPSs         ManufacturingMPS[]   @relation("ManufacturingMPSProduct")

  @@unique([sku, companyId])
  @@index([sku])
  @@index([productId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([currentStock])
  @@index([isActive])
  @@index([status])
  @@index([barcodeNumber])
  @@index([qrCode])
  @@index([companyId])
  @@index([companyId, updatedAt, id])
  internalTransferItems InternalTransferItem[] @relation("InternalTransferItemProduct")

  @@map("products")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String?
  code        String?
  description String?

  parentId   String? @map("parent_id")
  parentName String? @map("parent_name")
  level      Int     @default(1)
  path       String? @default("")

  subCategoryCount Int @default(0) @map("sub_category_count")

  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")

  companyId String? @map("company_id")

  // Bidirectional sync (local -> cloud -> local) support
  syncId       String?  @unique @map("sync_id")
  syncStatus   String   @default("SYNCED") @map("sync_status") // PENDING | SYNCED | FAILED
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  creator  User?      @relation("CategoryCreator", fields: [createdBy], references: [id])
  updater  User?      @relation("CategoryUpdater", fields: [updatedBy], references: [id])
  products Product[]
  company  Company?   @relation("CategoryCompany", fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@unique([code, companyId])
  @@unique([slug, companyId])
  @@index([parentId])
  @@index([level])
  @@index([slug])
  @@index([code])
  @@index([isActive])
  @@index([companyId])
  @@index([companyId, updatedAt, id])
  @@map("categories")
}

// ============================================================
// POS MASTER DATA SYNC CHANGELOG
