// prisma/schema.prisma - COMPLETE FINAL VERSION

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// COMPANY MODEL (Multi-tenant)
// ============================================================

model Company {
  id                    String    @id @default(uuid())
  name                  String
  email                 String?   @unique
  phone                 String?
  address               String?
  businessType          String?   @map("business_type")
  taxRegistrationNumber String?   @map("tax_registration_number")
  logo                  String?
  website               String?
  isActive              Boolean   @default(true) @map("is_active")
  subscriptionPlan      String    @default("trial") @map("subscription_plan")
  subscriptionStatus    String    @default("active") @map("subscription_status")
  productTier           String    @default("erp_pos") @map("product_tier") // pos | erp_pos
  licensedUsers         Int       @default(1) @map("licensed_users")
  licensedBranches      Int       @default(1) @map("licensed_branches")
  billingCycle          String?   @map("billing_cycle") // monthly | yearly
  trialStartDate        DateTime? @map("trial_start_date")
  trialEndDate          DateTime? @map("trial_end_date")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  posMode               String    @default("retail") @map("pos_mode") // retail | restaurant
  posModeConfigured     Boolean   @default(false) @map("pos_mode_configured")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users              User[]
  memberships        CompanyMembership[]
  categories         Category[]             @relation("CategoryCompany")
  suppliers          Supplier[]             @relation("SupplierCompany")
  settings           Setting[]              @relation("SettingCompany")
  stockMovements     StockMovement[]        @relation("StockMovementCompany")
  orders             Order[]                @relation("OrderCompany")
  returns            Return[]               @relation("ReturnCompany")
  refunds            Refund[]               @relation("RefundCompany")
  warehousePurchases WarehousePurchase[]    @relation("WarehousePurchaseCompany")
  warehouseInvoices  WarehouseInvoice[]     @relation("WarehouseInvoiceCompany")
  chartOfAccounts    ChartOfAccount[]       @relation("ChartOfAccountCompany")
  customers          Customer[]             @relation("CustomerCompany")
  products           Product[]              @relation("ProductCompany")
  fiscalYears        FiscalYear[]           @relation("FiscalYearCompany")
  bankAccounts       BankAccount[]          @relation("BankAccountCompany")
  journalEntries     JournalEntry[]         @relation("JournalEntryCompany")
  bills              Bill[]                 @relation("BillCompany")
  incomes            Income[]               @relation("IncomeCompany")
  expenses           Expense[]              @relation("ExpenseCompany")
  trialBalanceViews  TrialBalanceView[]     @relation("TrialBalanceViewCompany")
  paymentsMade       PaymentMade[]          @relation("PaymentMadeCompany")
  purchasePayments   PurchasePaymentMake[]  @relation("PurchasePaymentMakeCompany")
  purchaseReturns    PurchaseReturn[]       @relation("PurchaseReturnCompany")
  creditNotes        CreditNote[]           @relation("CreditNoteCompany")
  fixedAssets        FixedAsset[]           @relation("FixedAssetCompany")
  loans              Loan[]                 @relation("LoanCompany")
  equityAccounts     EquityAccount[]        @relation("EquityAccountCompany")
  equityTransactions EquityTransaction[]    @relation("EquityTransactionCompany")
  deliveries         Delivery[]             @relation("DeliveryCompany")
  quotations         Quotation[]            @relation("QuotationCompany")
  purchaseOrders     PurchaseOrder[]        @relation("PurchaseOrderCompany")
  purchaseRequisitions PurchaseRequisition[] @relation("PurchaseRequisitionCompany")
  taxJurisdictions   TaxJurisdiction[]      @relation("TaxJurisdictionCompany")
  taxTypes           TaxType[]              @relation("TaxTypeCompany")
  taxRates           TaxRate[]              @relation("TaxRateCompany")
  taxRules           TaxRule[]              @relation("TaxRuleCompany")
  taxExemptionTypes  TaxExemptionType[]     @relation("TaxExemptionTypeCompany")
  taxExemptions      TaxExemption[]         @relation("TaxExemptionCompany")
  taxTransactions    TaxTransaction[]       @relation("TaxTransactionCompany")
  taxProfile         CompanyTaxProfile?
  goodsReceivings    GoodsReceiving[]       @relation("GoodsReceivingCompany")
  purchaseInvoices   PurchaseInvoice[]      @relation("PurchaseInvoiceCompany")
  salesInvoices      SalesInvoice[]         @relation("SalesInvoiceCompany")
  salesPayments      SalesPaymentReceived[] @relation("SalesPaymentCompany")
  paymentsReceived   PaymentReceived[]      @relation("PaymentReceivedCompany")
  transactions       Transaction[]          @relation("TransactionCompany")
  posTerminals       POSTerminal[]
  posShifts          POSShift[]
  posSales           POSSale[]
  posReturns         POSReturn[]
  restaurantOrders   RestaurantOrder[]
  kitchenStations    KitchenStation[]
  posAuditLogs       POSAuditLog[]
  pdfReportSettings  PdfReportSetting[]
  supportTickets     SupportTicket[]
  locations          Location[]
  productStocks      ProductStock[]
  hrOffices          HrOffice[]
  hrEmployees        HrEmployee[]
  hrAttendances      HrAttendance[]
  hrEmployeeLocations HrEmployeeLocation[]
  hrLeaves           HrLeave[]
  hrOvertimes        HrOvertime[]
  hrTasks            HrTask[]
  hrPerformanceReviews HrPerformanceReview[]
  hrPayPeriods       HrPayPeriod[]
  hrPayrollRuns      HrPayrollRun[]
  hrPayrollItems     HrPayrollItem[]
  hrSetting          HrSetting?
  hrDepartments      HrDepartment[]
  costCenters        CostCenter[]
  hrDesignations     HrDesignation[]
  hrShifts           HrShift[]
  hrHolidays         HrHoliday[]
  hrLeaveTypes       HrLeaveType[]
  hrLeaveBalances    HrLeaveBalance[]
  hrRosters          HrRoster[]
  hrAttendanceCorrections HrAttendanceCorrection[]
  hrLoans            HrLoan[]
  hrBonuses          HrBonus[]
  hrDocuments        HrDocument[]
  hrLifecycleEvents  HrLifecycleEvent[]
  hrApprovals        HrApproval[]
  hrAuditLogs        HrAuditLog[]
  hrGoals            HrGoal[]
  hrFeedbacks        HrFeedback[]
  hrShiftSwaps       HrShiftSwap[]
  hrPrintSetting     HrPrintSetting?
  hrSignatories      HrSignatory[]
  hrDocumentTemplates HrDocumentTemplate[]
  hrGeneratedDocuments HrGeneratedDocument[]
  internalTransfers    InternalTransfer[]   @relation("InternalTransferCompany")
  manufacturingBOMs  ManufacturingBOM[]            @relation("ManufacturingBOMCompany")
  manufacturingRoutings ManufacturingRouting[]        @relation("ManufacturingRoutingCompany")
  manufacturingWorkCenters ManufacturingWorkCenter[] @relation("ManufacturingWorkCenterCompany")
  manufacturingMachines ManufacturingMachine[]       @relation("ManufacturingMachineCompany")
  manufacturingProductionOrders ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderCompany")
  manufacturingWorkOrders ManufacturingWorkOrder[]   @relation("ManufacturingWorkOrderCompany")
  manufacturingMaterialReservations ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationCompany")
  manufacturingMaterialIssues ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueCompany")
  manufacturingMaterialConsumptions ManufacturingMaterialConsumption[] @relation("ManufacturingMaterialConsumptionCompany")
  manufacturingWIPs ManufacturingWIP[]             @relation("ManufacturingWIPCompany")
  manufacturingScraps ManufacturingScrap[]         @relation("ManufacturingScrapCompany")
  manufacturingByProducts ManufacturingByProduct[]   @relation("ManufacturingByProductCompany")
  manufacturingReworks ManufacturingRework[]       @relation("ManufacturingReworkCompany")
  manufacturingQualityInspections ManufacturingQualityInspection[] @relation("ManufacturingQualityInspectionCompany")
  manufacturingMaintenanceRequests ManufacturingMaintenanceRequest[] @relation("ManufacturingMaintenanceRequestCompany")
  manufacturingMaintenanceOrders ManufacturingMaintenanceOrder[] @relation("ManufacturingMaintenanceOrderCompany")
  manufacturingSubcontractVendors ManufacturingSubcontractVendor[] @relation("ManufacturingSubcontractVendorCompany")
  manufacturingSubcontractOrders ManufacturingSubcontractOrder[] @relation("ManufacturingSubcontractOrderCompany")
  manufacturingMRPs ManufacturingMRP[]             @relation("ManufacturingMRPCompany")
  manufacturingMPS ManufacturingMPS[]             @relation("ManufacturingMPSCompany")
  manufacturingDemands ManufacturingDemand[]       @relation("ManufacturingDemandCompany")
  manufacturingProductCosts ManufacturingProductCost[] @relation("ManufacturingProductCostCompany")
  manufacturingSetting ManufacturingSetting?      @relation("ManufacturingSettingCompany")

  @@index([email])
  @@index([isActive])
  @@map("companies")
}

// ============================================================
// MULTI-LOCATION (Shop / Warehouse)
// ============================================================

model Location {
  id          String  @id @default(uuid())
  companyId   String  @map("company_id")
  name        String
  code        String
  type        String  @default("Shop") // Warehouse | Shop | POS_Store
  address     String?
  phone       String?
  isDefault   Boolean @default(false) @map("is_default")
  isActive    Boolean @default(true) @map("is_active")
  isDeleted   Boolean @default(false) @map("is_deleted")
  notes       String?
  createdBy   String? @map("created_by")
  updatedBy   String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productStocks    ProductStock[]
  stockMovements   StockMovement[]
  orders           Order[]
  deliveries       Delivery[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceivings      GoodsReceiving[]
  posTerminals         POSTerminal[]
  salesInvoices        SalesInvoice[]
  purchaseInvoices     PurchaseInvoice[]
  quotations           Quotation[]
  userLocations        UserLocation[]
  expenses             Expense[]
  incomes              Income[]
  journalEntries       JournalEntry[]
  manufacturingBOMs    ManufacturingBOM[]       @relation("ManufacturingBOMLocation")
  manufacturingWorkCenters ManufacturingWorkCenter[] @relation("ManufacturingWorkCenterLocation")
  manufacturingMachines ManufacturingMachine[]  @relation("ManufacturingMachineLocation")
  manufacturingProductionOrders ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderLocation")
  manufacturingProductionOrdersSource ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderSourceWarehouse")
  manufacturingProductionOrdersWIP ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderWIPWarehouse")
  manufacturingProductionOrdersFG ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderFinishedGoodsWarehouse")
  manufacturingMaterialReservations ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationLocation")
  manufacturingMaterialIssues ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueFromLocation")
  manufacturingMaterialIssuesTo ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueToLocation")
  manufacturingWIPs    ManufacturingWIP[]       @relation("ManufacturingWIPLocation")
  manufacturingByProducts ManufacturingByProduct[] @relation("ManufacturingByProductLocation")
  manufacturingMPS     ManufacturingMPS[]       @relation("ManufacturingMPSLocation")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@index([isDefault])
  internalTransfersFrom InternalTransfer[] @relation("InternalTransferFrom")
  internalTransfersTo   InternalTransfer[] @relation("InternalTransferTo")

  @@map("locations")
}

model UserLocation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_locations")
}

model ProductStock {
  id             String @id @default(uuid())
  companyId      String @map("company_id")
  productId      String @map("product_id")
  locationId     String @map("location_id")
  currentStock   Int    @default(0) @map("current_stock")
  reservedStock  Int    @default(0) @map("reserved_stock")
  availableStock Int    @default(0) @map("available_stock")
  minimumStock   Int    @default(0) @map("minimum_stock")
  reorderLevel   Int    @default(0) @map("reorder_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([companyId])
  @@index([productId])
  @@index([locationId])
  @@map("product_stocks")
}

// ============================================================
// USER & AUTH MODELS
// ============================================================

model User {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String  @unique
  password  String
  phone     String  @default("")
  country   String  @default("Pakistan")
  role      String  @default("user")
  roleId    String? @map("role_id")
  managerId String? @map("manager_id")
  createdBy String? @map("created_by")
  companyId String? @map("company_id")
  isActive  Boolean @default(true) @map("is_active")
  assignedTerminalId String? @map("assigned_terminal_id")

  resetOtp       String?   @map("reset_otp")
  resetOtpExpiry DateTime? @map("reset_otp_expiry")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockUntil           DateTime? @map("lock_until")
  requiresLoginOtp    Boolean   @default(false) @map("requires_login_otp")
  loginOtp            String?   @map("login_otp")
  loginOtpExpiry      DateTime? @map("login_otp_expiry")

  organizationName String @default("") @map("organization_name")
  address          String @default("")
  contactNo        String @default("") @map("contact_no")
  websiteLink      String @default("") @map("website_link")
  businessDetails  Json?  @default("{}") @map("business_details")

  subscriptionPlan      String    @default("none") @map("subscription_plan")
  subscriptionStatus    String    @default("active") @map("subscription_status")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  trialStartDate        DateTime? @map("trial_start_date")
  trialEndDate          DateTime? @map("trial_end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptions             Subscription[]
  createdProducts           Product[]           @relation("ProductCreator")
  updatedProducts           Product[]           @relation("ProductUpdater")
  createdCategories         Category[]          @relation("CategoryCreator")
  updatedCategories         Category[]          @relation("CategoryUpdater")
  createdSuppliers          Supplier[]          @relation("SupplierCreator")
  createdSettings           Setting[]           @relation("SettingCreator")
  updatedSettings           Setting[]           @relation("SettingUpdater")
  stockMovements            StockMovement[]     @relation("StockMovementCreator")
  orderCreators             Order[]             @relation("OrderCreator")
  orderUpdaters             Order[]             @relation("OrderUpdater")
  orderPickers              Order[]             @relation("OrderPicker")
  orderPackers              Order[]             @relation("OrderPacker")
  orderShippers             Order[]             @relation("OrderShipper")
  returnCreators            Return[]            @relation("ReturnCreator")
  returnUpdaters            Return[]            @relation("ReturnUpdater")
  returnApprovers           Return[]            @relation("ReturnApprover")
  returnCustomers           Return[]            @relation("ReturnCustomer")
  customerCreators          Customer[]          @relation("CustomerCreator")
  customerUpdaters          Customer[]          @relation("CustomerUpdater")
  refundCreators            Refund[]            @relation("RefundCreator")
  refundUpdaters            Refund[]            @relation("RefundUpdater")
  refundProcessors          Refund[]            @relation("RefundProcessor")
  refundCustomers           Refund[]            @relation("RefundCustomer")
  warehouseInvoiceCreators  WarehouseInvoice[]  @relation("WarehouseInvoiceCreator")
  warehouseInvoiceUpdaters  WarehouseInvoice[]  @relation("WarehouseInvoiceUpdater")
  warehousePurchaseCreators WarehousePurchase[] @relation("WarehousePurchaseCreator")
  warehousePurchaseUpdaters WarehousePurchase[] @relation("WarehousePurchaseUpdater")

  chartOfAccountCreators  ChartOfAccount[]  @relation("ChartOfAccountCreator")
  bankAccountCreators     BankAccount[]     @relation("BankAccountCreator")
  journalEntryCreators    JournalEntry[]    @relation("JournalEntryCreator")
  journalEntryPosters     JournalEntry[]    @relation("JournalEntryPoster")
  billCreators            Bill[]            @relation("BillCreator")
  incomeCreators          Income[]          @relation("IncomeCreator")
  incomePosters           Income[]          @relation("IncomePoster")
  expenseCreators         Expense[]         @relation("ExpenseCreator")
  expensePosters          Expense[]         @relation("ExpensePoster")
  creditNoteCreators      CreditNote[]      @relation("CreditNoteCreator")
  paymentReceivedCreators PaymentReceived[] @relation("PaymentReceivedCreator")
  paymentMadeCreators     PaymentMade[]     @relation("PaymentMadeCreator")
  fixedAssetCreators      FixedAsset[]      @relation("FixedAssetCreator")
  loanCreators            Loan[]            @relation("LoanCreator")
  equityAccountCreators   EquityAccount[]   @relation("EquityAccountCreator")

  deliveryCreators            Delivery[]             @relation("DeliveryCreator")
  deliveryUpdaters            Delivery[]             @relation("DeliveryUpdater")
  deliveryConfirmers          Delivery[]             @relation("DeliveryConfirmer")
  quotationCreators           Quotation[]            @relation("QuotationCreator")
  quotationUpdaters           Quotation[]            @relation("QuotationUpdater")
  salesInvoiceCreators        SalesInvoice[]         @relation("SalesInvoiceCreator")
  salesInvoiceUpdaters        SalesInvoice[]         @relation("SalesInvoiceUpdater")
  salesPaymentCreators        SalesPaymentReceived[] @relation("SalesPaymentCreator")
  salesPaymentUpdaters        SalesPaymentReceived[] @relation("SalesPaymentUpdater")
  purchaseOrderCreators       PurchaseOrder[]        @relation("PurchaseOrderCreator")
  purchaseOrderUpdaters       PurchaseOrder[]        @relation("PurchaseOrderUpdater")
  purchaseRequisitionCreators PurchaseRequisition[]  @relation("PurchaseRequisitionCreator")
  purchaseRequisitionUpdaters PurchaseRequisition[]  @relation("PurchaseRequisitionUpdater")
  purchaseRequisitionApprovers PurchaseRequisition[] @relation("PurchaseRequisitionApprover")
  goodsReceivingCreators      GoodsReceiving[]       @relation("GoodsReceivingCreator")
  goodsReceivingUpdaters      GoodsReceiving[]       @relation("GoodsReceivingUpdater")
  goodsReceivingConfirmers    GoodsReceiving[]       @relation("GoodsReceivingConfirmer")
  purchaseInvoiceCreators     PurchaseInvoice[]      @relation("PurchaseInvoiceCreator")
  purchaseInvoiceUpdaters     PurchaseInvoice[]      @relation("PurchaseInvoiceUpdater")
  purchasePaymentMakeCreators PurchasePaymentMake[]  @relation("PurchasePaymentMakeCreator")
  purchasePaymentMakeUpdaters PurchasePaymentMake[]  @relation("PurchasePaymentMakeUpdater")
  purchaseReturnCreators      PurchaseReturn[]       @relation("PurchaseReturnCreator")
  purchaseReturnUpdaters      PurchaseReturn[]       @relation("PurchaseReturnUpdater")
  purchaseReturnProcessors    PurchaseReturn[]       @relation("PurchaseReturnProcessor")
  purchaseReturnCancellers    PurchaseReturn[]       @relation("PurchaseReturnCanceller")
  transactionCreators         Transaction[]          @relation("TransactionCreator")
  transactionPosters          Transaction[]          @relation("TransactionPoster")

  fiscalYearAuditLogs FiscalYearAuditLog[]
  notifications       Notification[]
  supportTickets      SupportTicket[]      @relation("SupportTicketCreator")
  managedUsers        User[]               @relation("ManagedUsers")
  manager             User?                @relation("ManagedUsers", fields: [managerId], references: [id])
  createdUsers        User[]               @relation("CreatedUsers")
  creator             User?                @relation("CreatedUsers", fields: [createdBy], references: [id])
  userRole            Role?                @relation(fields: [roleId], references: [id])
  permissions         UserPermission[]
  userLocations        UserLocation[]
  company             Company?             @relation(fields: [companyId], references: [id])
  memberships         CompanyMembership[]
  assignedTerminal    POSTerminal?         @relation("UserAssignedTerminal", fields: [assignedTerminalId], references: [id], onDelete: SetNull)
  createdTerminals    POSTerminal[]        @relation("TerminalCreator")
  shifts              POSShift[]           @relation("CashierShift")
  createdSales        POSSale[]            @relation("SaleCreator")
  restaurantOrders    RestaurantOrder[]    @relation("RestaurantOrderWaiter")
  createdReturns      POSReturn[]          @relation("ReturnCreator")
  createdAuditLogs    POSAuditLog[]        @relation("AuditCreator")
  approvedExemptions  TaxExemption[]       @relation("ExemptionApprover")
  pdfReportSettings   PdfReportSetting[]   @relation("PdfReportSettingOwner")
  hrEmployee          HrEmployee?
  hrPayrollRunsInitiated HrPayrollRun[] @relation("HrPayrollRunInitiator")
  manufacturingBOMsCreated ManufacturingBOM[] @relation("ManufacturingBOMCreator")
  manufacturingBOMsUpdated ManufacturingBOM[] @relation("ManufacturingBOMUpdater")
  manufacturingRoutingsCreated ManufacturingRouting[] @relation("ManufacturingRoutingCreator")
  manufacturingRoutingsUpdated ManufacturingRouting[] @relation("ManufacturingRoutingUpdater")
  manufacturingWorkCentersCreated ManufacturingWorkCenter[] @relation("ManufacturingWorkCenterCreator")
  manufacturingWorkCentersUpdated ManufacturingWorkCenter[] @relation("ManufacturingWorkCenterUpdater")
  manufacturingMachinesCreated ManufacturingMachine[] @relation("ManufacturingMachineCreator")
  manufacturingMachinesUpdated ManufacturingMachine[] @relation("ManufacturingMachineUpdater")
  manufacturingProductionOrdersCreated ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderCreator")
  manufacturingProductionOrdersUpdated ManufacturingProductionOrder[] @relation("ManufacturingProductionOrderUpdater")
  manufacturingWorkOrdersCreated ManufacturingWorkOrder[] @relation("ManufacturingWorkOrderCreator")
  manufacturingWorkOrdersUpdated ManufacturingWorkOrder[] @relation("ManufacturingWorkOrderUpdater")
  manufacturingMaterialReservationsCreated ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationCreator")
  manufacturingMaterialReservationsUpdated ManufacturingMaterialReservation[] @relation("ManufacturingMaterialReservationUpdater")
  manufacturingMaterialIssuesCreated ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueCreator")
  manufacturingMaterialIssuesUpdated ManufacturingMaterialIssue[] @relation("ManufacturingMaterialIssueUpdater")
  manufacturingMaterialConsumptionsCreated ManufacturingMaterialConsumption[] @relation("ManufacturingMaterialConsumptionCreator")
  manufacturingWIPsCreated ManufacturingWIP[] @relation("ManufacturingWIPCreator")
  manufacturingWIPsUpdated ManufacturingWIP[] @relation("ManufacturingWIPUpdater")
  manufacturingScrapsCreated ManufacturingScrap[] @relation("ManufacturingScrapCreator")
  manufacturingByProductsCreated ManufacturingByProduct[] @relation("ManufacturingByProductCreator")
  manufacturingReworksCreated ManufacturingRework[] @relation("ManufacturingReworkCreator")
  manufacturingReworksUpdated ManufacturingRework[] @relation("ManufacturingReworkUpdater")
  manufacturingQualityInspectionsCreated ManufacturingQualityInspection[] @relation("ManufacturingQualityInspectionCreator")
  manufacturingMaintenanceRequestsCreated ManufacturingMaintenanceRequest[] @relation("ManufacturingMaintenanceRequestCreator")
  manufacturingMaintenanceRequestsUpdated ManufacturingMaintenanceRequest[] @relation("ManufacturingMaintenanceRequestUpdater")
  manufacturingMaintenanceRequestsRequested ManufacturingMaintenanceRequest[] @relation("ManufacturingMaintenanceRequestRequester")
  manufacturingMaintenanceOrdersCreated ManufacturingMaintenanceOrder[] @relation("ManufacturingMaintenanceOrderCreator")
  manufacturingMaintenanceOrdersUpdated ManufacturingMaintenanceOrder[] @relation("ManufacturingMaintenanceOrderUpdater")
  manufacturingSubcontractVendorsCreated ManufacturingSubcontractVendor[] @relation("ManufacturingSubcontractVendorCreator")
  manufacturingSubcontractVendorsUpdated ManufacturingSubcontractVendor[] @relation("ManufacturingSubcontractVendorUpdater")
  manufacturingSubcontractOrdersCreated ManufacturingSubcontractOrder[] @relation("ManufacturingSubcontractOrderCreator")
  manufacturingSubcontractOrdersUpdated ManufacturingSubcontractOrder[] @relation("ManufacturingSubcontractOrderUpdater")
  manufacturingMRPsCreated ManufacturingMRP[] @relation("ManufacturingMRPCreator")
  manufacturingMPSCreated ManufacturingMPS[] @relation("ManufacturingMPSCreator")
  manufacturingMPSUpdated ManufacturingMPS[] @relation("ManufacturingMPSUpdater")
  manufacturingDemandsCreated ManufacturingDemand[] @relation("ManufacturingDemandCreator")
  manufacturingDemandsUpdated ManufacturingDemand[] @relation("ManufacturingDemandUpdater")
  manufacturingProductCostsCreated ManufacturingProductCost[] @relation("ManufacturingProductCostCreator")
  manufacturingProductCostsUpdated ManufacturingProductCost[] @relation("ManufacturingProductCostUpdater")

  @@index([email])
  @@index([roleId])
  @@index([managerId])
  @@index([createdBy])
  @@index([companyId])
  @@index([assignedTerminalId])
  internalTransfersCreated InternalTransfer[] @relation("InternalTransferCreator")

  @@map("users")
}

// ============================================================
// MULTI-COMPANY MEMBERSHIP (one user → many companies)
// ============================================================

model CompanyMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  role      String   @default("admin") // admin | user | employee (company-scoped)
  isOwner   Boolean  @default(false) @map("is_owner")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([isActive])
  @@map("company_memberships")
}

// ============================================================
// HR — employees, offices, attendance, last-known location
// ============================================================

model CostCenter {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  code        String
  name        String
  description String   @default("")
  officeId    String?  @map("office_id")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  office       HrOffice?       @relation(fields: [officeId], references: [id], onDelete: SetNull)
  departments  HrDepartment[]
  employees    HrEmployee[]
  payrollItems HrPayrollItem[]
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("cost_centers")
}

model HrOffice {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  address      String   @default("")
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150) @map("radius_meters")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   HrEmployee[]
