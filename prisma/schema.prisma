  @@index([status])
  @@index([createdBy])
  @@index([paymentMethod])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([currencyId])
  @@index([baseCurrencyId])
  @@map("purchase_payments_make")
}

// ============================================================
// PURCHASE RETURN MODELS
// ============================================================

model PurchaseReturnItem {
  id          String @id @default(uuid())
  returnId    String @map("return_id")
  productId   String @map("product_id")
  productName String @map("product_name")
  sku         String

  goodsReceivingId     String? @map("goods_receiving_id")
  goodsReceivingItemId String? @map("goods_receiving_item_id")

  purchaseInvoiceId     String? @map("purchase_invoice_id")
  purchaseInvoiceItemId String? @map("purchase_invoice_item_id")

  receivedQuantity   Float? @default(0) @map("received_quantity")
  purchasedQuantity  Int    @default(0) @map("purchased_quantity")
  previouslyReturned Int    @default(0) @map("previously_returned")
  availableQuantity  Int    @map("available_quantity")
  returnQuantity     Int    @map("return_quantity")

  isBoxBased     Boolean @default(false) @map("is_box_based")
  boxes          Int?    @map("boxes")
  quantityPerBox Int?    @default(0) @map("quantity_per_box")

  unitPrice Float @map("unit_price")
  lineTotal Float @map("line_total")

  returnReason String  @map("return_reason")
  condition    String  @default("Good")
  notes        String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  return              PurchaseReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id])
  goodsReceiving      GoodsReceiving?      @relation(fields: [goodsReceivingId], references: [id])
  goodsReceivingItem  GoodsReceivingItem?  @relation(fields: [goodsReceivingItemId], references: [id])
  purchaseInvoice     PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  PurchaseInvoiceItem PurchaseInvoiceItem? @relation(fields: [purchaseInvoiceItemId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([goodsReceivingId])
  @@index([goodsReceivingItemId])
  @@index([purchaseInvoiceId])
  @@map("purchase_return_items")
}

model PurchaseReturn {
  id           String   @id @default(uuid())
  returnNumber String   @unique @map("return_number")
  returnDate   DateTime @default(now()) @map("return_date")

  supplierId   String @map("supplier_id")
  supplierName String @map("supplier_name")

  goodsReceivingId String? @map("goods_receiving_id")
  grnNumber        String? @map("grn_number")

  purchaseInvoiceId     String? @map("purchase_invoice_id")
  purchaseInvoiceNumber String? @map("purchase_invoice_number")

  returnReason String  @map("return_reason")
  status       String  @default("Draft")
  notes        String? @map("notes")

  totalReturnQty Int   @default(0) @map("total_return_qty")
  returnAmount   Float @default(0) @map("return_amount")
  grandTotal     Float @default(0) @map("grand_total")

  journalEntryId String? @unique @map("journal_entry_id")
  apRecordId     String? @map("ap_record_id")

  createdBy   String    @map("created_by")
  updatedBy   String?   @map("updated_by")
  processedBy String?   @map("processed_by")
  processedAt DateTime? @map("processed_at")
  cancelledBy String?   @map("cancelled_by")
  cancelledAt DateTime? @map("cancelled_at")
  isActive    Boolean   @default(true) @map("is_active")
  isDeleted   Boolean   @default(false) @map("is_deleted")

  currencyId       String?   @map("currency_id")
  baseCurrencyId   String?   @map("base_currency_id")
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate DateTime? @map("exchange_rate_date")
  foreignAmount    Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount       Decimal?  @map("base_amount") @db.Decimal(18, 4)

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items           PurchaseReturnItem[]
  supplier        Supplier?            @relation(fields: [supplierId], references: [id])
  goodsReceiving  GoodsReceiving?      @relation(fields: [goodsReceivingId], references: [id])
  purchaseInvoice PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  creator         User?                @relation("PurchaseReturnCreator", fields: [createdBy], references: [id])
  updater         User?                @relation("PurchaseReturnUpdater", fields: [updatedBy], references: [id])
  processor       User?                @relation("PurchaseReturnProcessor", fields: [processedBy], references: [id])
  canceller       User?                @relation("PurchaseReturnCanceller", fields: [cancelledBy], references: [id])
  company         Company?             @relation("PurchaseReturnCompany", fields: [companyId], references: [id])
  currency        Currency?            @relation("PRCurrency", fields: [currencyId], references: [id])
  baseCurrency    Currency?            @relation("PRBaseCurrency", fields: [baseCurrencyId], references: [id])
  journalEntry    JournalEntry?        @relation("PurchaseReturnJournalEntry", fields: [journalEntryId], references: [id])
  apRecord        AccountsPayable?     @relation(fields: [apRecordId], references: [id])
  fiscalYear      FiscalYear?          @relation("PurchaseReturnFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([returnNumber])
  @@index([supplierId])
  @@index([goodsReceivingId])
  @@index([purchaseInvoiceId])
  @@index([status])
  @@index([returnDate])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([currencyId])
  @@index([baseCurrencyId])
  @@map("purchase_returns")
}

// ============================================================
// CREDIT NOTE MODEL
// ============================================================

model CreditNote {
  id           String   @id @default(uuid())
  creditNumber String   @map("credit_number")
  date         DateTime @default(now())

  customerId   String @map("customer_id")
  customerName String @map("customer_name")

  // Source invoice — warehouse OR sales (sales flow mirrors payments)
  originalInvoiceId     String? @map("original_invoice_id")
  salesInvoiceId        String? @map("sales_invoice_id")
  invoiceSource         String  @default("warehouse") @map("invoice_source") // warehouse | sales
  originalInvoiceNumber String  @map("original_invoice_number")
  originalInvoiceAmount Float   @map("original_invoice_amount")

  amount     Float
  reason     String
  reasonType String @map("reason_type")

  items Json @default("[]")

  status          String   @default("Issued")
  appliedAmount   Float    @default(0) @map("applied_amount")
  remainingAmount Float    @map("remaining_amount")
  expiryDate      DateTime @map("expiry_date")

  notes String @default("")

  appliedToInvoices Json @default("[]") @map("applied_to_invoices")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer        Customer          @relation(fields: [customerId], references: [id])
  originalInvoice WarehouseInvoice? @relation(fields: [originalInvoiceId], references: [id])
  salesInvoice    SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
  creator         User?             @relation("CreditNoteCreator", fields: [createdBy], references: [id])
  company         Company?          @relation("CreditNoteCompany", fields: [companyId], references: [id])
  fiscalYear      FiscalYear?       @relation("CreditNoteFiscalYear", fields: [fiscalYearId], references: [id])

  @@unique([companyId, creditNumber])
  @@index([creditNumber])
  @@index([customerId])
  @@index([originalInvoiceId])
  @@index([salesInvoiceId])
  @@index([status])
  @@index([date])
  @@index([createdBy])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("credit_notes")
}

// ============================================================
// FIXED ASSET MODEL
// ============================================================

model FixedAsset {
  id        String @id @default(uuid())
  assetCode String @unique @map("asset_code")
  name      String
  category  String @map("category")

  purchaseDate DateTime @map("purchase_date")
  purchaseCost Float    @map("purchase_cost")
  usefulLife   Int      @map("useful_life")
  salvageValue Float    @default(0) @map("salvage_value")

  depreciationMethod      String    @default("Straight Line") @map("depreciation_method")
  currentDepreciation     Float     @default(0) @map("current_depreciation")
  accumulatedDepreciation Float     @default(0) @map("accumulated_depreciation")
  netBookValue            Float     @map("net_book_value")
  lastDepreciationDate    DateTime? @map("last_depreciation_date")

  status   String @default("Active")
  location String @default("")

  supplierId   String? @map("supplier_id")
  supplierName String  @default("") @map("supplier_name")

  // Acquisition / payment flow
  acquisitionType                String  @default("purchase") @map("acquisition_type") // purchase | opening_balance
  paymentMethod                  String  @default("Cash") @map("payment_method") // Cash | Bank | Credit
  bankAccountId                  String? @map("bank_account_id")
  openingAccumulatedDepreciation Float   @default(0) @map("opening_accumulated_depreciation")

  warrantyExpiry DateTime? @map("warranty_expiry")
  notes          String    @default("")

  disposedDate   DateTime? @map("disposed_date")
  disposalAmount Float     @default(0) @map("disposal_amount")
  disposalReason String    @default("") @map("disposal_reason")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  creator     User?        @relation("FixedAssetCreator", fields: [createdBy], references: [id])
  company     Company?     @relation("FixedAssetCompany", fields: [companyId], references: [id])
  fiscalYear  FiscalYear?  @relation("FixedAssetFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([assetCode])
  @@index([category])
  @@index([status])
  @@index([createdBy])
  @@index([purchaseDate])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([bankAccountId])
  @@index([acquisitionType])
  @@index([paymentMethod])
  @@map("fixed_assets")
}

// ============================================================
// LOAN MODELS
// ============================================================

model LoanPayment {
  id        String   @id @default(uuid())
  loanId    String   @map("loan_id")
  date      DateTime
  amount    Float
  type      String   @default("EMI")
  status    String   @default("Pending")
  reference String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([date])
  @@index([status])
  @@map("loan_payments")
}

model Loan {
  id         String @id @default(uuid())
  loanNumber String @unique @map("loan_number")

  loanType         String   @map("loan_type")
  lenderName       String   @map("lender_name")
  lenderId         String?  @map("lender_id")
  loanAmount       Float    @map("loan_amount")
  disbursementDate DateTime @map("disbursement_date")
  interestRate     Float    @map("interest_rate")
  tenureMonths     Int      @map("tenure_months")
  emiAmount        Float    @map("emi_amount")

  totalPaid          Float     @default(0) @map("total_paid")
  outstandingBalance Float     @map("outstanding_balance")
  nextPaymentDate    DateTime? @map("next_payment_date")
  lastPaymentDate    DateTime? @map("last_payment_date")

  status String @default("Active")

  purpose       String  @default("")
  collateral    String  @default("")
  accountNumber String  @default("") @map("account_number")
  bankAccountId String? @map("bank_account_id")
  notes         String  @default("")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  lender      Supplier?     @relation(fields: [lenderId], references: [id])
  bankAccount BankAccount?  @relation(fields: [bankAccountId], references: [id])
  creator     User?         @relation("LoanCreator", fields: [createdBy], references: [id])
  company     Company?      @relation("LoanCompany", fields: [companyId], references: [id])
  payments    LoanPayment[]
  fiscalYear  FiscalYear?   @relation("LoanFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([loanNumber])
  @@index([lenderId])
  @@index([bankAccountId])
  @@index([status])
  @@index([loanType])
  @@index([createdBy])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("loans")
}

// ============================================================
// EQUITY ACCOUNT MODEL
// ============================================================

model EquityTransaction {
  id             String   @id @default(uuid())
  accountId      String   @map("account_id")
  date           DateTime @default(now())
  type           String
  amount         Float
  description    String
  reference      String   @default("")
  status         String   @default("Posted")
  journalEntryId String?  @unique @map("journal_entry_id")
  createdBy      String   @map("created_by")
  updatedBy      String?  @map("updated_by")
  companyId      String?  @map("company_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account      EquityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company      Company?      @relation("EquityTransactionCompany", fields: [companyId], references: [id])
  journalEntry JournalEntry? @relation("EquityTransactionJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([type])
  @@index([companyId])
  @@index([journalEntryId])
  @@map("equity_transactions")
}

model EquityAccount {
  id             String   @id @default(uuid())
  accountName    String   @map("account_name")
  accountCode    String   @map("account_code")
  accountType    String   @map("account_type")
  openingBalance Float    @default(0) @map("opening_balance")
  currentBalance Float    @default(0) @map("current_balance")
  additions      Float    @default(0)
  withdrawals    Float    @default(0)
  lastUpdated    DateTime @default(now()) @map("last_updated")
  notes          String   @default("")
  createdBy      String   @map("created_by")
  fiscalYearId   String?  @map("fiscal_year_id")
  companyId      String?  @map("company_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  creator      User?               @relation("EquityAccountCreator", fields: [createdBy], references: [id])
  company      Company?            @relation("EquityAccountCompany", fields: [companyId], references: [id])
  fiscalYear   FiscalYear?         @relation("EquityAccountFiscalYear", fields: [fiscalYearId], references: [id])
  transactions EquityTransaction[]

  @@unique([accountCode, companyId])
  @@index([accountCode])
  @@index([accountType])
  @@index([createdBy])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("equity_accounts")
}

// ============================================================
// DELIVERY MODELS
// ============================================================

model DeliveryItem {
  id                String  @id @default(uuid())
  deliveryId        String  @map("delivery_id")
  productId         String  @map("product_id")
  productName       String  @map("product_name")
  sku               String
  unit              String  @default("Pcs")
  orderedQuantity   Float   @map("ordered_quantity")
  deliveredQuantity Float   @default(0) @map("delivered_quantity")
  remainingQuantity Float   @map("remaining_quantity")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([productId])
  @@map("delivery_items")
}

model Delivery {
  id               String   @id @default(uuid())
  deliveryNumber   String   @unique @map("delivery_number")
  salesOrderId     String   @map("sales_order_id")
  salesOrderNumber String   @map("sales_order_number")
  customerId       String   @map("customer_id")
  customerName     String   @map("customer_name")
  deliveryDate     DateTime @map("delivery_date")
  deliveryStatus   String   @default("Pending") @map("delivery_status")

  deliveryPerson String? @map("delivery_person")
  trackingNumber String? @map("tracking_number")
  notes          String?

  confirmedBy String?   @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId  String? @map("company_id")
  locationId String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items         DeliveryItem[]
  salesOrder    Order          @relation("SalesOrderDeliveries", fields: [salesOrderId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  creator       User?          @relation("DeliveryCreator", fields: [createdBy], references: [id])
  updater       User?          @relation("DeliveryUpdater", fields: [updatedBy], references: [id])
  confirmer     User?          @relation("DeliveryConfirmer", fields: [confirmedBy], references: [id])
  company       Company?       @relation("DeliveryCompany", fields: [companyId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  salesInvoices SalesInvoice[]

  @@index([deliveryNumber])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([deliveryStatus])
  @@index([deliveryDate])
  @@index([isActive])
  @@index([companyId])
  @@index([locationId])
  @@map("deliveries")
}

// ============================================================
// QUOTATION MODELS
// ============================================================

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String  @map("quotation_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  sku         String
  quantity    Int
  unitPrice   Float   @map("unit_price")
  discount    Float   @default(0)
  taxRate     Float   @default(0) @map("tax_rate")
  taxAmount   Float   @default(0) @map("tax_amount")
  lineTotal   Float   @map("line_total")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model Quotation {
  id              String  @id @default(uuid())
  quotationNumber String  @unique @map("quotation_number")
  customerId      String  @map("customer_id")
  customerName    String  @map("customer_name")
  customerEmail   String? @map("customer_email")
  customerPhone   String? @map("customer_phone")
  customerCompany String? @map("customer_company")

  quotationDate DateTime @default(now()) @map("quotation_date")
  validUntil    DateTime @map("valid_until")
  salesPerson   String?  @map("sales_person")

  status String @default("Draft")

  subtotal      Float @default(0)
  totalDiscount Float @default(0) @map("total_discount")
  totalTax      Float @default(0) @map("total_tax")
  grandTotal    Float @default(0) @map("grand_total")

  notes           String? @map("notes")
  termsConditions String? @map("terms_conditions")

  sentAt           DateTime? @map("sent_at")
  acceptedAt       DateTime? @map("accepted_at")
  rejectedAt       DateTime? @map("rejected_at")
  convertedAt      DateTime? @map("converted_at")
  convertedOrderId String?   @map("converted_order_id")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  locationId String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items          QuotationItem[]
  customer       Customer?       @relation(fields: [customerId], references: [id])
  creator        User?           @relation("QuotationCreator", fields: [createdBy], references: [id])
  updater        User?           @relation("QuotationUpdater", fields: [updatedBy], references: [id])
  company        Company?        @relation("QuotationCompany", fields: [companyId], references: [id])
  convertedOrder Order?          @relation("ConvertedQuotation", fields: [convertedOrderId], references: [id])
  location       Location?       @relation(fields: [locationId], references: [id])

  @@unique([convertedOrderId])
  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
  @@index([validUntil])
  @@index([isActive])
  @@index([companyId])
  @@index([locationId])
  @@map("quotations")
}

// ============================================================
// PURCHASE ORDER MODELS
// ============================================================

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  productName     String  @map("product_name")
  sku             String
  quantity        Int
  unitPrice       Float   @map("unit_price")
  discount        Float   @default(0)
  taxRate         Float   @default(0) @map("tax_rate")
  taxAmount       Float   @default(0) @map("tax_amount")
  lineTotal       Float   @map("line_total")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product              Product?              @relation(fields: [productId], references: [id])
  goodsReceivingItems  GoodsReceivingItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseOrder {
  id              String  @id @default(uuid())
  orderNumber     String  @unique @map("order_number")
  supplierId      String  @map("supplier_id")
  supplierName    String  @map("supplier_name")
  supplierEmail   String? @map("supplier_email")
  supplierPhone   String? @map("supplier_phone")
  supplierAddress String? @map("supplier_address")

  purchaseRequisitionId     String? @map("purchase_requisition_id")
  purchaseRequisitionNumber String? @map("purchase_requisition_number")

  orderDate            DateTime  @default(now()) @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")

  status String @default("Draft")

  subtotal      Float @default(0)
  totalDiscount Float @default(0) @map("total_discount")
  totalTax      Float @default(0) @map("total_tax")
  grandTotal    Float @default(0) @map("grand_total")

  notes           String? @map("notes")
  termsConditions String? @map("terms_conditions")

  sentAt      DateTime? @map("sent_at")
  approvedAt  DateTime? @map("approved_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  currencyId       String?   @map("currency_id")
  baseCurrencyId   String?   @map("base_currency_id")
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate DateTime? @map("exchange_rate_date")
  foreignAmount    Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount       Decimal?  @map("base_amount") @db.Decimal(18, 4)

  companyId  String? @map("company_id")
  locationId String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items                PurchaseOrderItem[]
  supplier             Supplier?                     @relation(fields: [supplierId], references: [id])
  purchaseRequisition  PurchaseRequisition?          @relation(fields: [purchaseRequisitionId], references: [id])
  creator              User?                         @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  updater              User?                         @relation("PurchaseOrderUpdater", fields: [updatedBy], references: [id])
  company              Company?                      @relation("PurchaseOrderCompany", fields: [companyId], references: [id])
  currency             Currency?                     @relation("POCurrency", fields: [currencyId], references: [id])
  baseCurrency         Currency?                     @relation("POBaseCurrency", fields: [baseCurrencyId], references: [id])
  location             Location?                     @relation(fields: [locationId], references: [id])
  goodsReceivings      GoodsReceiving[]
  goodsReceivingLinks  GoodsReceivingPurchaseOrder[]
  purchaseInvoices     PurchaseInvoice[]
  invoiceSources       PurchaseInvoiceSource[]
  importPurchaseOrders ImportPurchaseOrder[]

  @@index([orderNumber])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([isActive])
  @@index([companyId])
  @@index([locationId])
  @@index([purchaseRequisitionId])
  @@index([currencyId])
  @@index([baseCurrencyId])
  @@map("purchase_orders")
}

model PurchaseRequisitionItem {
  id                    String  @id @default(uuid())
  purchaseRequisitionId String  @map("purchase_requisition_id")
  productId             String  @map("product_id")
  productName           String  @map("product_name")
  sku                   String
  quantity              Float
  unit                  String  @default("Pcs")
  estimatedUnitPrice    Float   @default(0) @map("estimated_unit_price")
  notes                 String?
  purpose               String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  product             Product?            @relation(fields: [productId], references: [id])

  @@index([purchaseRequisitionId])
  @@index([productId])
  @@map("purchase_requisition_items")
}

model PurchaseRequisition {
  id                String    @id @default(uuid())
  requisitionNumber String    @unique @map("requisition_number")
  title             String?
  department        String?
  priority          String    @default("Normal") // Low | Normal | High | Urgent
  requiredDate      DateTime? @map("required_date")
  status            String    @default("Draft") // Draft | Submitted | Approved | Rejected | Partially Converted | Converted | Cancelled

  suggestedSupplierId   String? @map("suggested_supplier_id")
  suggestedSupplierName String? @map("suggested_supplier_name")

  notes           String?
  rejectionReason String? @map("rejection_reason")

  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")
  convertedAt DateTime? @map("converted_at")
  cancelledAt DateTime? @map("cancelled_at")

  approvedBy String? @map("approved_by")
  createdBy  String  @map("created_by")
  updatedBy  String? @map("updated_by")
  isActive   Boolean @default(true) @map("is_active")
  isDeleted  Boolean @default(false) @map("is_deleted")

  companyId  String? @map("company_id")
  locationId String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items             PurchaseRequisitionItem[]
  purchaseOrders    PurchaseOrder[]
  suggestedSupplier Supplier?                 @relation(fields: [suggestedSupplierId], references: [id])
  creator           User?                     @relation("PurchaseRequisitionCreator", fields: [createdBy], references: [id])
  updater           User?                     @relation("PurchaseRequisitionUpdater", fields: [updatedBy], references: [id])
  approver          User?                     @relation("PurchaseRequisitionApprover", fields: [approvedBy], references: [id])
  company           Company?                  @relation("PurchaseRequisitionCompany", fields: [companyId], references: [id])
  location          Location?                 @relation(fields: [locationId], references: [id])

  @@index([requisitionNumber])
  @@index([status])
  @@index([requiredDate])
  @@index([isActive])
  @@index([companyId])
  @@index([locationId])
  @@index([suggestedSupplierId])
  @@map("purchase_requisitions")
}

// ============================================================
// GOODS RECEIVING MODELS
// ============================================================

model GoodsReceivingItem {
  id                    String  @id @default(uuid())
  goodsReceivingId      String  @map("goods_receiving_id")
  purchaseOrderItemId   String  @map("purchase_order_item_id")
  purchaseOrderId       String? @map("purchase_order_id")
  purchaseOrderNumber   String? @map("purchase_order_number")
  productId             String  @map("product_id")
  productName           String  @map("product_name")
  sku                   String
  orderedQuantity       Float   @map("ordered_quantity")
  previouslyReceivedQty Float   @default(0) @map("previously_received_qty")
  remainingQuantity     Float   @map("remaining_quantity")
  receivingQuantity     Float   @map("receiving_quantity")
  unitPrice             Float   @default(0) @map("unit_price")
  unit                  String  @default("Pcs")
  notes                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  goodsReceiving      GoodsReceiving       @relation(fields: [goodsReceivingId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product?             @relation(fields: [productId], references: [id])
  purchaseReturnItems PurchaseReturnItem[]

  @@index([goodsReceivingId])
  @@index([purchaseOrderItemId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("goods_receiving_items")
}

model GoodsReceivingPurchaseOrder {
  id                  String @id @default(uuid())
  goodsReceivingId    String @map("goods_receiving_id")
  purchaseOrderId     String @map("purchase_order_id")
  purchaseOrderNumber String @map("purchase_order_number")

  createdAt DateTime @default(now()) @map("created_at")

  goodsReceiving GoodsReceiving @relation(fields: [goodsReceivingId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])

  @@unique([goodsReceivingId, purchaseOrderId])
  @@index([goodsReceivingId])
  @@index([purchaseOrderId])
  @@map("goods_receiving_purchase_orders")
}

model GoodsReceiving {
  id                   String   @id @default(uuid())
  grnNumber            String   @unique @map("grn_number")
  purchaseOrderId      String   @map("purchase_order_id")
  purchaseOrderNumber  String   @map("purchase_order_number")
  purchaseOrderNumbers String?  @map("purchase_order_numbers")
  supplierId           String   @map("supplier_id")
  supplierName         String   @map("supplier_name")
  receivingDate        DateTime @default(now()) @map("receiving_date")
  status               String   @default("Draft")

  receivedBy String? @map("received_by")
  notes      String?

  confirmedBy String?   @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId  String? @map("company_id")
  locationId String? @map("location_id")

  currencyId       String?   @map("currency_id")
  baseCurrencyId   String?   @map("base_currency_id")
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate DateTime? @map("exchange_rate_date")
  foreignAmount    Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount       Decimal?  @map("base_amount") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items               GoodsReceivingItem[]
  purchaseOrders      GoodsReceivingPurchaseOrder[]
  purchaseOrder       PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id])
  supplier            Supplier?                     @relation(fields: [supplierId], references: [id])
  creator             User?                         @relation("GoodsReceivingCreator", fields: [createdBy], references: [id])
  updater             User?                         @relation("GoodsReceivingUpdater", fields: [updatedBy], references: [id])
  confirmer           User?                         @relation("GoodsReceivingConfirmer", fields: [confirmedBy], references: [id])
  company             Company?                      @relation("GoodsReceivingCompany", fields: [companyId], references: [id])
  location            Location?                     @relation(fields: [locationId], references: [id])
  currency            Currency?                     @relation("GRNCurrency", fields: [currencyId], references: [id])
  baseCurrency        Currency?                     @relation("GRNBaseCurrency", fields: [baseCurrencyId], references: [id])
  purchaseInvoices    PurchaseInvoice[]
  invoiceSources      PurchaseInvoiceSource[]
  purchaseReturns     PurchaseReturn[]
  purchaseReturnItems PurchaseReturnItem[]
  importGrns          ImportGrn[]

  @@index([grnNumber])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([receivingDate])
  @@index([isActive])
  @@index([companyId])
  @@index([locationId])
  @@index([currencyId])
  @@index([baseCurrencyId])
  @@map("goods_receivings")
}

// ============================================================
// PURCHASE INVOICE MODELS
// ============================================================

model PurchaseInvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  sku         String
  quantity    Float
  unitPrice   Float   @map("unit_price")
  discount    Float   @default(0)
  taxRate     Float   @default(0) @map("tax_rate")
  taxAmount   Float   @default(0) @map("tax_amount")
  lineTotal   Float   @map("line_total")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice             PurchaseInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id])
  PurchaseOrderItem   PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseOrderItemId String?
  purchaseReturnItems PurchaseReturnItem[]

  @@index([invoiceId])
  @@index([productId])
  @@map("purchase_invoice_items")
}

model PurchaseInvoiceSource {
  id               String  @id @default(uuid())
  invoiceId        String  @map("invoice_id")
  sourceType       String  @map("source_type") // GRN | PO
  goodsReceivingId String? @map("goods_receiving_id")
  purchaseOrderId  String? @map("purchase_order_id")
  sourceNumber     String  @map("source_number")

  createdAt DateTime @default(now()) @map("created_at")

  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  goodsReceiving GoodsReceiving? @relation(fields: [goodsReceivingId], references: [id])
  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])

  @@index([invoiceId])
  @@index([goodsReceivingId])
  @@index([purchaseOrderId])
  @@map("purchase_invoice_sources")
}

model PurchaseInvoice {
  id                String  @id @default(uuid())
  invoiceNumber     String  @unique @map("invoice_number")
  supplierId        String  @map("supplier_id")
  supplierName      String  @map("supplier_name")
  supplierEmail     String? @map("supplier_email")
  supplierPhone     String? @map("supplier_phone")
  supplierInvoiceNo String? @map("supplier_invoice_no")

  purchaseOrderId     String? @map("purchase_order_id")
  purchaseOrderNumber String? @map("purchase_order_number")
  goodsReceivingId    String? @map("goods_receiving_id")
  grnNumber           String? @map("grn_number")
  sourceSummary       String? @map("source_summary")

  invoiceDate  DateTime @default(now()) @map("invoice_date")
  dueDate      DateTime @map("due_date")
  paymentTerms String   @default("Net 30") @map("payment_terms")

  subtotal      Float @default(0)
  discountTotal Float @default(0) @map("discount_total")
  taxTotal      Float @default(0) @map("tax_total")
  grandTotal    Float @default(0) @map("grand_total")
  paidAmount    Float @default(0) @map("paid_amount")
  outstanding   Float @default(0)

  invoiceStatus String @default("Draft") @map("invoice_status")
  paymentStatus String @default("Unpaid") @map("payment_status")

  notes String? @map("notes")

  postedAt    DateTime? @map("posted_at")
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")

  accountsPayableId  String? @map("accounts_payable_id")
  journalEntryId     String? @unique @map("journal_entry_id")
  inventoryAccountId String? @map("inventory_account_id")
  apAccountId        String? @map("ap_account_id")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  currencyId       String?   @map("currency_id")
  baseCurrencyId   String?   @map("base_currency_id")
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate DateTime? @map("exchange_rate_date")
  foreignAmount    Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount       Decimal?  @map("base_amount") @db.Decimal(18, 4)

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")
  locationId   String? @map("location_id")

  /// Installment purchase plan (integrated into existing purchase invoice)
  isInstallmentPurchase Boolean @default(false) @map("is_installment_purchase")
  downPaymentAmount     Float   @default(0) @map("down_payment_amount")
  installmentCount      Int?    @map("installment_count")
  installmentFrequency  String? @map("installment_frequency")
  installmentAmount     Float?  @map("installment_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items                PurchaseInvoiceItem[]
  sources              PurchaseInvoiceSource[]
  supplier             Supplier?                     @relation(fields: [supplierId], references: [id])
  purchaseOrder        PurchaseOrder?                @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiving       GoodsReceiving?               @relation(fields: [goodsReceivingId], references: [id])
  creator              User?                         @relation("PurchaseInvoiceCreator", fields: [createdBy], references: [id])
  updater              User?                         @relation("PurchaseInvoiceUpdater", fields: [updatedBy], references: [id])
  company              Company?                      @relation("PurchaseInvoiceCompany", fields: [companyId], references: [id])
  currency             Currency?                     @relation("PICurrency", fields: [currencyId], references: [id])
  baseCurrency         Currency?                     @relation("PIBaseCurrency", fields: [baseCurrencyId], references: [id])
  location             Location?                     @relation(fields: [locationId], references: [id])
  journalEntry         JournalEntry?                 @relation(fields: [journalEntryId], references: [id])
  accountsPayable      AccountsPayable[]
  inventoryAccount     ChartOfAccount?               @relation("InventoryAccount", fields: [inventoryAccountId], references: [id])
  apAccount            ChartOfAccount?               @relation("APAccount", fields: [apAccountId], references: [id])
  purchasePayments     PurchasePaymentInvoice[]
  purchaseReturns      PurchaseReturn[]
  PurchaseReturnItem   PurchaseReturnItem[]
  fiscalYear           FiscalYear?                   @relation("PurchaseInvoiceFiscalYear", fields: [fiscalYearId], references: [id])
  importSupplierBills  ImportSupplierBill[]
  installmentSchedules PurchaseInstallmentSchedule[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceivingId])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([locationId])
  @@index([currencyId])
  @@index([baseCurrencyId])
  @@index([isInstallmentPurchase])
  @@map("purchase_invoices")
}

model PurchaseInstallmentSchedule {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  invoiceId         String    @map("invoice_id")
  installmentNumber Int       @map("installment_number")
  dueDate           DateTime  @map("due_date")
  amount            Float
  paidAmount        Float     @default(0) @map("paid_amount")
  status            String    @default("Pending")
  paidAt            DateTime? @map("paid_at")
  purchasePaymentId String?   @map("purchase_payment_id")
  notes             String    @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company         @relation("PurchaseInstallmentScheduleCompany", fields: [companyId], references: [id], onDelete: Cascade)
  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, installmentNumber])
  @@index([companyId])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([status])
  @@map("purchase_installment_schedules")
}

// ============================================================
// SALES INVOICE MODELS
// ============================================================

model SalesInvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  sku         String
  quantity    Float
  unitPrice   Float   @map("unit_price")
  discount    Float   @default(0)
  taxRate     Float   @default(0) @map("tax_rate")
  taxAmount   Float   @default(0) @map("tax_amount")
  lineTotal   Float   @map("line_total")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("sales_invoice_items")
}

model SalesInvoice {
  id              String  @id @default(uuid())
  invoiceNumber   String  @unique @map("invoice_number")
  orderId         String? @map("order_id")
  orderNumber     String? @map("order_number")
  posSaleId       String? @map("pos_sale_id")
  deliveryId      String? @map("delivery_id")
  deliveryNumber  String? @map("delivery_number")
  customerId      String  @map("customer_id")
  customerName    String  @map("customer_name")
  customerEmail   String? @map("customer_email")
  customerPhone   String? @map("customer_phone")
  billingAddress  Json?   @map("billing_address")
  shippingAddress Json?   @map("shipping_address")

  invoiceDate  DateTime @default(now()) @map("invoice_date")
  dueDate      DateTime @map("due_date")
  paymentTerms String   @default("Net 30") @map("payment_terms")

  subtotal      Float @default(0)
  discountTotal Float @default(0) @map("discount_total")
  taxTotal      Float @default(0) @map("tax_total")
  grandTotal    Float @default(0) @map("grand_total")
  paidAmount    Float @default(0) @map("paid_amount")
  outstanding   Float @default(0)

  invoiceStatus String @default("Draft") @map("invoice_status")
  paymentStatus String @default("Unpaid") @map("payment_status")

  notes           String? @map("notes")
  termsConditions String? @map("terms_conditions")

  postedAt    DateTime? @map("posted_at")
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")

  salesRevenueAccountId String? @map("sales_revenue_account_id")
  arAccountId           String? @map("ar_account_id")
  journalEntryId        String? @unique @map("journal_entry_id")

  salesPerson   String? @map("sales_person")
  salesPersonId String? @map("sales_person_id")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")
  locationId   String? @map("location_id")

  /// Installment sale plan (integrated into existing sales invoice — not a separate module)
  isInstallmentSale    Boolean @default(false) @map("is_installment_sale")
  downPaymentAmount    Float   @default(0) @map("down_payment_amount")
  installmentCount     Int?    @map("installment_count")
  /// monthly | weekly | biweekly | quarterly
  installmentFrequency String? @map("installment_frequency")
  installmentAmount    Float?  @map("installment_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items                SalesInvoiceItem[]
  order                Order?                     @relation(fields: [orderId], references: [id])
  delivery             Delivery?                  @relation(fields: [deliveryId], references: [id])
  customer             Customer?                  @relation(fields: [customerId], references: [id])
  creator              User?                      @relation("SalesInvoiceCreator", fields: [createdBy], references: [id])
  updater              User?                      @relation("SalesInvoiceUpdater", fields: [updatedBy], references: [id])
  company              Company?                   @relation("SalesInvoiceCompany", fields: [companyId], references: [id])
  location             Location?                  @relation(fields: [locationId], references: [id])
  journalEntry         JournalEntry?              @relation(fields: [journalEntryId], references: [id])
  accountsReceivable   AccountsReceivable[]
  salesperson          Salesperson?               @relation(fields: [salesPersonId], references: [id], onDelete: SetNull)
  salesRevenueAccount  ChartOfAccount?            @relation("SalesRevenueAccount", fields: [salesRevenueAccountId], references: [id])
  arAccount            ChartOfAccount?            @relation("ARAccount", fields: [arAccountId], references: [id])
  invoicePayments      SalesInvoicePayment[]
  fiscalYear           FiscalYear?                @relation("SalesInvoiceFiscalYear", fields: [fiscalYearId], references: [id])
  creditNotes          CreditNote[]
  installmentSchedules SalesInstallmentSchedule[]

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([deliveryId])
  @@index([customerId])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([locationId])
  @@index([isInstallmentSale])
  @@map("sales_invoices")
}

model SalesInstallmentSchedule {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  invoiceId         String    @map("invoice_id")
  installmentNumber Int       @map("installment_number")
  dueDate           DateTime  @map("due_date")
  amount            Float
  paidAmount        Float     @default(0) @map("paid_amount")
  /// Pending | Partial | Paid | Overdue | Cancelled
  status            String    @default("Pending")
  paidAt            DateTime? @map("paid_at")
  salesPaymentId    String?   @map("sales_payment_id")
  notes             String    @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company      @relation("SalesInstallmentScheduleCompany", fields: [companyId], references: [id], onDelete: Cascade)
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, installmentNumber])
  @@index([companyId])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([status])
  @@map("sales_installment_schedules")
}

// ============================================================
// TRANSACTION MODEL
// ============================================================

model Transaction {
  id                String   @id @default(uuid())
  transactionNumber String   @unique @map("transaction_number")
  date              DateTime @default(now())
  type              String
  title             String
  description       String   @default("")
  amount            Float
  category          String
  paymentMethod     String   @default("Cash")
  reference         String   @default("")

  customerId    String? @map("customer_id")
  customerName  String  @default("")
  vendorId      String? @map("vendor_id")
  vendorName    String  @default("")
  bankAccountId String? @map("bank_account_id")

  status String @default("Posted")

  createdBy String    @map("created_by")
  postedBy  String?   @map("posted_by")
  postedAt  DateTime? @map("posted_at")

  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer       Customer?     @relation("CustomerTransactions", fields: [customerId], references: [id])
  vendor         Supplier?     @relation("SupplierTransactions", fields: [vendorId], references: [id])
  bankAccount    BankAccount?  @relation("BankAccountTransactions", fields: [bankAccountId], references: [id])
  creator        User?         @relation("TransactionCreator", fields: [createdBy], references: [id])
  poster         User?         @relation("TransactionPoster", fields: [postedBy], references: [id])
  company        Company?      @relation("TransactionCompany", fields: [companyId], references: [id])
  journalEntry   JournalEntry? @relation("TransactionJournalEntry", fields: [journalEntryId], references: [id])
  journalEntryId String?       @unique @map("journal_entry_id")
  fiscalYear     FiscalYear?   @relation("TransactionFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([transactionNumber])
  @@index([type])
  @@index([category])
  @@index([date])
  @@index([status])
  @@index([customerId])
  @@index([vendorId])
  @@index([bankAccountId])
  @@index([createdBy])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("transactions")
}

model POSTerminal {
  id         String    @id @default(uuid()) @map("id")
  name       String
  code       String // Counter identifier, e.g. "TERM-01"
  status     String    @default("Active") // Active, Inactive, Disabled
  isActive   Boolean   @default(true) @map("is_active")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deviceInfo Json?     @map("device_info")
  lastSyncAt DateTime? @map("last_sync_at")
  companyId  String    @map("company_id")
  locationId String?   @map("location_id")
  createdBy  String    @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company       Company    @relation(fields: [companyId], references: [id])
  location      Location?  @relation(fields: [locationId], references: [id])
  creator       User       @relation("TerminalCreator", fields: [createdBy], references: [id])
  shifts        POSShift[]
  sales         POSSale[]
  assignedUsers User[]     @relation("UserAssignedTerminal")

  @@unique([code, companyId])
  @@index([companyId])
  @@index([locationId])
  @@map("pos_terminals")
}

model POSShift {
  id           String    @id @default(uuid())
  terminalId   String    @map("terminal_id")
  cashierId    String    @map("cashier_id")
  companyId    String    @map("company_id")
  status       String    @default("Open") // Open, Closed, Suspended
  openingCash  Float     @map("opening_cash")
  closingCash  Float?    @map("closing_cash")
  expectedCash Float?    @map("expected_cash")
  actualCash   Float?    @map("actual_cash")
  difference   Float?    @map("difference")
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  suspendedAt  DateTime? @map("suspended_at")
  resumedAt    DateTime? @map("resumed_at")
  notes        String?
  approvedBy   String?   @map("approved_by") // Manager who approved difference/reopening

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  terminal         POSTerminal          @relation(fields: [terminalId], references: [id])
  cashier          User                 @relation("CashierShift", fields: [cashierId], references: [id])
  company          Company              @relation(fields: [companyId], references: [id])
  sales            POSSale[]
  cashTransactions POSCashTransaction[]
  returns          POSReturn[]

  @@index([terminalId])
  @@index([cashierId])
  @@index([companyId])
  @@map("pos_shifts")
}

model POSCashTransaction {
  id         String   @id @default(uuid())
  shiftId    String   @map("shift_id")
  type       String // CASH_IN, CASH_OUT
  amount     Float
  reason     String
  approvedBy String?  @map("approved_by")
  companyId  String   @map("company_id")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  shift POSShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@index([companyId])
  @@map("pos_cash_transactions")
}

model POSSale {
  id               String    @id @map("id") // Client-generated UUID for offline compatibility
  invoiceNumber    String    @map("invoice_number")
  shiftId          String    @map("shift_id")
  terminalId       String    @map("terminal_id")
  customerId       String?   @map("customer_id")
  customerName     String    @map("customer_name")
  customerEmail    String?   @map("customer_email")
  customerPhone    String?   @map("customer_phone")
  subtotal         Float
  discountTotal    Float     @map("discount_total")
  taxTotal         Float     @default(0) @map("tax_total")
  grandTotal       Float     @map("grand_total")
  paidAmount       Float     @map("paid_amount")
  changeAmount     Float     @map("change_amount")
  notes            String?
  status           String    @default("Completed") // Completed, Held, Cancelled, Returned
  fiscalYearId     String?   @map("fiscal_year_id")
  journalEntryId   String?   @unique @map("journal_entry_id")
  invoiceId        String?   @map("invoice_id")
  orderId          String?   @map("order_id")
  deviceInfo       Json?     @map("device_info")
  syncStatus       String    @default("Completed") // Completed, Pending, Failed, Uploading
  syncFailedReason String?   @map("sync_failed_reason")
  isOffline        Boolean   @default(false) @map("is_offline")
  offlineCreatedAt DateTime? @map("offline_created_at")
  companyId        String    @map("company_id")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  shift        POSShift         @relation(fields: [shiftId], references: [id])
  terminal     POSTerminal      @relation(fields: [terminalId], references: [id])
  customer     Customer?        @relation("CustomerPOSSales", fields: [customerId], references: [id])
  fiscalYear   FiscalYear?      @relation("POSSaleFiscalYear", fields: [fiscalYearId], references: [id])
  journalEntry JournalEntry?    @relation("POSSaleJournalEntry", fields: [journalEntryId], references: [id])
  creator      User             @relation("SaleCreator", fields: [createdBy], references: [id])
  company      Company          @relation(fields: [companyId], references: [id])
  items        POSSaleItem[]
  payments     POSSalePayment[]
  returns      POSReturn[]

  @@unique([invoiceNumber, companyId])
  @@index([shiftId])
  @@index([terminalId])
  @@index([companyId])
  @@map("pos_sales")
}

model POSSaleItem {
  id               String  @id @default(uuid())
  posSaleId        String  @map("pos_sale_id")
  productId        String? @map("product_id")
  productName      String  @map("product_name")
  sku              String
  quantity         Float
  /// Sales unit at transaction time (e.g. KG, G, Pcs)
  unitName         String? @map("unit_name")
  /// Quantity converted to product stock/base unit for inventory
  baseQuantity     Float?  @map("base_quantity")
  /// 1 sales unit = conversionFactor stock units (snapshot)
  conversionFactor Float?  @default(1) @map("conversion_factor")
  unitPrice        Float   @map("unit_price")
  discount         Float   @default(0) // line discount percentage or fixed
  taxRate          Float   @default(0) @map("tax_rate")
  taxAmount        Float   @default(0) @map("tax_amount")
  lineTotal        Float   @map("line_total")
  notes            String?

  // Relations
  posSale POSSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([posSaleId])
  @@index([productId])
  @@map("pos_sale_items")
}

model POSSalePayment {
  id            String   @id @default(uuid())
  posSaleId     String   @map("pos_sale_id")
  paymentMethod String   @map("payment_method") // Cash, Card, Bank, Mobile Wallet, Cheque
  amount        Float
  reference     String?  @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  posSale POSSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([posSaleId])
  @@map("pos_sale_payments")
}

// ============================================================
// RESTAURANT POS ORDERS (Flow #2 — no draft; pick app → kitchen → counter)
// ============================================================

model RestaurantOrder {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  locationId      String?   @map("location_id")
  shiftId         String?   @map("shift_id")
  terminalId      String?   @map("terminal_id")
  tableLabel      String?   @map("table_label")
  orderType       String    @default("dine_in") @map("order_type") // dine_in | takeaway | delivery
  status          String    @default("SENT") // SENT | PREPARING | READY | PAID | CANCELLED
  priority        String    @default("normal") // normal | urgent | vip | high
  waiterUserId    String?   @map("waiter_user_id")
  notes           String?
  subtotal        Float     @default(0)
  taxTotal        Float     @default(0) @map("tax_total")
  grandTotal      Float     @default(0) @map("grand_total")
  posSaleId       String?   @map("pos_sale_id")
  ticketNumber    Int?      @map("ticket_number")
  clientRequestId String?   @map("client_request_id")
  version         Int       @default(1)
  sentAt          DateTime  @default(now()) @map("sent_at")
  preparingAt     DateTime? @map("preparing_at")
  readyAt         DateTime? @map("ready_at")
  servedAt        DateTime? @map("served_at")
  paidAt          DateTime? @map("paid_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company Company               @relation(fields: [companyId], references: [id])
  waiter  User?                 @relation("RestaurantOrderWaiter", fields: [waiterUserId], references: [id])
  lines   RestaurantOrderLine[]

  @@unique([companyId, ticketNumber])
  @@unique([companyId, clientRequestId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
  @@map("restaurant_orders")
}

model RestaurantOrderLine {
  id               String    @id @default(uuid())
  orderId          String    @map("order_id")
  productId        String?   @map("product_id")
  productName      String    @map("product_name")
  sku              String    @default("")
  quantity         Float
  unitPrice        Float     @map("unit_price")
  lineTotal        Float     @map("line_total")
  notes            String?
  kitchenStationId String?   @map("kitchen_station_id")
  lineStatus       String    @default("PENDING") @map("line_status") // PENDING | PREPARING | READY
  preparingAt      DateTime? @map("preparing_at")
  readyAt          DateTime? @map("ready_at")

  order          RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenStation KitchenStation? @relation(fields: [kitchenStationId], references: [id])

  @@index([orderId])
  @@index([kitchenStationId])
  @@map("restaurant_order_lines")
}

model KitchenStation {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  code      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company               @relation(fields: [companyId], references: [id])
  lines   RestaurantOrderLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("kitchen_stations")
}

model POSReturn {
  id             String   @id @map("id")
  originalSaleId String   @map("original_sale_id")
  returnNumber   String   @map("return_number")
  shiftId        String   @map("shift_id")
  subtotal       Float
  discountTotal  Float    @map("discount_total")
  taxTotal       Float    @map("tax_total")
  grandTotal     Float    @map("grand_total")
  refundedAmount Float    @map("refunded_amount")
  refundMethod   String   @map("refund_method")
  reason         String
  approvedBy     String   @map("approved_by")
  fiscalYearId   String?  @map("fiscal_year_id")
  journalEntryId String?  @unique @map("journal_entry_id")
  companyId      String   @map("company_id")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  originalSale POSSale         @relation(fields: [originalSaleId], references: [id])
  shift        POSShift        @relation(fields: [shiftId], references: [id])
  journalEntry JournalEntry?   @relation("POSReturnJournalEntry", fields: [journalEntryId], references: [id])
  fiscalYear   FiscalYear?     @relation("POSReturnFiscalYear", fields: [fiscalYearId], references: [id])
  creator      User            @relation("ReturnCreator", fields: [createdBy], references: [id])
  company      Company         @relation(fields: [companyId], references: [id])
  items        POSReturnItem[]

  @@unique([returnNumber, companyId])
  @@index([originalSaleId])
  @@index([shiftId])
  @@index([companyId])
  @@map("pos_returns")
}

model POSReturnItem {
  id               String  @id @default(uuid())
  posReturnId      String  @map("pos_return_id")
  productId        String  @map("product_id")
  quantity         Float
  unitName         String? @map("unit_name")
  baseQuantity     Float?  @map("base_quantity")
  conversionFactor Float?  @default(1) @map("conversion_factor")
  unitPrice        Float   @map("unit_price")
  lineTotal        Float   @map("line_total")

  // Relations
  posReturn POSReturn @relation(fields: [posReturnId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([posReturnId])
  @@index([productId])
  @@map("pos_return_items")
}

model POSAuditLog {
  id        String   @id @default(uuid())
  action    String // Sale, Return, Refund, Void, Discount Approval, Shift Open, Shift Close, Cash Adjustment
  details   String   @default("")
  companyId String   @map("company_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  creator User    @relation("AuditCreator", fields: [createdBy], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdBy])
  @@map("pos_audit_logs")
}

// ============================================================
// INTERNATIONAL TAX MANAGEMENT
// ============================================================

model CompanyTaxProfile {
  id                    String   @id @default(uuid())
  companyId             String   @unique @map("company_id")
  countryCode           String   @default("US") @map("country_code")
  regime                String   @default("SALES_TAX") // VAT, GST, SALES_TAX, MIXED
  pricingModel          String   @default("exclusive") @map("pricing_model") // exclusive, inclusive
  taxRegistrationNumber String?  @map("tax_registration_number")
  filingFrequency       String   @default("quarterly") @map("filing_frequency")
  defaultJurisdictionId String?  @map("default_jurisdiction_id")
  recoverInputTax       Boolean  @default(true) @map("recover_input_tax")
  taxEnabled            Boolean  @default(true) @map("tax_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company             Company          @relation(fields: [companyId], references: [id])
  defaultJurisdiction TaxJurisdiction? @relation("DefaultTaxJurisdiction", fields: [defaultJurisdictionId], references: [id])

  @@index([countryCode])
  @@map("company_tax_profiles")
}

model TaxJurisdiction {
  id          String   @id @default(uuid())
  code        String
  name        String
  level       String // Country, State, County, City, SpecialZone
  parentId    String?  @map("parent_id")
  countryCode String   @map("country_code") // ISO 3166-1 alpha-2
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  companyId   String   @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent             TaxJurisdiction?    @relation("JurisdictionHierarchy", fields: [parentId], references: [id])
  children           TaxJurisdiction[]   @relation("JurisdictionHierarchy")
  company            Company             @relation("TaxJurisdictionCompany", fields: [companyId], references: [id])
  taxRates           TaxRate[]
  taxTransactions    TaxTransaction[]    @relation("TaxTransactionJurisdiction")
  defaultForProfiles CompanyTaxProfile[] @relation("DefaultTaxJurisdiction")

  @@unique([companyId, code])
  @@index([parentId])
  @@index([countryCode])
  @@index([companyId])
  @@map("tax_jurisdictions")
}

model TaxType {
  id              String   @id @default(uuid())
  code            String // VAT, GST, SALES_TAX, EXCISE, etc.
  name            String
  description     String?
  calculationType String   @default("percentage") // percentage, flat, tiered
  isCompound      Boolean  @default(false) @map("is_compound")
  isActive        Boolean  @default(true) @map("is_active")
  companyId       String   @map("company_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  company         Company          @relation("TaxTypeCompany", fields: [companyId], references: [id])
  taxRates        TaxRate[]
  taxTransactions TaxTransaction[] @relation("TaxTransactionType")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("tax_types")
}

model TaxRate {
  id             String    @id @default(uuid())
  jurisdictionId String    @map("jurisdiction_id")
  taxTypeId      String    @map("tax_type_id")
  rate           Float
  effectiveFrom  DateTime  @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  isDefault      Boolean   @default(false) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  companyId      String    @map("company_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  jurisdiction    TaxJurisdiction  @relation(fields: [jurisdictionId], references: [id])
  taxType         TaxType          @relation(fields: [taxTypeId], references: [id])
  company         Company          @relation("TaxRateCompany", fields: [companyId], references: [id])
  taxRules        TaxRule[]
  taxTransactions TaxTransaction[] @relation("TaxTransactionTaxRate")

  @@index([jurisdictionId])
  @@index([taxTypeId])
  @@index([companyId])
  @@map("tax_rates")
}

model TaxRule {
  id                String   @id @default(uuid())
  name              String
  taxRateId         String   @map("tax_rate_id")
  productCategoryId String?  @map("product_category_id")
  productId         String?  @map("product_id")
  customerGroupId   String?  @map("customer_group_id")
  pricingModel      String   @default("exclusive") // exclusive, inclusive, mixed
  exemptionAllowed  Boolean  @default(true) @map("exemption_allowed")
  compoundOn        String?  @map("compound_on") // tax rate code to compound on
  priority          Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")
  companyId         String   @map("company_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  taxRate TaxRate @relation(fields: [taxRateId], references: [id])
  company Company @relation("TaxRuleCompany", fields: [companyId], references: [id])

  @@index([taxRateId])
  @@index([productCategoryId])
  @@index([productId])
  @@index([companyId])
  @@map("tax_rules")
}

model TaxExemptionType {
  id                  String   @id @default(uuid())
  code                String // RESALE, NON_PROFIT, EXPORT, etc.
  name                String
  description         String?
  percentage          Float    @default(100) // 100% = full exemption
  requiresCertificate Boolean  @default(false) @map("requires_certificate")
  isActive            Boolean  @default(true) @map("is_active")
  companyId           String   @map("company_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  company    Company        @relation("TaxExemptionTypeCompany", fields: [companyId], references: [id])
  exemptions TaxExemption[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("tax_exemption_types")
}

model TaxExemption {
  id                   String    @id @default(uuid())
  exemptionTypeId      String    @map("exemption_type_id")
  customerId           String?   @map("customer_id")
  productId            String?   @map("product_id")
  productCategoryId    String?   @map("product_category_id")
  certificateNumber    String?   @map("certificate_number")
  certificateIssuedAt  DateTime? @map("certificate_issued_at")
  certificateExpiresAt DateTime? @map("certificate_expires_at")
  approvedBy           String?   @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  isActive             Boolean   @default(true) @map("is_active")
  companyId            String    @map("company_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  exemptionType TaxExemptionType @relation(fields: [exemptionTypeId], references: [id])
  customer      Customer?        @relation("CustomerTaxExemptions", fields: [customerId], references: [id])
  product       Product?         @relation("ProductTaxExemptions", fields: [productId], references: [id])
  approver      User?            @relation("ExemptionApprover", fields: [approvedBy], references: [id])
  company       Company          @relation("TaxExemptionCompany", fields: [companyId], references: [id])

  @@index([exemptionTypeId])
  @@index([customerId])
  @@index([productId])
  @@index([companyId])
  @@map("tax_exemptions")
}

model TaxTransaction {
  id              String   @id @default(uuid())
  transactionId   String   @map("transaction_id")
  transactionType String   @map("transaction_type") // POSSale, SalesInvoice, Order
  jurisdictionId  String   @map("jurisdiction_id")
  taxTypeId       String   @map("tax_type_id")
  taxRateId       String   @map("tax_rate_id")
  taxableAmount   Float    @map("taxable_amount")
  taxRate         Float    @map("tax_rate")
  taxAmount       Float    @map("tax_amount")
  exemptionAmount Float    @map("exemption_amount")
  isCompound      Boolean  @default(false) @map("is_compound")
  compoundOnId    String?  @map("compound_on_id")
  currency        String   @default("USD")
  exchangeRate    Float?   @map("exchange_rate")
  companyId       String   @map("company_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  jurisdiction    TaxJurisdiction @relation("TaxTransactionJurisdiction", fields: [jurisdictionId], references: [id])
  taxType         TaxType         @relation("TaxTransactionType", fields: [taxTypeId], references: [id])
  taxRateRelation TaxRate         @relation("TaxTransactionTaxRate", fields: [taxRateId], references: [id])
  company         Company         @relation("TaxTransactionCompany", fields: [companyId], references: [id])

  @@index([transactionId])
  @@index([transactionType])
  @@index([jurisdictionId])
  @@index([taxTypeId])
  @@index([companyId])
  @@map("tax_transactions")
}

// ============================================================
// MANUFACTURING MODULE
// ============================================================

// ============================================================
// MANUFACTURING BOM (Bill of Materials)
// ============================================================

model ManufacturingBOM {
  id                 String    @id @default(uuid())
  bomNumber          String    @unique @map("bom_number")
  productId          String    @map("product_id")
  productName        String    @map("product_name")
  version            String    @default("1.0")
  status             String    @default("Draft") // Draft | Active | Obsolete
  quantity           Float     @default(1)
  uom                String?   @default("Nos")
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  description        String?
  notes              String?
  totalEstimatedCost Float     @default(0) @map("total_estimated_cost")

  // ERPNext Production Item / BOM Configuration / More Info
  withOperations              Boolean @default(false) @map("with_operations")
  trackSemiFinishedGoods      Boolean @default(false) @map("track_semi_finished_goods")
  transferMaterialAgainst     String? @map("transfer_material_against")
  routingId                   String? @map("routing_id")
  operations                  Json    @default("[]")
  processLossPercentage       Float   @default(0) @map("process_loss_percentage")
  processLossQty              Float   @default(0) @map("process_loss_qty")
  setQtyBasedOnPercentage     Boolean @default(false) @map("set_qty_based_on_percentage")
  isDefault                   Boolean @default(false) @map("is_default")
  setRateOfSubAssemblyItemBasedOnBom Boolean @default(true) @map("set_rate_of_sub_assembly_item_based_on_bom")
  allowAlternativeItem        Boolean @default(false) @map("allow_alternative_item")
  isPhantomBom                Boolean @default(false) @map("is_phantom_bom")
  inspectionRequired          Boolean @default(false) @map("inspection_required")
  qualityInspectionTemplate   String? @map("quality_inspection_template")
  defaultSourceWarehouse      String? @map("default_source_warehouse")
  defaultTargetWarehouse      String? @map("default_target_warehouse")
  backflushBasedOn            String? @default("BOM") @map("backflush_based_on")
  operatingCost               Float   @default(0) @map("operating_cost")
  rawMaterialCost             Float   @default(0) @map("raw_material_cost")
  fgBasedOperatingCost        Boolean @default(false) @map("fg_based_operating_cost")
  operatingCostPerBomQuantity Float   @default(0) @map("operating_cost_per_bom_quantity")
  rmCostAsPer                 String? @default("Valuation Rate") @map("rm_cost_as_per")
  buyingPriceList             String? @map("buying_price_list")
  currency                    String?
  conversionRate              Float   @default(1) @map("conversion_rate")
  project                     String?
  explodedItems               Json    @default("[]") @map("exploded_items")
  secondaryItems              Json    @default("[]") @map("secondary_items")
  secondaryItemsCost          Float   @default(0) @map("secondary_items_cost")
  costAllocation              Float   @default(0) @map("cost_allocation")
  costAllocationPer           Float   @default(0) @map("cost_allocation_per")

  createdBy  String  @map("created_by")
  updatedBy  String? @map("updated_by")
  companyId  String  @map("company_id")
  locationId String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product          Product                        @relation("ManufacturingBOMProduct", fields: [productId], references: [id])
  routing          ManufacturingRouting?          @relation("ManufacturingBOMRouting", fields: [routingId], references: [id])
  creator          User?                          @relation("ManufacturingBOMCreator", fields: [createdBy], references: [id])
  updater          User?                          @relation("ManufacturingBOMUpdater", fields: [updatedBy], references: [id])
  company          Company                        @relation("ManufacturingBOMCompany", fields: [companyId], references: [id])
  location         Location?                      @relation("ManufacturingBOMLocation", fields: [locationId], references: [id])
  components       ManufacturingBOMComponent[]
  productionOrders ManufacturingProductionOrder[]

  @@index([bomNumber])
  @@index([productId])
  @@index([status])
  @@index([companyId])
  @@index([locationId])
  @@map("manufacturing_boms")
}

model ManufacturingBOMComponent {
  id                 String  @id @default(uuid())
  bomId              String  @map("bom_id")
  componentId        String  @map("component_id")
  componentName      String  @map("component_name")
  quantity           Float
  unitOfMeasure      String  @map("unit_of_measure")
  scrapPercentage    Float   @default(0) @map("scrap_percentage")
  substituteMaterial String? @map("substitute_material")
  operationSequence  Int?    @map("operation_sequence")
  workCenterId       String? @map("work_center_id")
  rate               Float   @default(0)
  estimatedCost      Float   @default(0) @map("estimated_cost")
  bomNo              String? @map("bom_no")
  sourceWarehouse    String? @map("source_warehouse")
  doNotExplode       Boolean @default(false) @map("do_not_explode")
  percentage         Float   @default(0)
  notes              String?
  sequence           Int     @default(0)

  bom        ManufacturingBOM         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component  Product                  @relation("ManufacturingBOMComponentProduct", fields: [componentId], references: [id])
  workCenter ManufacturingWorkCenter? @relation("ManufacturingBOMComponentWorkCenter", fields: [workCenterId], references: [id])

  @@index([bomId])
  @@index([componentId])
  @@index([workCenterId])
  @@map("manufacturing_bom_components")
}

// ============================================================
// MANUFACTURING ROUTING
// ============================================================

model ManufacturingRouting {
  id                 String  @id @default(uuid())
  routingNumber      String  @unique @map("routing_number")
  productId          String  @map("product_id")
  productName        String  @map("product_name")
  version            String  @default("1.0")
  status             String  @default("Draft") // Draft | Active | Obsolete
  description        String?
  notes              String?
  totalEstimatedTime Float   @default(0) @map("total_estimated_time")
  totalEstimatedCost Float   @default(0) @map("total_estimated_cost")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  companyId String  @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product          Product                         @relation("ManufacturingRoutingProduct", fields: [productId], references: [id])
  creator          User?                           @relation("ManufacturingRoutingCreator", fields: [createdBy], references: [id])
  updater          User?                           @relation("ManufacturingRoutingUpdater", fields: [updatedBy], references: [id])
  company          Company                         @relation("ManufacturingRoutingCompany", fields: [companyId], references: [id])
  operations       ManufacturingRoutingOperation[]
  productionOrders ManufacturingProductionOrder[]
  boms             ManufacturingBOM[]              @relation("ManufacturingBOMRouting")

  @@index([routingNumber])
  @@index([productId])
  @@index([status])
  @@index([companyId])
  @@map("manufacturing_routings")
}

model ManufacturingRoutingOperation {
  id                 String  @id @default(uuid())
  routingId          String  @map("routing_id")
  operationName      String  @map("operation_name")
  sequence           Int
  workCenterId       String  @map("work_center_id")
  machineId          String? @map("machine_id")
  description        String?
  setupTime          Float   @default(0) @map("setup_time") // in minutes
  runTime            Float   @default(0) @map("run_time") // per unit in minutes
  queueTime          Float   @default(0) @map("queue_time") // in minutes
  laborRequirement   Float   @default(0) @map("labor_requirement") // number of workers
  machineRequirement Boolean @default(false) @map("machine_requirement")
  inspectionRequired Boolean @default(false) @map("inspection_required")
  estimatedCost      Float   @default(0) @map("estimated_cost")
  notes              String?

  routing    ManufacturingRouting    @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenter ManufacturingWorkCenter @relation("ManufacturingRoutingOperationWorkCenter", fields: [workCenterId], references: [id])
  machine    ManufacturingMachine?   @relation("ManufacturingRoutingOperationMachine", fields: [machineId], references: [id])

  @@index([routingId])
  @@index([workCenterId])
  @@index([machineId])
  @@map("manufacturing_routing_operations")
}

// ============================================================
// MANUFACTURING WORK CENTER
// ============================================================

model ManufacturingWorkCenter {
  id                String  @id @default(uuid())
  workCenterCode    String  @unique @map("work_center_code")
  name              String
  department        String?
  locationId        String? @map("location_id")
  factory           String?
  workstationTypeId String? @map("workstation_type_id")
  capacity          Float   @default(0) // per hour
  workingHours      Json?   @map("working_hours") // {"start": "08:00", "end": "17:00"}
  shift             String?
  efficiency        Float   @default(100) @map("efficiency") // percentage
  costPerHour       Float   @default(0) @map("cost_per_hour")
  status            String  @default("Active") // Active | Inactive | Maintenance | Off
  description       String?
  notes             String?

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  companyId String  @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  location          Location?                       @relation("ManufacturingWorkCenterLocation", fields: [locationId], references: [id])
  workstationType   ManufacturingWorkstationType?   @relation("ManufacturingWorkCenterWorkstationType", fields: [workstationTypeId], references: [id])
  creator           User?                           @relation("ManufacturingWorkCenterCreator", fields: [createdBy], references: [id])
  updater           User?                           @relation("ManufacturingWorkCenterUpdater", fields: [updatedBy], references: [id])
  company           Company                         @relation("ManufacturingWorkCenterCompany", fields: [companyId], references: [id])
  machines          ManufacturingMachine[]          @relation("ManufacturingMachineWorkCenter")
  bomComponents     ManufacturingBOMComponent[]     @relation("ManufacturingBOMComponentWorkCenter")
  routingOperations ManufacturingRoutingOperation[] @relation("ManufacturingRoutingOperationWorkCenter")
  workOrders        ManufacturingWorkOrder[]        @relation("ManufacturingWorkOrderWorkCenter")
  wips              ManufacturingWIP[]              @relation("ManufacturingWIPWorkCenter")
  scraps            ManufacturingScrap[]            @relation("ManufacturingScrapWorkCenter")
  reworks           ManufacturingRework[]           @relation("ManufacturingReworkWorkCenter")
  operations        ManufacturingOperation[]        @relation("ManufacturingOperationWorkstation")
  downtimeEntries   ManufacturingDowntimeEntry[]    @relation("ManufacturingDowntimeEntryWorkstation")

  @@index([workCenterCode])
  @@index([locationId])
  @@index([workstationTypeId])
  @@index([status])
  @@index([companyId])
  @@map("manufacturing_work_centers")
}

model ManufacturingMachine {
  id                  String    @id @default(uuid())
  machineCode         String    @unique @map("machine_code")
  name                String
  serialNumber        String?   @map("serial_number")
  model               String?
  manufacturer        String?
  workCenterId        String?   @map("work_center_id")
  locationId          String?   @map("location_id")
  purchaseDate        DateTime? @map("purchase_date")
  installationDate    DateTime? @map("installation_date")
  currentStatus       String    @default("Idle") @map("current_status") // Running | Idle | Maintenance | Breakdown | Offline
  hourlyOperatingCost Float     @default(0) @map("hourly_operating_cost")
  maintenanceSchedule Json?     @map("maintenance_schedule")
  capacity            Float     @default(0) // per hour
  efficiency          Float     @default(100) // percentage
  description         String?
  notes               String?

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  companyId String  @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  workCenter          ManufacturingWorkCenter?          @relation("ManufacturingMachineWorkCenter", fields: [workCenterId], references: [id])
  location            Location?                         @relation("ManufacturingMachineLocation", fields: [locationId], references: [id])
  creator             User?                             @relation("ManufacturingMachineCreator", fields: [createdBy], references: [id])
  updater             User?                             @relation("ManufacturingMachineUpdater", fields: [updatedBy], references: [id])
  company             Company                           @relation("ManufacturingMachineCompany", fields: [companyId], references: [id])
  routingOperations   ManufacturingRoutingOperation[]   @relation("ManufacturingRoutingOperationMachine")
  workOrders          ManufacturingWorkOrder[]          @relation("ManufacturingWorkOrderMachine")
  maintenanceOrders   ManufacturingMaintenanceOrder[]   @relation("ManufacturingMaintenanceOrderMachine")
  maintenanceRequests ManufacturingMaintenanceRequest[] @relation("ManufacturingMaintenanceRequestMachine")
  scraps              ManufacturingScrap[]              @relation("ManufacturingScrapMachine")

  @@index([machineCode])
  @@index([workCenterId])
  @@index([locationId])
  @@index([currentStatus])
  @@index([companyId])
  @@map("manufacturing_machines")
}

model ManufacturingProductionOrder {
  id                       String    @id @default(uuid())
  orderNumber              String    @unique @map("order_number")
  productId                String    @map("product_id")
  productName              String    @map("product_name")
  bomId                    String?   @map("bom_id")
  bomVersion               String?   @map("bom_version")
  routingId                String?   @map("routing_id")
  plannedQuantity          Float     @map("planned_quantity")
  producedQuantity         Float     @default(0) @map("produced_quantity")
  scrapQuantity            Float     @default(0) @map("scrap_quantity")
  reworkQuantity           Float     @default(0) @map("rework_quantity")
  rejectedQuantity         Float     @default(0) @map("rejected_quantity")
  remainingQuantity        Float     @map("remaining_quantity")
  startDate                DateTime  @map("start_date")
  dueDate                  DateTime  @map("due_date")
  actualStartDate          DateTime? @map("actual_start_date")
  actualEndDate            DateTime? @map("actual_end_date")
  sourceWarehouseId        String?   @map("source_warehouse_id")
  wipWarehouseId           String?   @map("wip_warehouse_id")
  finishedGoodsWarehouseId String?   @map("finished_goods_warehouse_id")
