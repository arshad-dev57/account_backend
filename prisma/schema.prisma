// ============================================================
// MULTI-COMPANY MEMBERSHIP (one user → many companies)
// ============================================================

model CompanyMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  role      String   @default("admin") // admin | user | employee (company-scoped)
  isOwner   Boolean  @default(false) @map("is_owner")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([isActive])
  @@map("company_memberships")
}

// ============================================================
// HR — employees, offices, attendance, last-known location
// ============================================================

model CostCenter {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  code        String
  name        String
  description String   @default("")
  officeId    String?  @map("office_id")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  office       HrOffice?       @relation(fields: [officeId], references: [id], onDelete: SetNull)
  departments  HrDepartment[]
  employees    HrEmployee[]
  payrollItems HrPayrollItem[]
  journalLines JournalLine[]
  expenses     Expense[]
  budgets      Budget[]
  budgetLines  BudgetLine[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("cost_centers")
}

model HrOffice {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  address      String   @default("")
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150) @map("radius_meters")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   HrEmployee[]
  locations   HrEmployeeLocation[]
  costCenters CostCenter[]
  payPeriods  HrPayPeriod[]

  @@index([companyId])
  @@map("hr_offices")
}

model HrEmployee {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  /// Optional application login. Null = HR-only employee (no ERP access).
  userId         String?   @unique @map("user_id")
  employeeCode   String    @map("employee_code")
  department     String    @default("")
  designation    String    @default("")
  officeId       String?   @map("office_id")
  employmentType String    @default("Full Time") @map("employment_type")
  employeeType   String    @default("Office Employee") @map("employee_type")
  shiftLabel     String    @default("") @map("shift_label")
  salary         Float     @default(0)
  joiningDate    DateTime? @map("joining_date")
  status         String    @default("active")
  phone          String    @default("")
  managerId      String?   @map("manager_id")
  position       String    @default("")
  costCenter     String    @default("") @map("cost_center")
  costCenterId   String?   @map("cost_center_id")
  trackingEnabled Boolean  @default(true) @map("tracking_enabled")
  cnic           String    @default("") @map("cnic")
  bankName       String    @default("") @map("bank_name")
  accountTitle   String    @default("") @map("account_title")
  accountNumber  String    @default("") @map("account_number")
  bankSwiftCode  String    @default("") @map("bank_swift_code")
  profile        Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  office      HrOffice?            @relation(fields: [officeId], references: [id], onDelete: SetNull)
  costCenterRef CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  manager     HrEmployee?          @relation("HrReporting", fields: [managerId], references: [id], onDelete: SetNull)
  reports     HrEmployee[]         @relation("HrReporting")
  attendances HrAttendance[]
  location    HrEmployeeLocation?
  leaves      HrLeave[]
  overtimes   HrOvertime[]
  tasks       HrTask[]
  reviews     HrPerformanceReview[]
  payrolls    HrPayrollItem[]
  leaveBalances HrLeaveBalance[]
  rosters     HrRoster[]
  attendanceCorrections HrAttendanceCorrection[]
  loans       HrLoan[]
  bonuses     HrBonus[]
  documents   HrDocument[]
  lifecycleEvents HrLifecycleEvent[]
  goals       HrGoal[]
  feedbacks   HrFeedback[]
  shiftSwaps  HrShiftSwap[]
  generatedDocuments HrGeneratedDocument[]
  salesperson        Salesperson?
  manufacturingWorkOrders ManufacturingWorkOrder[] @relation("ManufacturingWorkOrderEmployee")
  manufacturingScraps ManufacturingScrap[] @relation("ManufacturingScrapOperator")
  manufacturingReworks ManufacturingRework[] @relation("ManufacturingReworkOperator")
  manufacturingQualityInspections ManufacturingQualityInspection[] @relation("ManufacturingQualityInspectionInspector")
  manufacturingMaintenanceOrders ManufacturingMaintenanceOrder[] @relation("ManufacturingMaintenanceOrderTechnician")

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([officeId])
  @@index([status])
  @@index([managerId])
  @@index([costCenterId])
  @@map("hr_employees")
}

model HrAttendance {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  employeeId     String    @map("employee_id")
  workDate       DateTime  @map("work_date") @db.Date
  checkIn        DateTime? @map("check_in")
  checkOut       DateTime? @map("check_out")
  checkInLat     Float?    @map("check_in_lat")
  checkInLng     Float?    @map("check_in_lng")
  checkOutLat    Float?    @map("check_out_lat")
  checkOutLng    Float?    @map("check_out_lng")
  status         String    @default("present")
  source         String    @default("geofence")
  workingMinutes Int       @default(0) @map("working_minutes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@map("hr_attendances")
}

model HrEmployeeLocation {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
