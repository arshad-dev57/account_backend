  poster        User?           @relation("IncomePoster", fields: [postedBy], references: [id])
  company       Company?        @relation("IncomeCompany", fields: [companyId], references: [id])
  fiscalYear    FiscalYear?     @relation("IncomeFiscalYear", fields: [fiscalYearId], references: [id])
