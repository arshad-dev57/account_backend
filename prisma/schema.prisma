// ============================================================
// ROLE & PERMISSION MODELS (Enterprise Granular RBAC)
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String // admin, manager, staff, viewer, or custom role name
  description String?
  companyId   String?  @map("company_id")
  isSystem    Boolean  @default(false) @map("is_system")
  scope       String   @default("ALL")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "sales.orders.view", "accounting.journal_entries.post"
  description String?
  module      String // e.g., "sales", "accounting", "inventory", "purchases", "hr", "pos", "reports", "dashboard", "settings"
  resource    String   @default("")
  action      String // e.g., "view", "create", "edit", "delete", "post", "approve", "cancel", "print", "export"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([module])
  @@index([resource])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  scope        String   @default("ALL") // ALL, OWN, TEAM, WAREHOUSE, BRANCH, DEPARTMENT
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  companyId    String?  @map("company_id")
  permissionId String   @map("permission_id")
  effect       String   @default("ALLOW") // ALLOW or DENY
  scope        String?  @default("ALL") // ALL, OWN, TEAM, WAREHOUSE, etc.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([companyId])
  @@map("user_permission_overrides")
}

model SecurityAuditLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String // ROLE_CREATED, ROLE_UPDATED, ROLE_DELETED, PERMISSION_OVERRIDE_CHANGED, USER_ROLE_ASSIGNED
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@map("security_audit_logs")
}

// ============================================================
// USER PERMISSION MODEL (for custom page-level access)
// ============================================================

model UserPermission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  page      String // e.g., "/warehouse/dashboard", "/warehouse/products"
  canView   Boolean  @default(true) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page])
  @@index([userId])
  @@index([page])
  @@map("user_permissions")
}

// ============================================================
// FISCAL YEAR MODELS
// ============================================================

model FiscalYear {
  id         String    @id @default(uuid())
  companyId  String?   @map("company_id")
  name       String    @db.VarChar(100)
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("Open")
  closedAt   DateTime? @map("closed_at")
  closedBy   String?   @map("closed_by")
  periodType String?   @map("period_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  company            Company?               @relation("FiscalYearCompany", fields: [companyId], references: [id])
  auditLogs          FiscalYearAuditLog[]
  journalEntries     JournalEntry[]         @relation("JournalEntryFiscalYear")
  expenses           Expense[]              @relation("ExpenseFiscalYear")
  incomes            Income[]               @relation("IncomeFiscalYear")
  paymentsReceived   PaymentReceived[]      @relation("PaymentReceivedFiscalYear")
  paymentsMade       PaymentMade[]          @relation("PaymentMadeFiscalYear")
  salesInvoices      SalesInvoice[]         @relation("SalesInvoiceFiscalYear")
  purchaseInvoices   PurchaseInvoice[]      @relation("PurchaseInvoiceFiscalYear")
  creditNotes        CreditNote[]           @relation("CreditNoteFiscalYear")
  purchaseReturns    PurchaseReturn[]       @relation("PurchaseReturnFiscalYear")
  transactions       Transaction[]          @relation("TransactionFiscalYear")
  fixedAssets        FixedAsset[]           @relation("FixedAssetFiscalYear")
  loans              Loan[]                 @relation("LoanFiscalYear")
  salesPayments      SalesPaymentReceived[] @relation("SalesPaymentFiscalYear")
  purchasePayments   PurchasePaymentMake[]  @relation("PurchasePaymentFiscalYear")
  accountsReceivable AccountsReceivable[]   @relation("ARFiscalYear")
  accountsPayable    AccountsPayable[]      @relation("APFiscalYear")
  equityAccounts     EquityAccount[]        @relation("EquityAccountFiscalYear")
  posSales           POSSale[]              @relation("POSSaleFiscalYear")
  posReturns         POSReturn[]            @relation("POSReturnFiscalYear")
  stockWriteOffs     StockWriteOff[]
  budgets            Budget[]

  @@unique([companyId, name])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_years")
}

model FiscalYearAuditLog {
  id           String   @id @default(uuid())
  fiscalYearId String   @map("fiscal_year_id")
  userId       String   @map("user_id")
  action       String
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([fiscalYearId])
  @@index([userId])
  @@map("fiscal_year_audit_logs")
}

model Subscription {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  status         String    @default("active")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  amount         Float
  currency       String    @default("PKR")
  paymentMethod  String    @map("payment_method")
  transactionId  String    @default("") @map("transaction_id")
  paymentDetails Json?     @map("payment_details")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ============================================================
// CUSTOMER MODEL
// ============================================================

model Customer {
  id             String @id @default(uuid())
  customerNumber String @unique @map("customer_number")

  name         String
  email        String?
  phone        String?
  companyName  String? @map("company_name")
  customerType String  @default("Individual") @map("customer_type")
  taxId        String? @map("tax_id")

  address         Json?
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  status String @default("Active")

  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  totalOrders        Int       @default(0) @map("total_orders")
  totalSpent         Float     @default(0) @map("total_spent")
  averageOrderValue  Float     @default(0) @map("average_order_value")
  lastOrderDate      DateTime? @map("last_order_date")
  outstandingBalance Float     @default(0) @map("outstanding_balance")
  creditLimit        Float     @default(0) @map("credit_limit")
  creditTerms        String    @default("Net 30") @map("credit_terms")
  creditDays         Int       @default(30) @map("credit_days")
  creditPolicy       String    @default("WARN") @map("credit_policy") // ALLOW | WARN | BLOCK
  territory          String?

  salespersonId String? @map("salesperson_id")

  notes String?
  tags  String[] @default([])

  preferences Json?

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator               User?                  @relation("CustomerCreator", fields: [createdBy], references: [id])
  updater               User?                  @relation("CustomerUpdater", fields: [updatedBy], references: [id])
  company               Company?               @relation("CustomerCompany", fields: [companyId], references: [id])
  salesperson           Salesperson?           @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  orders                Order[]
  warehouseInvoices     WarehouseInvoice[]
  creditNotes           CreditNote[]
  payments              PaymentReceived[]
  incomes               Income[]
  posSales              POSSale[]              @relation("CustomerPOSSales")
  salesInvoices         SalesInvoice[]
  taxExemptions         TaxExemption[]         @relation("CustomerTaxExemptions")
  deliveries            Delivery[]
  quotations            Quotation[]
  accountsReceivable    AccountsReceivable[]
  salesPayments         SalesPaymentReceived[]
  transactions          Transaction[]          @relation("CustomerTransactions")
  tradingCustomerPrices TradingCustomerPrice[]

  @@unique([email, companyId])
  @@index([customerNumber])
  @@index([email])
  @@index([phone])
  @@index([customerType])
  @@index([status])
  @@index([isActive])
  @@index([name])
  @@index([companyId])
  @@map("customers")
}

// ============================================================
// PRODUCT MODEL
// ============================================================

model Product {
  id               String   @id @default(uuid())
  productId        String?  @unique @map("product_id")
  name             String
  sku              String
  barcodeNumber    String?  @unique @map("barcode_number")
  qrCode           String?  @map("qr_code")
  barcodeImage     String?  @map("barcode_image")
  description      String?
  shortDescription String?  @map("short_description")
  tags             String[] @default([])

  categoryId      String? @map("category_id")
  categoryName    String? @map("category_name")
  subCategoryId   String? @map("sub_category_id")
  subCategoryName String? @map("sub_category_name")
  brandId         String? @map("brand_id")
  brandName       String? @map("brand_name")
  modelNumber     String? @map("model_number")
  productType     String  @default("Physical") @map("product_type")
  hsCode          String? @map("hs_code")

  supplierId   String? @map("supplier_id")
  supplierName String? @map("supplier_name")
  supplierSku  String? @map("supplier_sku")
  leadTimeDays Int     @default(0) @map("lead_time_days")
  minOrderQty  Int     @default(1) @map("min_order_qty")
  maxOrderQty  Int     @default(999) @map("max_order_qty")
  reorderPoint Int     @default(10) @map("reorder_point")
  reorderQty   Int     @default(50) @map("reorder_qty")

  costPrice         Float     @map("cost_price")
  /// Weighted average inventory cost (valuation) — may differ from last purchase price
  averageCost       Float?    @map("average_cost")
  lastPurchasePrice Float?    @map("last_purchase_price")
  lastPurchaseDate  DateTime? @map("last_purchase_date")
  standardCost      Float?    @map("standard_cost")
  sellingPrice      Float     @map("selling_price")
  landingCost       Float     @default(0) @map("landing_cost")
  margin            Float     @default(0)
  marginPercentage  Float     @default(0) @map("margin_percentage")
  specialPrice      Float     @default(0) @map("special_price")
  specialPriceStart DateTime? @map("special_price_start")
  specialPriceEnd   DateTime? @map("special_price_end")
  taxRate           Float     @default(0) @map("tax_rate")
  taxType           String    @default("Exclusive") @map("tax_type")
  currencyCode      String    @default("PKR") @map("currency_code")
  totalValue        Float     @default(0) @map("total_value")
  retailPrice       Float     @default(0) @map("retail_price")
  wholesalePrice    Float     @default(0) @map("wholesale_price")

  currentStock     Float  @default(0) @map("current_stock")
  minimumStock     Float  @default(5) @map("minimum_stock")
  maximumStock     Float  @default(100) @map("maximum_stock")
  openingStock     Float  @default(0) @map("opening_stock")
  reservedStock    Float  @default(0) @map("reserved_stock")
  availableStock   Float  @default(0) @map("available_stock")
  reorderLevel     Int    @default(0) @map("reorder_level")
  safetyStock      Int    @default(0) @map("safety_stock")
  stockUnitName    String @default("Pcs") @map("stock_unit_name")
  conversionFactor Float  @default(1) @map("conversion_factor")

  /// Purchase UOM: 1 purchase unit = purchaseConversionFactor stock units (e.g. 1 bag = 25 KG)
  purchaseUnitName         String? @map("purchase_unit_name")
  purchaseConversionFactor Float   @default(1) @map("purchase_conversion_factor")
  /// Sales UOM: 1 sales unit = salesConversionFactor stock units (e.g. 1 G = 0.001 KG)
  salesUnitName            String? @map("sales_unit_name")
  salesConversionFactor    Float   @default(1) @map("sales_conversion_factor")
  /// When true (or UOM is weight/volume), POS accepts decimal quantities
  allowFractionalQty       Boolean @default(false) @map("allow_fractional_qty")

  isBoxBased  Boolean @default(false) @map("is_box_based")
  boxQuantity Int     @default(0) @map("box_quantity")
  boxUnitName String  @default("Box") @map("box_unit_name")

  rackLocationId       String? @map("rack_location_id")
  rackLocationName     String  @default("A-1-B1") @map("rack_location_name")
  zoneId               String? @map("zone_id")
  zoneName             String? @map("zone_name")
  palletNumber         String? @map("pallet_number")
  shelfNumber          String? @map("shelf_number")
  storageConditionName String  @default("Normal") @map("storage_condition_name")
  temperatureMin       Float?  @map("temperature_min")
  temperatureMax       Float?  @map("temperature_max")
  humidityMin          Float?  @map("humidity_min")
  humidityMax          Float?  @map("humidity_max")

  weight         Float    @default(0)
  weightUnitName String   @default("KG") @map("weight_unit_name")
  length         Float    @default(0)
  width          Float    @default(0)
  height         Float    @default(0)
  dimensionUnit  String   @default("cm") @map("dimension_unit")
  volume         Float    @default(0)
  color          String?
  colors         String[] @default([])
  size           String?
  sizes          String[] @default([])
  material       String?
  finish         String?

  hasExpiry         Boolean   @default(false) @map("has_expiry")
  isBatchManaged    Boolean   @default(false) @map("is_batch_managed")
  isSerialManaged   Boolean   @default(false) @map("is_serial_managed")
  isExpiryManaged   Boolean   @default(false) @map("is_expiry_managed")
  expiryDate        DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")
  batchNumber       String?   @map("batch_number")
  shelfLifeDays     Int       @default(0) @map("shelf_life_days")
  serialTracking    Boolean   @default(false) @map("serial_tracking")

  countryOfOriginName  String? @map("country_of_origin_name")
  shippingClass        String  @default("Normal") @map("shipping_class")
  handlingInstructions String? @map("handling_instructions")
  stackingLimit        Int     @default(0) @map("stacking_limit")
  freightClass         String? @map("freight_class")
  dangerousGoods       Boolean @default(false) @map("dangerous_goods")
  unNumber             String? @map("un_number")

  warrantyPeriod    Int     @default(0) @map("warranty_period")
  warrantyUnit      String  @default("Months") @map("warranty_unit")
  isReturnable      Boolean @default(true) @map("is_returnable")
  returnDays        Int     @default(7) @map("return_days")
  returnPolicy      String? @map("return_policy")
  replacementPolicy String? @map("replacement_policy")

  mainImage    String?  @map("main_image")
  images       String[] @default([])
  videoUrl     String?  @map("video_url")
  specSheet    String?  @map("spec_sheet")
  userManual   String?  @map("user_manual")
  certificates String[] @default([])

  isVariant         Boolean @default(false) @map("is_variant")
  parentProductId   String? @map("parent_product_id")
  variantType       String? @map("variant_type")
  variantAttributes Json?   @map("variant_attributes")

  isBulkManaged           Boolean @default(false) @map("is_bulk_managed")
  hasIndividualTracking   Boolean @default(false) @map("has_individual_tracking")
  defaultQuantityPerBatch Int     @default(0) @map("default_quantity_per_batch")
  bulkUnit                String  @default("Bale") @map("bulk_unit")

  status     String  @default("Active")
  visibility Boolean @default(true)
  featured   Boolean @default(false)
  newArrival Boolean @default(false) @map("new_arrival")
  bestSeller Boolean @default(false) @map("best_seller")
  onSale     Boolean @default(false) @map("on_sale")
  isActive   Boolean @default(true) @map("is_active")

  createdBy       String    @map("created_by")
  updatedBy       String?   @map("updated_by")
  lastCountedDate DateTime? @map("last_counted_date")
  lastCountedBy   String?   @map("last_counted_by")
  notes           String?

  attributes   Json?
  customFields Json? @map("custom_fields")

  companyId String? @map("company_id")

  // Bidirectional sync (local -> cloud -> local) support
  syncId       String?   @unique @map("sync_id")
  syncStatus   String    @default("SYNCED") @map("sync_status") // PENDING | SYNCED | FAILED
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category                                  Category?                                  @relation(fields: [categoryId], references: [id])
  supplier                                  Supplier?                                  @relation(fields: [supplierId], references: [id])
  creator                                   User?                                      @relation("ProductCreator", fields: [createdBy], references: [id])
  updater                                   User?                                      @relation("ProductUpdater", fields: [updatedBy], references: [id])
  parentProduct                             Product?                                   @relation("ProductVariants", fields: [parentProductId], references: [id])
  variants                                  Product[]                                  @relation("ProductVariants")
  stockMovements                            StockMovement[]
  orderItems                                OrderItem[]
  returnItems                               ReturnItem[]
  purchaseItems                             WarehousePurchaseItem[]
  invoiceItems                              WarehouseInvoiceItem[]
  company                                   Company?                                   @relation("ProductCompany", fields: [companyId], references: [id])
  deliveryItems                             DeliveryItem[]
  quotationItems                            QuotationItem[]
  salesInvoiceItems                         SalesInvoiceItem[]
  purchaseOrderItems                        PurchaseOrderItem[]
  purchaseRequisitionItems                  PurchaseRequisitionItem[]
  goodsReceivingItems                       GoodsReceivingItem[]
  purchaseInvoiceItems                      PurchaseInvoiceItem[]
  purchaseReturnItems                       PurchaseReturnItem[]
  posSaleItems                              POSSaleItem[]
  posReturnItems                            POSReturnItem[]
  taxExemptions                             TaxExemption[]                             @relation("ProductTaxExemptions")
  stockWriteOffItems                        StockWriteOffItem[]
  productStocks                             ProductStock[]
  manufacturingBOMs                         ManufacturingBOM[]                         @relation("ManufacturingBOMProduct")
  manufacturingBOMComponents                ManufacturingBOMComponent[]                @relation("ManufacturingBOMComponentProduct")
  manufacturingRoutings                     ManufacturingRouting[]                     @relation("ManufacturingRoutingProduct")
  manufacturingProductionOrders             ManufacturingProductionOrder[]             @relation("ManufacturingProductionOrderProduct")
  manufacturingWIPs                         ManufacturingWIP[]                         @relation("ManufacturingWIPProduct")
  manufacturingScraps                       ManufacturingScrap[]                       @relation("ManufacturingScrapProduct")
  manufacturingScrapsMaterial               ManufacturingScrap[]                       @relation("ManufacturingScrapMaterial")
  manufacturingByProducts                   ManufacturingByProduct[]                   @relation("ManufacturingByProductProduct")
  manufacturingReworks                      ManufacturingRework[]                      @relation("ManufacturingReworkProduct")
  manufacturingQualityInspections           ManufacturingQualityInspection[]           @relation("ManufacturingQualityInspectionProduct")
  manufacturingSubcontractOrders            ManufacturingSubcontractOrder[]            @relation("ManufacturingSubcontractOrderProduct")
  manufacturingMRPItems                     ManufacturingMRPItem[]                     @relation("ManufacturingMRPItemMaterial")
  manufacturingMaterialReservations         ManufacturingMaterialReservation[]         @relation("ManufacturingMaterialReservationComponent")
  manufacturingMaterialIssues               ManufacturingMaterialIssue[]               @relation("ManufacturingMaterialIssueComponent")
  manufacturingMaterialConsumptions         ManufacturingMaterialConsumption[]         @relation("ManufacturingMaterialConsumptionComponent")
  manufacturingSubcontractMaterialSents     ManufacturingSubcontractMaterialSent[]     @relation("ManufacturingSubcontractMaterialSentMaterial")
  manufacturingSubcontractMaterialReceiveds ManufacturingSubcontractMaterialReceived[] @relation("ManufacturingSubcontractMaterialReceivedMaterial")
  manufacturingProductCosts                 ManufacturingProductCost[]                 @relation("ManufacturingProductCostProduct")
  manufacturingDemands                      ManufacturingDemand[]                      @relation("ManufacturingDemandProduct")
  manufacturingMPSs                         ManufacturingMPS[]                         @relation("ManufacturingMPSProduct")
  tradingPriceListItems                     TradingPriceListItem[]
  tradingCustomerPrices                     TradingCustomerPrice[]
  importRfqItems                            ImportRfqItem[]
  importSupplierQuotationItems              ImportSupplierQuotationItem[]
  importPurchaseOrderItems                  ImportPurchaseOrderItem[]
  importShipmentItems                       ImportShipmentItem[]
  importGrnItems                            ImportGrnItem[]
  importLandedCostItems                     ImportLandedCostItem[]
  importProformaInvoiceItems                ImportProformaInvoiceItem[]
  importSupplierBillItems                   ImportSupplierBillItem[]
  internalTransferItems                     InternalTransferItem[]                     @relation("InternalTransferItemProduct")

  @@unique([sku, companyId])
  @@index([sku])
  @@index([productId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([currentStock])
  @@index([isActive])
  @@index([status])
  @@index([barcodeNumber])
  @@index([qrCode])
  @@index([companyId])
  @@index([companyId, updatedAt, id])
  @@map("products")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String?
  code        String?
  description String?

  parentId   String? @map("parent_id")
  parentName String? @map("parent_name")
  level      Int     @default(1)
  path       String? @default("")

  subCategoryCount Int @default(0) @map("sub_category_count")

  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")

  companyId String? @map("company_id")

  // Bidirectional sync (local -> cloud -> local) support
  syncId       String?   @unique @map("sync_id")
  syncStatus   String    @default("SYNCED") @map("sync_status") // PENDING | SYNCED | FAILED
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  creator  User?      @relation("CategoryCreator", fields: [createdBy], references: [id])
  updater  User?      @relation("CategoryUpdater", fields: [updatedBy], references: [id])
  products Product[]
  company  Company?   @relation("CategoryCompany", fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@unique([code, companyId])
  @@unique([slug, companyId])
  @@index([parentId])
  @@index([level])
  @@index([slug])
  @@index([code])
  @@index([isActive])
  @@index([companyId])
  @@index([companyId, updatedAt, id])
  @@map("categories")
}

// ============================================================
// POS MASTER DATA SYNC CHANGELOG
// Monotonic sequence for Electron POS catalog replication.
// ============================================================

model PosMasterSyncChange {
  id         BigInt   @id @default(autoincrement())
  companyId  String   @map("company_id")
  entityType String   @map("entity_type") // CATEGORY | SUBCATEGORY | PRODUCT
  entityId   String   @map("entity_id")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, id])
  @@index([companyId, entityType, entityId])
  @@map("pos_master_sync_changes")
}

// ============================================================
// SUPPLIER MODEL
// ============================================================

model Supplier {
  id            String  @id @default(uuid())
  name          String
  companyName   String? @map("company_name")
  code          String?
  contactPerson String? @map("contact_person")
  department    String?
  phone         String?
  email         String?
  address       String?
  city          String?
  country       String  @default("Pakistan")
  industry      String?
  businessType  String? @map("business_type")
  paymentTerms  String  @default("Net 30") @map("payment_terms")
  gstNumber     String? @map("gst_number")
  taxId         String? @map("tax_id")
  status        String  @default("active")
  isPreferred   Boolean @default(false) @map("is_preferred")
  isVerified    Boolean @default(false) @map("is_verified")
  createdBy     String  @map("created_by")
  notes         String?

  companyId  String? @map("company_id")
  currencyId String? @map("currency_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator                  User?                     @relation("SupplierCreator", fields: [createdBy], references: [id])
  company                  Company?                  @relation("SupplierCompany", fields: [companyId], references: [id])
  currency                 Currency?                 @relation("SupplierCurrency", fields: [currencyId], references: [id])
  products                 Product[]
  stockMovements           StockMovement[]
  purchases                WarehousePurchase[]
  bills                    Bill[]
  Expense                  Expense[]
  paymentsMade             PaymentMade[]
  fixedAssets              FixedAsset[]
  Loan                     Loan[]
  refunds                  Refund[]                  @relation("SupplierRefunds")
  returns                  Return[]                  @relation("SupplierReturns")
  purchaseOrders           PurchaseOrder[]
  purchaseRequisitions     PurchaseRequisition[]
  goodsReceivings          GoodsReceiving[]
  purchaseInvoices         PurchaseInvoice[]
  accountsPayable          AccountsPayable[]
  purchasePayments         PurchasePaymentMake[]
  purchaseReturns          PurchaseReturn[]
  transactions             Transaction[]             @relation("SupplierTransactions")
  importRfqs               ImportRfq[]
  importPurchaseOrders     ImportPurchaseOrder[]
  importSupplierQuotations ImportSupplierQuotation[]

  @@unique([code, companyId])
  @@unique([email, companyId])
  @@unique([phone, companyId])
  @@index([code])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([name])
  @@index([companyId])
  @@index([currencyId])
  @@map("suppliers")
}

// ============================================================
// SETTINGS MODEL
// ============================================================

model Setting {
  id           String  @id @default(uuid())
  category     String
  name         String
  metadata     Json?
  isDefault    Boolean @default(false) @map("is_default")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  createdBy    String  @map("created_by")
  updatedBy    String? @map("updated_by")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator User?    @relation("SettingCreator", fields: [createdBy], references: [id])
  updater User?    @relation("SettingUpdater", fields: [updatedBy], references: [id])
  company Company? @relation("SettingCompany", fields: [companyId], references: [id])

  @@unique([category, name, companyId])
  @@index([category])
  @@index([category, isDefault])
  @@index([isActive])
  @@index([companyId])
  @@map("settings")
}

model StockMovement {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  productName   String    @map("product_name")
  type          String
  /// Canonical ERP movement: OPENING_BALANCE, PURCHASE_RECEIPT, SALES_DELIVERY, TRANSFER_IN, etc.
  movementType  String?   @map("movement_type")
  quantity      Float
  /// Quantity normalized to item base UOM
  baseQuantity  Float?    @map("base_quantity")
  uom           String?
  previousStock Float     @map("previous_stock")
  newStock      Float     @map("new_stock")
  unitCost      Float?    @map("unit_cost")
  totalValue    Float?    @map("total_value")
  batchNumber   String?   @map("batch_number")
  binLocation   String?   @map("bin_location")
  movementDate  DateTime? @map("movement_date")

  stockType    String @default("bulk") @map("stock_type")
  stockDetails Json?  @map("stock_details")

  reason        String
  supplierId    String? @map("supplier_id")
  supplierName  String? @map("supplier_name")
  customerName  String? @map("customer_name")
  reference     String?
  purchaseId    String? @map("purchase_id")
  importBatchId String? @map("import_batch_id")
  status        String  @default("Completed")
  notes         String?

  createdBy String @map("created_by")

  companyId      String? @map("company_id")
  locationId     String? @map("location_id")
  fromLocationId String? @map("from_location_id")
  toLocationId   String? @map("to_location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product     Product?              @relation(fields: [productId], references: [id])
  supplier    Supplier?             @relation(fields: [supplierId], references: [id])
  purchase    WarehousePurchase?    @relation(fields: [purchaseId], references: [id])
  creator     User?                 @relation("StockMovementCreator", fields: [createdBy], references: [id])
  company     Company?              @relation("StockMovementCompany", fields: [companyId], references: [id])
  location    Location?             @relation(fields: [locationId], references: [id])
  importBatch InventoryImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([movementType])
  @@index([createdAt])
  @@index([status])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([companyId])
  @@index([locationId])
  @@index([importBatchId])
  @@map("stock_movements")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name")
  sku          String
  quantity     Float
  unitPrice    Float   @map("unit_price")
  totalPrice   Float   @map("total_price")
  weight       Float   @default(0)
  weightUnit   String  @default("KG") @map("weight_unit")
  dimensions   String?
  taxRate      Float   @default(0) @map("tax_rate")
  taxAmount    Float   @default(0) @map("tax_amount")
  discount     Float   @default(0)
  batchNumber  String? @map("batch_number")
  serialNumber String? @map("serial_number")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Order {
  id                   String    @id @default(uuid())
  orderNumber          String    @unique @map("order_number")
  orderDate            DateTime  @default(now()) @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")

  customerId      String? @map("customer_id")
  customerName    String  @map("customer_name")
  customerEmail   String? @map("customer_email")
  customerPhone   String? @map("customer_phone")
  customerType    String  @default("Individual") @map("customer_type")
  customerCompany String? @map("customer_company")
  customerTaxId   String? @map("customer_tax_id")

  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  subtotal      Float
  taxTotal      Float @default(0) @map("tax_total")
  shippingCost  Float @default(0) @map("shipping_cost")
  discountTotal Float @default(0) @map("discount_total")
  grandTotal    Float @map("grand_total")
  totalWeight   Float @default(0) @map("total_weight")
  totalItems    Int   @default(0) @map("total_items")

  paymentStatus    String    @default("Pending") @map("payment_status")
  paymentMethod    String    @default("Cash") @map("payment_method")
  paymentDate      DateTime? @map("payment_date")
  paymentReference String?   @map("payment_reference")

  orderStatus String @default("Pending") @map("order_status")

  orderType     String   @default("Standard") @map("order_type")
  priority      String   @default("Medium")
  source        String   @default("Web")
  salesPerson   String?  @map("sales_person")
  salesPersonId String?  @map("sales_person_id")
  tags          String[] @default([])

  shippingMethod  String    @default("Standard") @map("shipping_method")
  shippingCarrier String?   @map("shipping_carrier")
  trackingNumber  String?   @map("tracking_number")
  trackingUrl     String?   @map("tracking_url")
  shippingDate    DateTime? @map("shipping_date")
  deliveryDate    DateTime? @map("delivery_date")

  fulfillmentStatus    String  @default("Not Started") @map("fulfillment_status")
  pickedBy             String? @map("picked_by")
  packedBy             String? @map("packed_by")
  shippedBy            String? @map("shipped_by")
  pickListGenerated    Boolean @default(false) @map("pick_list_generated")
  packingSlipGenerated Boolean @default(false) @map("packing_slip_generated")

  couponCode     String? @map("coupon_code")
  couponDiscount Float   @default(0) @map("coupon_discount")

  customerNotes String? @map("customer_notes")
  internalNotes String? @map("internal_notes")
  orderNotes    Json?   @map("order_notes")

  approvalRequired Boolean   @default(false) @map("approval_required")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  approvalStatus   String    @default("Pending") @map("approval_status")

  attachments Json? @default("[]")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId  String? @map("company_id")
  locationId String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items              OrderItem[]
  returns            Return[]           @relation("OrderReturns")
  refunds            Refund[]           @relation("OrderRefunds")
  warehouseInvoices  WarehouseInvoice[]
  customer           Customer?          @relation(fields: [customerId], references: [id])
  creator            User?              @relation("OrderCreator", fields: [createdBy], references: [id])
  updater            User?              @relation("OrderUpdater", fields: [updatedBy], references: [id])
  picker             User?              @relation("OrderPicker", fields: [pickedBy], references: [id])
  packer             User?              @relation("OrderPacker", fields: [packedBy], references: [id])
  shipper            User?              @relation("OrderShipper", fields: [shippedBy], references: [id])
  company            Company?           @relation("OrderCompany", fields: [companyId], references: [id])
  location           Location?          @relation(fields: [locationId], references: [id])
  salesperson        Salesperson?       @relation(fields: [salesPersonId], references: [id], onDelete: SetNull)
  deliveries         Delivery[]         @relation("SalesOrderDeliveries")
  convertedQuotation Quotation?         @relation("ConvertedQuotation")
  salesInvoices      SalesInvoice[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([orderDate])
  @@index([orderType])
  @@index([priority])
  @@index([isActive])
  @@index([companyId])
  @@index([locationId])
  @@map("orders")
}

model ReturnItem {
  id             String  @id @default(uuid())
  returnId       String  @map("return_id")
  productId      String  @map("product_id")
  productName    String  @map("product_name")
  sku            String
  quantity       Int
  unitPrice      Float   @map("unit_price")
  totalPrice     Float   @map("total_price")
  returnQuantity Int     @map("return_quantity")
  reason         String
  condition      String  @default("New")
  refundAmount   Float   @map("refund_amount")
  batchNumber    String? @map("batch_number")
  serialNumber   String? @map("serial_number")
  notes          String?

  restockQuantity        Int?    @default(0) @map("restock_quantity")
  restockStatus          String? @default("Pending") @map("restock_status")
  returnReasonDetail     String? @map("return_reason_detail")
  replacementProductId   String? @map("replacement_product_id")
  replacementProductName String? @map("replacement_product_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  return  Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

model Return {
  id           String   @id @default(uuid())
  returnNumber String   @unique @map("return_number")
  returnDate   DateTime @default(now()) @map("return_date")

  orderId     String @map("order_id")
  orderNumber String @map("order_number")

  customerId    String? @map("customer_id")
  customerName  String  @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")

  subtotal      Float
  refundAmount  Float @map("refund_amount")
  restockingFee Float @default(0) @map("restocking_fee")
  shippingCost  Float @default(0) @map("shipping_cost")
  totalRefund   Float @map("total_refund")

  returnStatus String @default("Pending") @map("return_status")
  returnType   String @default("Sales Return") @map("return_type")

  reason       String
  notes        String?
  returnMethod String  @default("Original Payment") @map("return_method")

  supplierId    String? @map("supplier_id")
  supplierName  String? @map("supplier_name")
  supplierEmail String? @map("supplier_email")
  supplierPhone String? @map("supplier_phone")

  purchaseId     String? @map("purchase_id")
  purchaseNumber String? @map("purchase_number")

  returnReasonCategory String? @map("return_reason_category")

  restockStatus      String?  @default("Pending") @map("restock_status")
  qualityCheckPassed Boolean? @map("quality_check_passed")
  qualityCheckNotes  String?  @map("quality_check_notes")

  trackingNumber  String?   @map("tracking_number")
  shippingCarrier String?   @map("shipping_carrier")
  returnLabel     String?   @map("return_label")
  receivedDate    DateTime? @map("received_date")

  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")

  images      String[] @default([])
  attachments Json?    @default("[]")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items    ReturnItem[]
  order    Order              @relation("OrderReturns", fields: [orderId], references: [id])
  customer User?              @relation("ReturnCustomer", fields: [customerId], references: [id])
  supplier Supplier?          @relation("SupplierReturns", fields: [supplierId], references: [id])
  creator  User?              @relation("ReturnCreator", fields: [createdBy], references: [id])
  updater  User?              @relation("ReturnUpdater", fields: [updatedBy], references: [id])
  approver User?              @relation("ReturnApprover", fields: [approvedBy], references: [id])
  company  Company?           @relation("ReturnCompany", fields: [companyId], references: [id])
  purchase WarehousePurchase? @relation("PurchaseReturns", fields: [purchaseId], references: [id])
  refunds  Refund[]           @relation("ReturnRefunds")

  @@index([returnNumber])
  @@index([orderId])
  @@index([purchaseId])
  @@index([customerId])
  @@index([supplierId])
  @@index([returnStatus])
  @@index([returnType])
  @@index([returnDate])
  @@index([isActive])
  @@index([companyId])
  @@map("returns")
}

model Refund {
  id           String   @id @default(uuid())
  refundNumber String   @unique @map("refund_number")
  refundDate   DateTime @default(now()) @map("refund_date")

  orderId     String? @map("order_id")
  orderNumber String? @map("order_number")

  customerId    String? @map("customer_id")
  customerName  String? @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")

  purchaseId     String? @map("purchase_id")
  purchaseNumber String? @map("purchase_number")

  supplierId    String? @map("supplier_id")
  supplierName  String? @map("supplier_name")
  supplierEmail String? @map("supplier_email")
  supplierPhone String? @map("supplier_phone")

  returnId     String? @map("return_id")
  returnNumber String? @map("return_number")

  amount       Float
  refundStatus String @default("Pending") @map("refund_status")
  refundMethod String @default("Original Payment") @map("refund_method")
  refundType   String @default("Sales Refund") @map("refund_type")

  reason          String
  notes           String?
  referenceNumber String? @map("reference_number")

  bankName          String? @map("bank_name")
  accountNumber     String? @map("account_number")
  accountHolderName String? @map("account_holder_name")

  processedBy   String?   @map("processed_by")
  processedAt   DateTime? @map("processed_at")
  completedAt   DateTime? @map("completed_at")
  failureReason String?   @map("failure_reason")

  attachments Json? @default("[]")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  order     Order?             @relation("OrderRefunds", fields: [orderId], references: [id])
  customer  User?              @relation("RefundCustomer", fields: [customerId], references: [id])
  purchase  WarehousePurchase? @relation("PurchaseRefunds", fields: [purchaseId], references: [id])
  supplier  Supplier?          @relation("SupplierRefunds", fields: [supplierId], references: [id])
  creator   User?              @relation("RefundCreator", fields: [createdBy], references: [id])
  updater   User?              @relation("RefundUpdater", fields: [updatedBy], references: [id])
  processor User?              @relation("RefundProcessor", fields: [processedBy], references: [id])
  company   Company?           @relation("RefundCompany", fields: [companyId], references: [id])
  return    Return?            @relation("ReturnRefunds", fields: [returnId], references: [id])

  @@index([refundNumber])
  @@index([orderId])
  @@index([purchaseId])
  @@index([customerId])
  @@index([supplierId])
  @@index([refundStatus])
  @@index([refundMethod])
  @@index([refundType])
  @@index([refundDate])
  @@index([isActive])
  @@index([companyId])
  @@map("refunds")
}

model WarehousePurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String   @map("purchase_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  sku         String
  quantity    Int
  receivedQty Int      @default(0) @map("received_qty")
  unitCost    Float    @map("unit_cost")
  taxRate     Float    @default(0) @map("tax_rate")
  taxAmount   Float    @default(0) @map("tax_amount")
  totalCost   Float    @map("total_cost")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchase WarehousePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product?          @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("warehouse_purchase_items")
}

model WarehousePurchase {
  id                   String    @id @default(uuid())
  purchaseNumber       String    @unique @map("purchase_number")
  purchaseDate         DateTime  @default(now()) @map("purchase_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  receivedDate         DateTime? @map("received_date")

  supplierId   String @map("supplier_id")
  supplierName String @map("supplier_name")

  subtotal      Float
  taxTotal      Float @default(0) @map("tax_total")
  discountTotal Float @default(0) @map("discount_total")
  grandTotal    Float @map("grand_total")

  purchaseStatus   String  @default("Draft") @map("purchase_status")
  paymentStatus    String  @default("Unpaid") @map("payment_status")
  paymentMethod    String? @map("payment_method")
  paymentReference String? @map("payment_reference")

  reference     String?
  notes         String?
  internalNotes String? @map("internal_notes")

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items          WarehousePurchaseItem[]
  stockMovements StockMovement[]
  returns        Return[]                @relation("PurchaseReturns")
  refunds        Refund[]                @relation("PurchaseRefunds")
  supplier       Supplier                @relation(fields: [supplierId], references: [id])
  creator        User?                   @relation("WarehousePurchaseCreator", fields: [createdBy], references: [id])
  updater        User?                   @relation("WarehousePurchaseUpdater", fields: [updatedBy], references: [id])
  company        Company?                @relation("WarehousePurchaseCompany", fields: [companyId], references: [id])

  @@index([purchaseNumber])
  @@index([supplierId])
  @@index([purchaseStatus])
  @@index([paymentStatus])
  @@index([purchaseDate])
  @@index([isActive])
  @@index([companyId])
  @@map("warehouse_purchases")
}

// ============================================================
// WAREHOUSE INVOICE MODELS
// ============================================================

model WarehouseInvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  sku         String?
  description String?
  quantity    Int
  unitPrice   Float    @map("unit_price")
  taxRate     Float    @default(0) @map("tax_rate")
  taxAmount   Float    @default(0) @map("tax_amount")
  discount    Float    @default(0)
  totalPrice  Float    @map("total_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice WarehouseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("warehouse_invoice_items")
}

model WarehouseInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number")
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  dueDate       DateTime @map("due_date")

  orderId        String? @map("order_id")
  orderNumber    String? @map("order_number")
  customerId     String? @map("customer_id")
  customerName   String  @map("customer_name")
  customerEmail  String? @map("customer_email")
  customerPhone  String? @map("customer_phone")
  billingAddress Json?   @map("billing_address")

  subtotal      Float
  taxTotal      Float @default(0) @map("tax_total")
  discountTotal Float @default(0) @map("discount_total")
  grandTotal    Float @map("grand_total")

  invoiceStatus String @default("Draft") @map("invoice_status")
  paymentStatus String @default("Unpaid") @map("payment_status")
  paidAmount    Float  @default(0) @map("paid_amount")
  outstanding   Float  @default(0)

  notes String?

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items                 WarehouseInvoiceItem[]
  order                 Order?                 @relation(fields: [orderId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  creator               User?                  @relation("WarehouseInvoiceCreator", fields: [createdBy], references: [id])
  updater               User?                  @relation("WarehouseInvoiceUpdater", fields: [updatedBy], references: [id])
  taxLiabilityAccountId String?                @map("tax_liability_account_id")
  taxLiabilityAccount   ChartOfAccount?        @relation("TaxLiabilityAccount", fields: [taxLiabilityAccountId], references: [id])
  payments              PaymentReceived[]
  creditNotes           CreditNote[]
  company               Company?               @relation("WarehouseInvoiceCompany", fields: [companyId], references: [id])

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([invoiceDate])
  @@index([isActive])
  @@index([companyId])
  @@map("warehouse_invoices")
}

// ============================================================
// CHART OF ACCOUNTS MODEL
// ============================================================

model ChartOfAccount {
  id             String  @id @default(uuid())
  code           String
  name           String
  type           String
  parentAccount  String  @default("") @map("parent_account")
  openingBalance Float   @default(0) @map("opening_balance")
  currentBalance Float   @default(0) @map("current_balance")
  balanceType    String  @default("Debit") @map("balance_type")
  description    String  @default("")
  taxCode        String  @default("N/A") @map("tax_code")
  isActive       Boolean @default(true) @map("is_active")
  createdBy      String  @map("created_by")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator               User?                @relation("ChartOfAccountCreator", fields: [createdBy], references: [id])
  company               Company?             @relation("ChartOfAccountCompany", fields: [companyId], references: [id])
  bankAccounts          BankAccount[]
  journalLines          JournalLine[]
  taxLiabilityInvoices  WarehouseInvoice[]   @relation("TaxLiabilityAccount")
  expenses              Expense[]            @relation("ExpenseToAccount")
  budgetLines           BudgetLine[]         @relation("BudgetLineAccount")
  incomes               Income[]             @relation("IncomeToAccount")
  accountsReceivable    AccountsReceivable[] @relation("ARAccount")
  salesRevenue          SalesInvoice[]       @relation("SalesRevenueAccount")
  arInvoices            SalesInvoice[]       @relation("ARAccount")
  inventoryAccounts     PurchaseInvoice[]    @relation("InventoryAccount")
  accountsPayable       AccountsPayable[]    @relation("APAccount")
  purchaseInvoices      PurchaseInvoice[]    @relation("APAccount")
  stockWriteOffExpenses StockWriteOff[]      @relation("WriteOffExpenseAccount")

  @@unique([code, companyId])
  @@index([code])
  @@index([type])
  @@index([isActive])
  @@index([createdBy])
  @@index([companyId])
  @@map("chart_of_accounts")
}

// ============================================================
// ACCOUNTS RECEIVABLE MODEL
// ============================================================

model AccountsReceivable {
  id            String @id @default(uuid())
  invoiceId     String @unique @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  customerId    String @map("customer_id")
  customerName  String @map("customer_name")

  amount      Float
  paidAmount  Float    @default(0) @map("paid_amount")
  outstanding Float
  dueDate     DateTime @map("due_date")

  currencyId         String?   @map("currency_id")
  baseCurrencyId     String?   @map("base_currency_id")
  exchangeRate       Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate   DateTime? @map("exchange_rate_date")
  foreignAmount      Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount         Decimal?  @map("base_amount") @db.Decimal(18, 4)
  foreignPaidAmount  Decimal   @default(0) @map("foreign_paid_amount") @db.Decimal(18, 4)
  foreignOutstanding Decimal?  @map("foreign_outstanding") @db.Decimal(18, 4)

  status String @default("Current") // Current, Overdue, Paid, WrittenOff

  notes String?

  accountId String? @map("account_id")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice       SalesInvoice           @relation(fields: [invoiceId], references: [id])
  customer      Customer               @relation(fields: [customerId], references: [id])
  account       ChartOfAccount?        @relation("ARAccount", fields: [accountId], references: [id])
  payments      PaymentReceived[]
  salesPayments SalesPaymentReceived[]
  fiscalYear    FiscalYear?            @relation("ARFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([fiscalYearId])
  @@index([companyId])
  @@map("accounts_receivable")
}

// ============================================================
// ACCOUNTS PAYABLE MODEL
// ============================================================

model AccountsPayable {
  id            String @id @default(uuid())
  invoiceId     String @unique @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  supplierId    String @map("supplier_id")
  supplierName  String @map("supplier_name")

  amount      Float
  paidAmount  Float    @default(0) @map("paid_amount")
  outstanding Float
  dueDate     DateTime @map("due_date")

  currencyId         String?   @map("currency_id")
  baseCurrencyId     String?   @map("base_currency_id")
  exchangeRate       Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  exchangeRateDate   DateTime? @map("exchange_rate_date")
  foreignAmount      Decimal?  @map("foreign_amount") @db.Decimal(18, 4)
  baseAmount         Decimal?  @map("base_amount") @db.Decimal(18, 4)
  foreignPaidAmount  Decimal   @default(0) @map("foreign_paid_amount") @db.Decimal(18, 4)
  foreignOutstanding Decimal?  @map("foreign_outstanding") @db.Decimal(18, 4)

  status String @default("Current") // Current, Overdue, Paid, WrittenOff

  notes String?

  accountId String? @map("account_id")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice          PurchaseInvoice       @relation(fields: [invoiceId], references: [id])
  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  account          ChartOfAccount?       @relation("APAccount", fields: [accountId], references: [id])
  currency         Currency?             @relation("APCurrency", fields: [currencyId], references: [id])
  baseCurrency     Currency?             @relation("APBaseCurrency", fields: [baseCurrencyId], references: [id])
  payments         PaymentMade[]
  purchasePayments PurchasePaymentMake[] @relation("PaymentMakeAPRecords")
  PurchaseReturn   PurchaseReturn[]
  fiscalYear       FiscalYear?           @relation("APFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([fiscalYearId])
  @@index([companyId])
  @@index([currencyId])
  @@index([baseCurrencyId])
  @@map("accounts_payable")
}

// ============================================================
// SALES PAYMENT RECEIVED MODELS
// ============================================================

model SalesPaymentReceived {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number")
  paymentDate   DateTime @default(now()) @map("payment_date")
  customerId    String   @map("customer_id")
  customerName  String   @map("customer_name")
  amount        Float
  paymentMethod String   @map("payment_method") // Cash, Bank Transfer, Cheque, Credit Card
  reference     String?  @default("")

  bankAccountId   String? @map("bank_account_id")
  bankAccountName String? @default("") @map("bank_account_name")

  notes  String? @default("")
  status String  @default("Completed") // Pending, Completed, Failed, Cancelled

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer        Customer?             @relation(fields: [customerId], references: [id])
  bankAccount     BankAccount?          @relation(fields: [bankAccountId], references: [id])
  creator         User?                 @relation("SalesPaymentCreator", fields: [createdBy], references: [id])
  updater         User?                 @relation("SalesPaymentUpdater", fields: [updatedBy], references: [id])
  company         Company?              @relation("SalesPaymentCompany", fields: [companyId], references: [id])
  invoicePayments SalesInvoicePayment[]
  journalEntry    JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  journalEntryId  String?               @unique @map("journal_entry_id")
  arRecord        AccountsReceivable?   @relation(fields: [arRecordId], references: [id])
  arRecordId      String?               @map("ar_record_id")
  fiscalYear      FiscalYear?           @relation("SalesPaymentFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([paymentNumber])
  @@index([customerId])
  @@index([paymentDate])
  @@index([status])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("sales_payments_received")
}

// ============================================================
// SALES INVOICE PAYMENT (Junction Table)
// ============================================================

model SalesInvoicePayment {
  id            String @id @default(uuid())
  paymentId     String @map("payment_id")
  invoiceId     String @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  amountPaid    Float  @map("amount_paid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  payment SalesPaymentReceived @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice         @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("sales_invoice_payments")
}

// ============================================================
// PAYMENT RECEIVED MODEL
// ============================================================

model PaymentReceived {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number")
  paymentDate   DateTime @default(now()) @map("payment_date")

  customerId   String @map("customer_id")
  customerName String @map("customer_name")

  invoiceId     String @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  invoiceAmount Float  @map("invoice_amount")

  amount        Float
  paymentMethod String @map("payment_method")
  reference     String @default("")

  bankAccountId   String? @map("bank_account_id")
  bankAccountName String  @default("") @map("bank_account_name")

  notes  String @default("")
  status String @default("Pending")

  clearedDate DateTime? @map("cleared_date")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer    Customer            @relation(fields: [customerId], references: [id])
  creator     User?               @relation("PaymentReceivedCreator", fields: [createdBy], references: [id])
  invoice     WarehouseInvoice?   @relation(fields: [invoiceId], references: [id])
  company     Company?            @relation("PaymentReceivedCompany", fields: [companyId], references: [id])
  arRecord    AccountsReceivable? @relation(fields: [arRecordId], references: [id])
  arRecordId  String?             @map("ar_record_id")
  BankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  fiscalYear  FiscalYear?         @relation("PaymentReceivedFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([paymentNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([status])
  @@index([paymentDate])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("payments_received")
}

// ============================================================
// BANK ACCOUNT MODEL
// ============================================================

model BankAccount {
  id               String   @id @default(uuid())
  accountName      String   @map("account_name")
  accountNumber    String   @map("account_number")
  bankName         String   @map("bank_name")
  branchCode       String   @default("") @map("branch_code")
  accountCode      String   @default("") @map("account_code")
  accountType      String   @default("Current") @map("account_type")
  currency         String   @default("PKR")
  openingBalance   Float    @default(0) @map("opening_balance")
  currentBalance   Float    @default(0) @map("current_balance")
  status           String   @default("Active")
  lastReconciled   DateTime @default(now()) @map("last_reconciled")
  chartOfAccountId String   @map("chart_of_account_id")
  createdBy        String   @map("created_by")
  companyId        String?  @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  chartOfAccount            ChartOfAccount             @relation(fields: [chartOfAccountId], references: [id])
  creator                   User?                      @relation("BankAccountCreator", fields: [createdBy], references: [id])
  company                   Company?                   @relation("BankAccountCompany", fields: [companyId], references: [id])
  incomes                   Income[]
  Expense                   Expense[]
  paymentsMade              PaymentMade[]
  Loan                      Loan[]
  paymentsReceived          PaymentReceived[]
  salesPaymentsReceived     SalesPaymentReceived[]
  purchasePayments          PurchasePaymentMake[]
  transactions              Transaction[]              @relation("BankAccountTransactions")
  fixedAssets               FixedAsset[]
  statementImports          BankStatementImport[]
  statementTransactions     BankStatementTransaction[]
  reconciliations           BankReconciliation[]
  importCustomsDutyPayments ImportCustomsDutyPayment[] @relation("ImportCustomsDutyPaymentBank")
  /// Last CSV/XLSX column mapping remembered for statement imports
  statementColumnMapping    Json?                      @map("statement_column_mapping")

  @@unique([accountNumber, companyId])
  @@index([accountNumber])
  @@index([bankName])
  @@index([status])
  @@index([createdBy])
  @@index([companyId])
  @@map("bank_accounts")
}

// ============================================================
// BANK RECONCILIATION MODELS (statement import + matching)
// ============================================================

model BankStatementImport {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  bankAccountId      String    @map("bank_account_id")
  fileName           String?   @map("file_name")
  fileType           String?   @map("file_type")
  status             String    @default("preview") // preview | imported | cancelled
  statementStartDate DateTime? @map("statement_start_date")
  statementEndDate   DateTime? @map("statement_end_date")
  openingBalance     Float?    @map("opening_balance")
  closingBalance     Float?    @map("closing_balance")
  rowCount           Int       @default(0) @map("row_count")
  duplicateCount     Int       @default(0) @map("duplicate_count")
  columnMapping      Json?     @map("column_mapping")
  importedBy         String    @map("imported_by")
  importedAt         DateTime? @map("imported_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company         Company                    @relation("BankStatementImportCompany", fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount                @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  importer        User                       @relation("BankStatementImportCreator", fields: [importedBy], references: [id])
  transactions    BankStatementTransaction[]
  reconciliations BankReconciliation[]

  @@index([companyId])
  @@index([bankAccountId])
  @@index([status])
  @@index([importedBy])
  @@map("bank_statement_imports")
}

model BankStatementTransaction {
  id                   String    @id @default(uuid())
  companyId            String    @map("company_id")
  bankAccountId        String    @map("bank_account_id")
  importId             String    @map("import_id")
  reconciliationId     String?   @map("reconciliation_id")
  transactionDate      DateTime  @map("transaction_date")
  valueDate            DateTime? @map("value_date")
  description          String    @default("")
  reference            String    @default("")
  debit                Float     @default(0)
  credit               Float     @default(0)
  /// Signed amount: credit (inflow) positive, debit (outflow) negative
  amount               Float     @default(0)
  runningBalance       Float?    @map("running_balance")
  fingerprint          String
  status               String    @default("unmatched") // unmatched | matched | ignored | reviewed
  matchedJournalLineId String?   @map("matched_journal_line_id")
  notes                String?
  importedAt           DateTime  @default(now()) @map("imported_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company            Company                   @relation("BankStatementTransactionCompany", fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount        BankAccount               @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  import             BankStatementImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  reconciliation     BankReconciliation?       @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  matchedJournalLine JournalLine?              @relation("MatchedJournalLine", fields: [matchedJournalLineId], references: [id], onDelete: SetNull)
  matches            BankReconciliationMatch[]

  @@unique([companyId, bankAccountId, fingerprint])
  @@index([companyId])
  @@index([bankAccountId])
  @@index([importId])
  @@index([reconciliationId])
  @@index([status])
  @@index([transactionDate])
  @@index([matchedJournalLineId])
  @@map("bank_statement_transactions")
}

model BankReconciliation {
  id                      String    @id @default(uuid())
  companyId               String    @map("company_id")
  bankAccountId           String    @map("bank_account_id")
  importId                String?   @map("import_id")
  statementStartDate      DateTime  @map("statement_start_date")
  statementEndDate        DateTime  @map("statement_end_date")
  statementOpeningBalance Float     @default(0) @map("statement_opening_balance")
  statementClosingBalance Float     @default(0) @map("statement_closing_balance")
  bookOpeningBalance      Float     @default(0) @map("book_opening_balance")
  bookClosingBalance      Float     @default(0) @map("book_closing_balance")
  difference              Float     @default(0)
  reconciledAmount        Float     @default(0) @map("reconciled_amount")
  unreconciledAmount      Float     @default(0) @map("unreconciled_amount")
  outstandingDeposits     Float     @default(0) @map("outstanding_deposits")
  outstandingPayments     Float     @default(0) @map("outstanding_payments")
  bankChargesTotal        Float     @default(0) @map("bank_charges_total")
  bankInterestTotal       Float     @default(0) @map("bank_interest_total")
  otherAdjustments        Float     @default(0) @map("other_adjustments")
  matchedCount            Int       @default(0) @map("matched_count")
  unmatchedBankCount      Int       @default(0) @map("unmatched_bank_count")
  unmatchedBookCount      Int       @default(0) @map("unmatched_book_count")
  status                  String    @default("Draft") // Draft | InProgress | Reconciled | Completed
  exceptionAllowed        Boolean   @default(false) @map("exception_allowed")
  exceptionNote           String?   @map("exception_note")
  completedBy             String?   @map("completed_by")
  completedAt             DateTime? @map("completed_at")
  reopenedBy              String?   @map("reopened_by")
  reopenedAt              DateTime? @map("reopened_at")
  createdBy               String    @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  company               Company                    @relation("BankReconciliationCompany", fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount           BankAccount                @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  import                BankStatementImport?       @relation(fields: [importId], references: [id], onDelete: SetNull)
  creator               User                       @relation("BankReconciliationCreator", fields: [createdBy], references: [id])
  completer             User?                      @relation("BankReconciliationCompleter", fields: [completedBy], references: [id])
  reopener              User?                      @relation("BankReconciliationReopener", fields: [reopenedBy], references: [id])
  matches               BankReconciliationMatch[]
  statementTransactions BankStatementTransaction[]

  @@index([companyId])
  @@index([bankAccountId])
  @@index([status])
  @@index([statementStartDate, statementEndDate])
  @@index([createdBy])
  @@index([completedBy])
  @@map("bank_reconciliations")
}

model BankReconciliationMatch {
  id                     String    @id @default(uuid())
  companyId              String    @map("company_id")
  reconciliationId       String    @map("reconciliation_id")
  statementTransactionId String    @map("statement_transaction_id")
  journalLineId          String    @map("journal_line_id")
  journalEntryId         String    @map("journal_entry_id")
  matchType              String    @default("manual") @map("match_type") // auto | manual
  matchScore             Float?    @map("match_score")
  matchReason            String?   @map("match_reason")
  isActive               Boolean   @default(true) @map("is_active")
  matchedBy              String?   @map("matched_by")
  matchedAt              DateTime  @default(now()) @map("matched_at")
  unmatchedAt            DateTime? @map("unmatched_at")

  company              Company                  @relation("BankReconciliationMatchCompany", fields: [companyId], references: [id], onDelete: Cascade)
  reconciliation       BankReconciliation       @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  statementTransaction BankStatementTransaction @relation(fields: [statementTransactionId], references: [id], onDelete: Cascade)
  journalLine          JournalLine              @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  matcher              User?                    @relation("BankReconciliationMatchCreator", fields: [matchedBy], references: [id])

  @@index([companyId])
  @@index([reconciliationId])
  @@index([statementTransactionId])
  @@index([journalLineId])
  @@index([isActive])
  @@map("bank_reconciliation_matches")
}

// ============================================================
// JOURNAL ENTRY MODELS
// ============================================================

model JournalLine {
  id           String  @id @default(uuid())
  journalId    String  @map("journal_id")
  accountId    String  @map("account_id")
  accountName  String  @map("account_name")
  accountCode  String  @map("account_code")
  isReconciled Boolean @default(false) @map("is_reconciled")
  debit        Float   @default(0)
  credit       Float   @default(0)
  costCenterId String? @map("cost_center_id")

  // Relations
  journal                      JournalEntry               @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account                      ChartOfAccount             @relation(fields: [accountId], references: [id])
  costCenterRef                CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  reconciliationMatches        BankReconciliationMatch[]
  matchedStatementTransactions BankStatementTransaction[] @relation("MatchedJournalLine")

  @@index([journalId])
  @@index([accountId])
  @@index([costCenterId])
  @@index([isReconciled])
  @@map("journal_lines")
}

model JournalEntry {
  id          String    @id @default(uuid())
  entryNumber String    @unique @map("entry_number")
  date        DateTime  @default(now())
  description String    @default("")
  reference   String    @default("")
  status      String    @default("Draft")
  type        String    @default("Normal")
  createdBy   String    @map("created_by")
  postedBy    String?   @map("posted_by")
  postedAt    DateTime? @map("posted_at")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")
  locationId   String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations - FIXED
  lines                     JournalLine[]
  location                  Location?                  @relation(fields: [locationId], references: [id])
  creator                   User?                      @relation("JournalEntryCreator", fields: [createdBy], references: [id])
  poster                    User?                      @relation("JournalEntryPoster", fields: [postedBy], references: [id])
  company                   Company?                   @relation("JournalEntryCompany", fields: [companyId], references: [id])
  fiscalYear                FiscalYear?                @relation("JournalEntryFiscalYear", fields: [fiscalYearId], references: [id])
  salesPayment              SalesPaymentReceived?
  salesInvoice              SalesInvoice?
  stockWriteOff             StockWriteOff?             @relation("WriteOffJournalEntry")
  PurchaseInvoice           PurchaseInvoice?
  purchasePayment           PurchasePaymentMake?       @relation("PaymentJournalEntry")
  purchasePaymentId         String?                    @unique @map("purchase_payment_id")
  purchaseReturn            PurchaseReturn?            @relation("PurchaseReturnJournalEntry")
  purchaseReturnId          String?                    @unique @map("purchase_return_id")
  transaction               Transaction?               @relation("TransactionJournalEntry")
  transactionId             String?                    @unique @map("transaction_id")
  posSale                   POSSale?                   @relation("POSSaleJournalEntry")
  posReturn                 POSReturn?                 @relation("POSReturnJournalEntry")
  equityTransaction         EquityTransaction?         @relation("EquityTransactionJournal")
  importLandedCosts         ImportLandedCost[]
  importCustomsDutyPayments ImportCustomsDutyPayment[] @relation("ImportCustomsDutyPaymentJournal")

  @@index([entryNumber])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([locationId])
  @@map("journal_entries")
}

model BillItem {
  id          String @id @default(uuid())
  billId      String @map("bill_id")
  description String
  quantity    Int
  unitPrice   Float  @map("unit_price")
  amount      Float
  taxRate     Float  @default(0) @map("tax_rate")
  taxAmount   Float  @default(0) @map("tax_amount")

  bill Bill @relation("BillItems", fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_items")
}

model Bill {
  id         String   @id @default(uuid())
  // Unique per company only (not globally) — multi-tenant safe
  billNumber String   @map("bill_number")
  vendorId   String   @map("vendor_id")
  vendorName String   @map("vendor_name")
  date       DateTime @default(now())
  dueDate    DateTime @map("due_date")

  items Json @default("[]")

  subtotal    Float @default(0)
  taxTotal    Float @default(0) @map("tax_total")
  discount    Float @default(0)
  totalAmount Float @default(0) @map("total_amount")
  paidAmount  Float @default(0) @map("paid_amount")
  outstanding Float @default(0)

  status    String    @default("Unpaid")
  notes     String    @default("")
  createdBy String    @map("created_by")
  posted    Boolean   @default(false)
  postedAt  DateTime? @map("posted_at")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  vendor       Supplier      @relation(fields: [vendorId], references: [id])
  creator      User?         @relation("BillCreator", fields: [createdBy], references: [id])
  company      Company?      @relation("BillCompany", fields: [companyId], references: [id])
  paymentsMade PaymentMade[]
  billItems    BillItem[]    @relation("BillItems")

  @@unique([billNumber, companyId])
  @@index([billNumber])
  @@index([vendorId])
  @@index([status])
  @@index([date])
  @@index([createdBy])
  @@index([companyId])
  @@map("bills")
}

// ============================================================
// INCOME MODEL
// ============================================================

model Income {
  id           String   @id @default(uuid())
  incomeNumber String   @unique @map("income_number")
  date         DateTime @default(now())
  incomeType   String   @map("income_type")
  customerId   String?  @map("customer_id")
  customerName String   @default("") @map("customer_name")

  items Json? @default("[]")

  amount      Float   @default(0)
  hasItems    Boolean @default(false) @map("has_items")
  subtotal    Float   @default(0)
  taxRate     Float   @default(0) @map("tax_rate")
  taxAmount   Float   @default(0) @map("tax_amount")
  totalAmount Float   @default(0) @map("total_amount")

  description String @default("")
  reference   String @default("")

  paymentMethod   String  @default("Cash") @map("payment_method")
  bankAccountId   String? @map("bank_account_id")
  incomeAccountId String? @map("income_account_id")

  status   String    @default("Draft")
  postedBy String?   @map("posted_by")
  postedAt DateTime? @map("posted_at")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")
  locationId   String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer      Customer?       @relation(fields: [customerId], references: [id])
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id])
  incomeAccount ChartOfAccount? @relation("IncomeToAccount", fields: [incomeAccountId], references: [id])
  creator       User?           @relation("IncomeCreator", fields: [createdBy], references: [id])
  poster        User?           @relation("IncomePoster", fields: [postedBy], references: [id])
  company       Company?        @relation("IncomeCompany", fields: [companyId], references: [id])
  fiscalYear    FiscalYear?     @relation("IncomeFiscalYear", fields: [fiscalYearId], references: [id])
  location      Location?       @relation(fields: [locationId], references: [id])

  @@index([incomeNumber])
  @@index([incomeType])
  @@index([customerId])
  @@index([incomeAccountId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([paymentMethod])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([locationId])
  @@map("incomes")
}

// ============================================================
// EXPENSE MODEL
// ============================================================

model Expense {
  id            String   @id @default(uuid())
  expenseNumber String   @unique @map("expense_number")
  date          DateTime @default(now())
  expenseType   String   @map("expense_type")
  vendorId      String?  @map("vendor_id")
  vendorName    String   @default("") @map("vendor_name")

  items Json? @default("[]")

  amount      Float   @default(0)
  hasItems    Boolean @default(false) @map("has_items")
  subtotal    Float   @default(0)
  taxRate     Float   @default(0) @map("tax_rate")
  taxAmount   Float   @default(0) @map("tax_amount")
  totalAmount Float   @default(0) @map("total_amount")

  description String @default("")
  reference   String @default("")

  paymentMethod    String  @default("Cash") @map("payment_method")
  bankAccountId    String? @map("bank_account_id")
  expenseAccountId String? @map("expense_account_id")

  receipt String?

  departmentId String? @map("department_id")
  costCenterId String? @map("cost_center_id")

  status   String    @default("Draft")
  postedBy String?   @map("posted_by")
  postedAt DateTime? @map("posted_at")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")
  locationId   String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  vendor         Supplier?           @relation(fields: [vendorId], references: [id])
  bankAccount    BankAccount?        @relation(fields: [bankAccountId], references: [id])
  expenseAccount ChartOfAccount?     @relation("ExpenseToAccount", fields: [expenseAccountId], references: [id])
  creator        User?               @relation("ExpenseCreator", fields: [createdBy], references: [id])
  poster         User?               @relation("ExpensePoster", fields: [postedBy], references: [id])
  company        Company?            @relation("ExpenseCompany", fields: [companyId], references: [id])
  fiscalYear     FiscalYear?         @relation("ExpenseFiscalYear", fields: [fiscalYearId], references: [id])
  location       Location?           @relation(fields: [locationId], references: [id])
  department     HrDepartment?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter     CostCenter?         @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  attachments    ExpenseAttachment[]

  @@index([expenseNumber])
  @@index([expenseType])
  @@index([vendorId])
  @@index([expenseAccountId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([paymentMethod])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([locationId])
  @@index([departmentId])
  @@index([costCenterId])
  @@map("expenses")
}

model ExpenseAttachment {
  id                 String   @id @default(uuid())
  expenseId          String   @map("expense_id")
  companyId          String   @map("company_id")
  fileUrl            String   @map("file_url")
  fileName           String   @default("") @map("file_name")
  fileSize           Int      @default(0) @map("file_size")
  mimeType           String   @default("") @map("mime_type")
  cloudinaryPublicId String   @default("") @map("cloudinary_public_id")
  createdAt          DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([companyId])
  @@map("expense_attachments")
}

// ============================================================
// BUDGETING — analytical only (does NOT post to GL)
// ============================================================

model Budget {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  fiscalYearId String    @map("fiscal_year_id")
  name         String
  departmentId String?   @map("department_id")
  costCenterId String?   @map("cost_center_id")
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  notes        String    @default("")
  status       String    @default("Draft") // Draft | Approved | Closed
  createdBy    String    @map("created_by")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  department HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  creator    User          @relation("BudgetCreator", fields: [createdBy], references: [id])
  approver   User?         @relation("BudgetApprover", fields: [approvedBy], references: [id])
  lines      BudgetLine[]

  @@unique([companyId, fiscalYearId, name])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([status])
  @@index([departmentId])
  @@index([costCenterId])
  @@map("budgets")
}

model BudgetLine {
  id           String  @id @default(uuid())
  budgetId     String  @map("budget_id")
  accountId    String  @map("account_id")
  departmentId String? @map("department_id")
  costCenterId String? @map("cost_center_id")
  amount       Float   @default(0) // annual / total for this account line
  notes        String  @default("")

  budget      Budget                   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account     ChartOfAccount           @relation("BudgetLineAccount", fields: [accountId], references: [id], onDelete: Restrict)
  department  HrDepartment?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?              @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  allocations BudgetPeriodAllocation[]

  @@index([budgetId])
  @@index([accountId])
  @@index([departmentId])
  @@index([costCenterId])
  @@map("budget_lines")
}

model BudgetPeriodAllocation {
  id           String @id @default(uuid())
  budgetLineId String @map("budget_line_id")
  periodKey    String @map("period_key") // YYYY-MM
  amount       Float  @default(0)

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  @@unique([budgetLineId, periodKey])
  @@index([budgetLineId])
  @@index([periodKey])
  @@map("budget_period_allocations")
}

// ============================================================
// TRIAL BALANCE VIEW
// ============================================================

model TrialBalanceView {
