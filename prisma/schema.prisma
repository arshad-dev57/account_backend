// ============================================================
// TRANSACTION MODEL
// ============================================================

model Transaction {
  id                String   @id @default(uuid())
  transactionNumber String   @unique @map("transaction_number")
  date              DateTime @default(now())
  type              String
  title             String
  description       String   @default("")
  amount            Float
  category          String
  paymentMethod     String   @default("Cash")
  reference         String   @default("")

  customerId    String? @map("customer_id")
  customerName  String  @default("")
  vendorId      String? @map("vendor_id")
  vendorName    String  @default("")
  bankAccountId String? @map("bank_account_id")

  status String @default("Posted")

  createdBy String    @map("created_by")
  postedBy  String?   @map("posted_by")
  postedAt  DateTime? @map("posted_at")

  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer       Customer?     @relation("CustomerTransactions", fields: [customerId], references: [id])
  vendor         Supplier?     @relation("SupplierTransactions", fields: [vendorId], references: [id])
  bankAccount    BankAccount?  @relation("BankAccountTransactions", fields: [bankAccountId], references: [id])
  creator        User?         @relation("TransactionCreator", fields: [createdBy], references: [id])
  poster         User?         @relation("TransactionPoster", fields: [postedBy], references: [id])
  company        Company?      @relation("TransactionCompany", fields: [companyId], references: [id])
  journalEntry   JournalEntry? @relation("TransactionJournalEntry", fields: [journalEntryId], references: [id])
  journalEntryId String?       @unique @map("journal_entry_id")
  fiscalYear     FiscalYear?   @relation("TransactionFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([transactionNumber])
  @@index([type])
  @@index([category])
  @@index([date])
  @@index([status])
  @@index([customerId])
  @@index([vendorId])
  @@index([bankAccountId])
  @@index([createdBy])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("transactions")
}

// ============================================================
// POS MODULE MODELS
// ============================================================

model POSTerminal {
  id         String    @id @default(uuid()) @map("id")
  name       String
  code       String // Counter identifier, e.g. "TERM-01"
  status     String    @default("Active") // Active, Inactive, Disabled
  isActive   Boolean   @default(true) @map("is_active")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deviceInfo Json?     @map("device_info")
  lastSyncAt DateTime? @map("last_sync_at")
  companyId  String    @map("company_id")
  createdBy  String    @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company Company    @relation(fields: [companyId], references: [id])
  creator User       @relation("TerminalCreator", fields: [createdBy], references: [id])
  shifts  POSShift[]
  sales   POSSale[]

  @@unique([code, companyId])
  @@index([companyId])
  @@map("pos_terminals")
}

model POSShift {
  id           String    @id @default(uuid())
  terminalId   String    @map("terminal_id")
  cashierId    String    @map("cashier_id")
  companyId    String    @map("company_id")
  status       String    @default("Open") // Open, Closed, Suspended
  openingCash  Float     @map("opening_cash")
  closingCash  Float?    @map("closing_cash")
  expectedCash Float?    @map("expected_cash")
  actualCash   Float?    @map("actual_cash")
  difference   Float?    @map("difference")
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  suspendedAt  DateTime? @map("suspended_at")
  resumedAt    DateTime? @map("resumed_at")
  notes        String?
  approvedBy   String?   @map("approved_by") // Manager who approved difference/reopening

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  terminal         POSTerminal          @relation(fields: [terminalId], references: [id])
  cashier          User                 @relation("CashierShift", fields: [cashierId], references: [id])
  company          Company              @relation(fields: [companyId], references: [id])
  sales            POSSale[]
  cashTransactions POSCashTransaction[]
  returns          POSReturn[]

  @@index([terminalId])
  @@index([cashierId])
  @@index([companyId])
  @@map("pos_shifts")
}

model POSCashTransaction {
  id         String   @id @default(uuid())
  shiftId    String   @map("shift_id")
  type       String // CASH_IN, CASH_OUT
  amount     Float
  reason     String
  approvedBy String?  @map("approved_by")
  companyId  String   @map("company_id")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  shift POSShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@index([companyId])
  @@map("pos_cash_transactions")
}

model POSSale {
  id               String    @id @map("id") // Client-generated UUID for offline compatibility
  invoiceNumber    String    @map("invoice_number")
  shiftId          String    @map("shift_id")
  terminalId       String    @map("terminal_id")
  customerId       String?   @map("customer_id")
  customerName     String    @map("customer_name")
  customerEmail    String?   @map("customer_email")
  customerPhone    String?   @map("customer_phone")
  subtotal         Float
  discountTotal    Float     @map("discount_total")
  taxTotal         Float     @default(0) @map("tax_total")
  grandTotal       Float     @map("grand_total")
  paidAmount       Float     @map("paid_amount")
  changeAmount     Float     @map("change_amount")
  notes            String?
  status           String    @default("Completed") // Completed, Held, Cancelled, Returned
  fiscalYearId     String?   @map("fiscal_year_id")
  journalEntryId   String?   @unique @map("journal_entry_id")
  invoiceId        String?   @map("invoice_id")
  orderId          String?   @map("order_id")
  deviceInfo       Json?     @map("device_info")
  syncStatus       String    @default("Completed") // Completed, Pending, Failed, Uploading
  syncFailedReason String?   @map("sync_failed_reason")
  isOffline        Boolean   @default(false) @map("is_offline")
  offlineCreatedAt DateTime? @map("offline_created_at")
  companyId        String    @map("company_id")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  shift        POSShift         @relation(fields: [shiftId], references: [id])
  terminal     POSTerminal      @relation(fields: [terminalId], references: [id])
  customer     Customer?        @relation("CustomerPOSSales", fields: [customerId], references: [id])
  fiscalYear   FiscalYear?      @relation("POSSaleFiscalYear", fields: [fiscalYearId], references: [id])
  journalEntry JournalEntry?    @relation("POSSaleJournalEntry", fields: [journalEntryId], references: [id])
  creator      User             @relation("SaleCreator", fields: [createdBy], references: [id])
  company      Company          @relation(fields: [companyId], references: [id])
  items        POSSaleItem[]
  payments     POSSalePayment[]
  returns      POSReturn[]

  @@unique([invoiceNumber, companyId])
  @@index([shiftId])
  @@index([terminalId])
  @@index([companyId])
  @@map("pos_sales")
}

model POSSaleItem {
  id          String  @id @default(uuid())
  posSaleId   String  @map("pos_sale_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  sku         String
  quantity    Float
  unitPrice   Float   @map("unit_price")
  discount    Float   @default(0) // line discount percentage or fixed
  taxRate     Float   @default(0) @map("tax_rate")
  taxAmount   Float   @default(0) @map("tax_amount")
  lineTotal   Float   @map("line_total")
  notes       String?

  // Relations
  posSale POSSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([posSaleId])
  @@index([productId])
  @@map("pos_sale_items")
}

model POSSalePayment {
  id            String   @id @default(uuid())
  posSaleId     String   @map("pos_sale_id")
  paymentMethod String   @map("payment_method") // Cash, Card, Bank, Mobile Wallet, Cheque
  amount        Float
  reference     String?  @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  posSale POSSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([posSaleId])
  @@map("pos_sale_payments")
}

model POSReturn {
  id             String   @id @map("id")
  originalSaleId String   @map("original_sale_id")
  returnNumber   String   @map("return_number")
  shiftId        String   @map("shift_id")
  subtotal       Float
  discountTotal  Float    @map("discount_total")
  taxTotal       Float    @map("tax_total")
  grandTotal     Float    @map("grand_total")
  refundedAmount Float    @map("refunded_amount")
  refundMethod   String   @map("refund_method")
  reason         String
  approvedBy     String   @map("approved_by")
  fiscalYearId   String?  @map("fiscal_year_id")
  journalEntryId String?  @unique @map("journal_entry_id")
  companyId      String   @map("company_id")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  originalSale POSSale         @relation(fields: [originalSaleId], references: [id])
  shift        POSShift        @relation(fields: [shiftId], references: [id])
  journalEntry JournalEntry?   @relation("POSReturnJournalEntry", fields: [journalEntryId], references: [id])
  fiscalYear   FiscalYear?     @relation("POSReturnFiscalYear", fields: [fiscalYearId], references: [id])
  creator      User            @relation("ReturnCreator", fields: [createdBy], references: [id])
  company      Company         @relation(fields: [companyId], references: [id])
  items        POSReturnItem[]

  @@unique([returnNumber, companyId])
  @@index([originalSaleId])
  @@index([shiftId])
  @@index([companyId])
  @@map("pos_returns")
}

model POSReturnItem {
  id          String @id @default(uuid())
  posReturnId String @map("pos_return_id")
  productId   String @map("product_id")
  quantity    Float
  unitPrice   Float  @map("unit_price")
  lineTotal   Float  @map("line_total")

  // Relations
  posReturn POSReturn @relation(fields: [posReturnId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([posReturnId])
  @@index([productId])
  @@map("pos_return_items")
}

model POSAuditLog {
  id        String   @id @default(uuid())
  action    String // Sale, Return, Refund, Void, Discount Approval, Shift Open, Shift Close, Cash Adjustment
  details   String   @default("")
  companyId String   @map("company_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  creator User    @relation("AuditCreator", fields: [createdBy], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdBy])
  @@map("pos_audit_logs")
}

// ============================================================
// INTERNATIONAL TAX MANAGEMENT
// ============================================================

model TaxJurisdiction {
  id          String   @id @default(uuid())
  code        String   @unique // ISO country code or custom code
  name        String
  level       String // Country, State, County, City, SpecialZone
  parentId    String?  @map("parent_id")
  countryCode String   @map("country_code") // ISO 3166-1 alpha-2
  isActive    Boolean  @default(true) @map("is_active")
  companyId   String   @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent          TaxJurisdiction?  @relation("JurisdictionHierarchy", fields: [parentId], references: [id])
  children        TaxJurisdiction[] @relation("JurisdictionHierarchy")
  company         Company           @relation("TaxJurisdictionCompany", fields: [companyId], references: [id])
  taxRates        TaxRate[]
  taxTransactions TaxTransaction[]  @relation("TaxTransactionJurisdiction")

  @@index([parentId])
  @@index([countryCode])
  @@index([companyId])
  @@map("tax_jurisdictions")
}

model TaxType {
  id              String   @id @default(uuid())
  code            String   @unique // VAT, GST, SALES_TAX, EXCISE, etc.
  name            String
  description     String?
  calculationType String   @default("percentage") // percentage, flat, tiered
  isCompound      Boolean  @default(false) @map("is_compound")
  isActive        Boolean  @default(true) @map("is_active")
  companyId       String   @map("company_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  company         Company          @relation("TaxTypeCompany", fields: [companyId], references: [id])
  taxRates        TaxRate[]
  taxTransactions TaxTransaction[] @relation("TaxTransactionType")

  @@index([companyId])
  @@map("tax_types")
}

model TaxRate {
  id             String    @id @default(uuid())
  jurisdictionId String    @map("jurisdiction_id")
  taxTypeId      String    @map("tax_type_id")
  rate           Float
  effectiveFrom  DateTime  @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  isDefault      Boolean   @default(false) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  companyId      String    @map("company_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  jurisdiction    TaxJurisdiction  @relation(fields: [jurisdictionId], references: [id])
  taxType         TaxType          @relation(fields: [taxTypeId], references: [id])
  company         Company          @relation("TaxRateCompany", fields: [companyId], references: [id])
  taxRules        TaxRule[]
  taxTransactions TaxTransaction[] @relation("TaxTransactionTaxRate")

  @@index([jurisdictionId])
  @@index([taxTypeId])
  @@index([companyId])
  @@map("tax_rates")
}

model TaxRule {
  id                String   @id @default(uuid())
  name              String
  taxRateId         String   @map("tax_rate_id")
  productCategoryId String?  @map("product_category_id")
  productId         String?  @map("product_id")
  customerGroupId   String?  @map("customer_group_id")
  pricingModel      String   @default("exclusive") // exclusive, inclusive, mixed
  exemptionAllowed  Boolean  @default(true) @map("exemption_allowed")
  compoundOn        String?  @map("compound_on") // tax rate code to compound on
  priority          Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")
  companyId         String   @map("company_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  taxRate TaxRate @relation(fields: [taxRateId], references: [id])
  company Company @relation("TaxRuleCompany", fields: [companyId], references: [id])

  @@index([taxRateId])
  @@index([productCategoryId])
  @@index([productId])
  @@index([companyId])
  @@map("tax_rules")
}

model TaxExemptionType {
  id                  String   @id @default(uuid())
  code                String   @unique // RESALE, NON_PROFIT, EXPORT, etc.
  name                String
  description         String?
  percentage          Float    @default(100) // 100% = full exemption
  requiresCertificate Boolean  @default(false) @map("requires_certificate")
  isActive            Boolean  @default(true) @map("is_active")
  companyId           String   @map("company_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  company    Company        @relation("TaxExemptionTypeCompany", fields: [companyId], references: [id])
  exemptions TaxExemption[]

  @@index([companyId])
  @@map("tax_exemption_types")
}

model TaxExemption {
  id                   String    @id @default(uuid())
  exemptionTypeId      String    @map("exemption_type_id")
  customerId           String?   @map("customer_id")
  productId            String?   @map("product_id")
  productCategoryId    String?   @map("product_category_id")
  certificateNumber    String?   @map("certificate_number")
  certificateIssuedAt  DateTime? @map("certificate_issued_at")
  certificateExpiresAt DateTime? @map("certificate_expires_at")
  approvedBy           String?   @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  isActive             Boolean   @default(true) @map("is_active")
  companyId            String    @map("company_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  exemptionType TaxExemptionType @relation(fields: [exemptionTypeId], references: [id])
  customer      Customer?        @relation("CustomerTaxExemptions", fields: [customerId], references: [id])
  product       Product?         @relation("ProductTaxExemptions", fields: [productId], references: [id])
  approver      User?            @relation("ExemptionApprover", fields: [approvedBy], references: [id])
  company       Company          @relation("TaxExemptionCompany", fields: [companyId], references: [id])

  @@index([exemptionTypeId])
  @@index([customerId])
  @@index([productId])
  @@index([companyId])
  @@map("tax_exemptions")
}

model TaxTransaction {
  id              String   @id @default(uuid())
  transactionId   String   @map("transaction_id")
  transactionType String   @map("transaction_type") // POSSale, SalesInvoice, Order
  jurisdictionId  String   @map("jurisdiction_id")
  taxTypeId       String   @map("tax_type_id")
  taxRateId       String   @map("tax_rate_id")
  taxableAmount   Float    @map("taxable_amount")
  taxRate         Float    @map("tax_rate")
  taxAmount       Float    @map("tax_amount")
  exemptionAmount Float    @map("exemption_amount")
  isCompound      Boolean  @default(false) @map("is_compound")
  compoundOnId    String?  @map("compound_on_id")
  currency        String   @default("USD")
  exchangeRate    Float?   @map("exchange_rate")
  companyId       String   @map("company_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  jurisdiction    TaxJurisdiction @relation("TaxTransactionJurisdiction", fields: [jurisdictionId], references: [id])
  taxType         TaxType         @relation("TaxTransactionType", fields: [taxTypeId], references: [id])
  taxRateRelation TaxRate         @relation("TaxTransactionTaxRate", fields: [taxRateId], references: [id])
  company         Company         @relation("TaxTransactionCompany", fields: [companyId], references: [id])

  @@index([transactionId])
  @@index([transactionType])
  @@index([jurisdictionId])
  @@index([taxTypeId])
  @@index([companyId])
  @@map("tax_transactions")
}
