  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  items                 WarehouseInvoiceItem[]
  order                 Order?                 @relation(fields: [orderId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  creator               User?                  @relation("WarehouseInvoiceCreator", fields: [createdBy], references: [id])
  updater               User?                  @relation("WarehouseInvoiceUpdater", fields: [updatedBy], references: [id])
  taxLiabilityAccountId String?                @map("tax_liability_account_id")
  taxLiabilityAccount   ChartOfAccount?        @relation("TaxLiabilityAccount", fields: [taxLiabilityAccountId], references: [id])
  payments              PaymentReceived[]
  creditNotes           CreditNote[]
  company               Company?               @relation("WarehouseInvoiceCompany", fields: [companyId], references: [id])

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([invoiceDate])
  @@index([isActive])
  @@index([companyId])
  @@map("warehouse_invoices")
}

// ============================================================
// CHART OF ACCOUNTS MODEL
// ============================================================

model ChartOfAccount {
  id             String  @id @default(uuid())
  code           String
  name           String
  type           String
  parentAccount  String  @default("") @map("parent_account")
  openingBalance Float   @default(0) @map("opening_balance")
  currentBalance Float   @default(0) @map("current_balance")
  balanceType    String  @default("Debit") @map("balance_type")
  description    String  @default("")
  taxCode        String  @default("N/A") @map("tax_code")
  isActive       Boolean @default(true) @map("is_active")
  createdBy      String  @map("created_by")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator              User?                @relation("ChartOfAccountCreator", fields: [createdBy], references: [id])
  company              Company?             @relation("ChartOfAccountCompany", fields: [companyId], references: [id])
  bankAccounts         BankAccount[]
  journalLines         JournalLine[]
  taxLiabilityInvoices WarehouseInvoice[]   @relation("TaxLiabilityAccount")
  expenses             Expense[]            @relation("ExpenseToAccount")
  incomes              Income[]             @relation("IncomeToAccount")
  accountsReceivable   AccountsReceivable[] @relation("ARAccount")
  salesRevenue         SalesInvoice[]       @relation("SalesRevenueAccount")
  arInvoices           SalesInvoice[]       @relation("ARAccount")
  inventoryAccounts    PurchaseInvoice[]    @relation("InventoryAccount")
  accountsPayable      AccountsPayable[]    @relation("APAccount")
  purchaseInvoices     PurchaseInvoice[]    @relation("APAccount")

  @@unique([code, companyId])
  @@index([code])
  @@index([type])
  @@index([isActive])
  @@index([createdBy])
  @@index([companyId])
  @@map("chart_of_accounts")
}

// ============================================================
// ACCOUNTS RECEIVABLE MODEL
// ============================================================

model AccountsReceivable {
  id            String @id @default(uuid())
  invoiceId     String @unique @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  customerId    String @map("customer_id")
  customerName  String @map("customer_name")

  amount      Float
  paidAmount  Float    @default(0) @map("paid_amount")
  outstanding Float
  dueDate     DateTime @map("due_date")

  status String @default("Current") // Current, Overdue, Paid, WrittenOff

  notes String?

  accountId String? @map("account_id")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice       SalesInvoice           @relation(fields: [invoiceId], references: [id])
  customer      Customer               @relation(fields: [customerId], references: [id])
  account       ChartOfAccount?        @relation("ARAccount", fields: [accountId], references: [id])
  payments      PaymentReceived[]
  salesPayments SalesPaymentReceived[]
  fiscalYear    FiscalYear?            @relation("ARFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([fiscalYearId])
  @@index([companyId])
  @@map("accounts_receivable")
}

// ============================================================
// ACCOUNTS PAYABLE MODEL
// ============================================================

model AccountsPayable {
  id            String @id @default(uuid())
  invoiceId     String @unique @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  supplierId    String @map("supplier_id")
  supplierName  String @map("supplier_name")

  amount      Float
  paidAmount  Float    @default(0) @map("paid_amount")
  outstanding Float
  dueDate     DateTime @map("due_date")

  status String @default("Current") // Current, Overdue, Paid, WrittenOff

  notes String?

  accountId String? @map("account_id")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice          PurchaseInvoice       @relation(fields: [invoiceId], references: [id])
  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  account          ChartOfAccount?       @relation("APAccount", fields: [accountId], references: [id])
  payments         PaymentMade[]
  purchasePayments PurchasePaymentMake[] @relation("PaymentMakeAPRecords")
  PurchaseReturn   PurchaseReturn[]
  fiscalYear       FiscalYear?           @relation("APFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([fiscalYearId])
  @@index([companyId])
  @@map("accounts_payable")
}

// ============================================================
// SALES PAYMENT RECEIVED MODELS
// ============================================================

model SalesPaymentReceived {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number")
  paymentDate   DateTime @default(now()) @map("payment_date")
  customerId    String   @map("customer_id")
  customerName  String   @map("customer_name")
  amount        Float
  paymentMethod String   @map("payment_method") // Cash, Bank Transfer, Cheque, Credit Card
  reference     String?  @default("")

  bankAccountId   String? @map("bank_account_id")
  bankAccountName String? @default("") @map("bank_account_name")

  notes  String? @default("")
  status String  @default("Completed") // Pending, Completed, Failed, Cancelled

  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer        Customer?             @relation(fields: [customerId], references: [id])
  bankAccount     BankAccount?          @relation(fields: [bankAccountId], references: [id])
  creator         User?                 @relation("SalesPaymentCreator", fields: [createdBy], references: [id])
  updater         User?                 @relation("SalesPaymentUpdater", fields: [updatedBy], references: [id])
  company         Company?              @relation("SalesPaymentCompany", fields: [companyId], references: [id])
  invoicePayments SalesInvoicePayment[]
  journalEntry    JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  journalEntryId  String?               @unique @map("journal_entry_id")
  arRecord        AccountsReceivable?   @relation(fields: [arRecordId], references: [id])
  arRecordId      String?               @map("ar_record_id")
  fiscalYear      FiscalYear?           @relation("SalesPaymentFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([paymentNumber])
  @@index([customerId])
  @@index([paymentDate])
  @@index([status])
  @@index([isActive])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("sales_payments_received")
}

// ============================================================
// SALES INVOICE PAYMENT (Junction Table)
// ============================================================

model SalesInvoicePayment {
  id            String @id @default(uuid())
  paymentId     String @map("payment_id")
  invoiceId     String @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  amountPaid    Float  @map("amount_paid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  payment SalesPaymentReceived @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice         @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("sales_invoice_payments")
}

// ============================================================
// PAYMENT RECEIVED MODEL
// ============================================================

model PaymentReceived {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number")
  paymentDate   DateTime @default(now()) @map("payment_date")

  customerId   String @map("customer_id")
  customerName String @map("customer_name")

  invoiceId     String @map("invoice_id")
  invoiceNumber String @map("invoice_number")
  invoiceAmount Float  @map("invoice_amount")

  amount        Float
  paymentMethod String @map("payment_method")
  reference     String @default("")

  bankAccountId   String? @map("bank_account_id")
  bankAccountName String  @default("") @map("bank_account_name")

  notes  String @default("")
  status String @default("Pending")

  clearedDate DateTime? @map("cleared_date")

  createdBy String @map("created_by")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer    Customer            @relation(fields: [customerId], references: [id])
  creator     User?               @relation("PaymentReceivedCreator", fields: [createdBy], references: [id])
  invoice     WarehouseInvoice?   @relation(fields: [invoiceId], references: [id])
  company     Company?            @relation("PaymentReceivedCompany", fields: [companyId], references: [id])
  arRecord    AccountsReceivable? @relation(fields: [arRecordId], references: [id])
  arRecordId  String?             @map("ar_record_id")
  BankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  fiscalYear  FiscalYear?         @relation("PaymentReceivedFiscalYear", fields: [fiscalYearId], references: [id])

  @@index([paymentNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([status])
  @@index([paymentDate])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("payments_received")
}

// ============================================================
// BANK ACCOUNT MODEL
// ============================================================

model BankAccount {
  id               String   @id @default(uuid())
  accountName      String   @map("account_name")
  accountNumber    String   @map("account_number")
  bankName         String   @map("bank_name")
  branchCode       String   @default("") @map("branch_code")
  accountCode      String   @default("") @map("account_code")
  accountType      String   @default("Current") @map("account_type")
  currency         String   @default("PKR")
  openingBalance   Float    @default(0) @map("opening_balance")
  currentBalance   Float    @default(0) @map("current_balance")
  status           String   @default("Active")
  lastReconciled   DateTime @default(now()) @map("last_reconciled")
  chartOfAccountId String   @map("chart_of_account_id")
  createdBy        String   @map("created_by")
  companyId        String?  @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  chartOfAccount        ChartOfAccount         @relation(fields: [chartOfAccountId], references: [id])
  creator               User?                  @relation("BankAccountCreator", fields: [createdBy], references: [id])
  company               Company?               @relation("BankAccountCompany", fields: [companyId], references: [id])
  incomes               Income[]
  Expense               Expense[]
  paymentsMade          PaymentMade[]
  Loan                  Loan[]
  paymentsReceived      PaymentReceived[]
  salesPaymentsReceived SalesPaymentReceived[]
  purchasePayments      PurchasePaymentMake[]
  transactions          Transaction[]          @relation("BankAccountTransactions")
  fixedAssets           FixedAsset[]

  @@unique([accountNumber, companyId])
  @@index([accountNumber])
  @@index([bankName])
  @@index([status])
  @@index([createdBy])
  @@index([companyId])
  @@map("bank_accounts")
}

// ============================================================
// JOURNAL ENTRY MODELS
// ============================================================

model JournalLine {
  id           String  @id @default(uuid())
  journalId    String  @map("journal_id")
  accountId    String  @map("account_id")
  accountName  String  @map("account_name")
  accountCode  String  @map("account_code")
  isReconciled Boolean @default(false) @map("is_reconciled")
  debit        Float   @default(0)
  credit       Float   @default(0)
  costCenterId String? @map("cost_center_id")

  // Relations
  journal       JournalEntry   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account       ChartOfAccount @relation(fields: [accountId], references: [id])
  costCenterRef CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("journal_lines")
}

model JournalEntry {
  id          String    @id @default(uuid())
  entryNumber String    @unique @map("entry_number")
  date        DateTime  @default(now())
  description String    @default("")
  reference   String    @default("")
  status      String    @default("Draft")
  type        String    @default("Normal")
  createdBy   String    @map("created_by")
  postedBy    String?   @map("posted_by")
  postedAt    DateTime? @map("posted_at")

  fiscalYearId String? @map("fiscal_year_id")
  companyId    String? @map("company_id")
  locationId   String? @map("location_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations - FIXED
  lines             JournalLine[]
  location          Location?             @relation(fields: [locationId], references: [id])
  creator           User?                 @relation("JournalEntryCreator", fields: [createdBy], references: [id])
  poster            User?                 @relation("JournalEntryPoster", fields: [postedBy], references: [id])
  company           Company?              @relation("JournalEntryCompany", fields: [companyId], references: [id])
  fiscalYear        FiscalYear?           @relation("JournalEntryFiscalYear", fields: [fiscalYearId], references: [id])
  salesPayment      SalesPaymentReceived?
  salesInvoice      SalesInvoice?
  PurchaseInvoice   PurchaseInvoice?
  purchasePayment   PurchasePaymentMake?  @relation("PaymentJournalEntry")
  purchasePaymentId String?               @unique @map("purchase_payment_id")
  purchaseReturn    PurchaseReturn?       @relation("PurchaseReturnJournalEntry")
  purchaseReturnId  String?               @unique @map("purchase_return_id")
  transaction       Transaction?          @relation("TransactionJournalEntry")
  transactionId     String?               @unique @map("transaction_id")
  posSale           POSSale?              @relation("POSSaleJournalEntry")
  posReturn         POSReturn?            @relation("POSReturnJournalEntry")

  @@index([entryNumber])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([locationId])
  @@map("journal_entries")
}

model BillItem {
  id          String @id @default(uuid())
  billId      String @map("bill_id")
  description String
  quantity    Int
  unitPrice   Float  @map("unit_price")
  amount      Float
  taxRate     Float  @default(0) @map("tax_rate")
  taxAmount   Float  @default(0) @map("tax_amount")

  bill Bill @relation("BillItems", fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_items")
}

model Bill {
  id         String   @id @default(uuid())
  // Unique per company only (not globally) — multi-tenant safe
  billNumber String   @map("bill_number")
  vendorId   String   @map("vendor_id")
  vendorName String   @map("vendor_name")
  date       DateTime @default(now())
  dueDate    DateTime @map("due_date")

  items Json @default("[]")

  subtotal    Float @default(0)
  taxTotal    Float @default(0) @map("tax_total")
  discount    Float @default(0)
  totalAmount Float @default(0) @map("total_amount")
  paidAmount  Float @default(0) @map("paid_amount")
  outstanding Float @default(0)

  status    String    @default("Unpaid")
  notes     String    @default("")
  createdBy String    @map("created_by")
  posted    Boolean   @default(false)
  postedAt  DateTime? @map("posted_at")

  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  vendor       Supplier      @relation(fields: [vendorId], references: [id])
  creator      User?         @relation("BillCreator", fields: [createdBy], references: [id])
  company      Company?      @relation("BillCompany", fields: [companyId], references: [id])
  paymentsMade PaymentMade[]
  billItems    BillItem[]    @relation("BillItems")

  @@unique([billNumber, companyId])
  @@index([billNumber])
  @@index([vendorId])
  @@index([status])
  @@index([date])
  @@index([createdBy])
  @@index([companyId])
  @@map("bills")
}

// ============================================================
// INCOME MODEL
// ============================================================

model Income {
  id           String   @id @default(uuid())
  incomeNumber String   @unique @map("income_number")
  date         DateTime @default(now())
  incomeType   String   @map("income_type")
  customerId   String?  @map("customer_id")
  customerName String   @default("") @map("customer_name")

