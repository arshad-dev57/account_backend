model ManufacturingDemand {
  id                String   @id @default(uuid())
  demandNumber      String   @unique @map("demand_number")
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  demandType        String   @map("demand_type") // SalesOrder | Forecast | Manual
  sourceType        String   @map("source_type") // SalesOrder | Forecast | Manual
  sourceId          String?  @map("source_id")
  quantity          Float
  requiredDate      DateTime @map("required_date")
  priority          String   @default("Normal") // Low | Normal | High | Urgent
  status            String   @default("Open") // Open | Planned | Completed | Cancelled
