  finishedGoodsWarehouse Location?                          @relation("ManufacturingProductionOrderFinishedGoodsWarehouse", fields: [finishedGoodsWarehouseId], references: [id])
  location               Location?                          @relation("ManufacturingProductionOrderLocation", fields: [locationId], references: [id])
  creator                User?                              @relation("ManufacturingProductionOrderCreator", fields: [createdBy], references: [id])
  updater                User?                              @relation("ManufacturingProductionOrderUpdater", fields: [updatedBy], references: [id])
  company                Company                            @relation("ManufacturingProductionOrderCompany", fields: [companyId], references: [id])
  materialReservations   ManufacturingMaterialReservation[]
  materialIssues         ManufacturingMaterialIssue[]
  materialConsumptions   ManufacturingMaterialConsumption[]
  workOrders             ManufacturingWorkOrder[]
  wip                    ManufacturingWIP[]
  qualityInspections     ManufacturingQualityInspection[]   @relation("ManufacturingQualityInspectionProductionOrder")
  reworks                ManufacturingRework[]              @relation("ManufacturingReworkProductionOrder")
  scraps                 ManufacturingScrap[]               @relation("ManufacturingScrapProductionOrder")
  subcontractOrders      ManufacturingSubcontractOrder[]    @relation("ManufacturingSubcontractOrderProductionOrder")
