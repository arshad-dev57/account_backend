  costBasis          String   @default("CostPrice") @map("cost_basis")
  discountPercentage Decimal  @default(0) @map("discount_percentage") @db.Decimal(8, 4)
  markupPercentage   Decimal  @default(0) @map("markup_percentage") @db.Decimal(8, 4)
