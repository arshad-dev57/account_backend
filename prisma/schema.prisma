  @@unique([name, companyId])
  @@unique([code, companyId])
  @@unique([slug, companyId])
  @@index([parentId])
  @@index([level])
  @@index([slug])
  @@index([code])
  @@index([isActive])
  @@index([companyId])
  @@map("categories")
}

